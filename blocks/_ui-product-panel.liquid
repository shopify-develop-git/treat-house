{%- doc -%}
  A bordered detail card in the product column. One block, two of the file's cards
  (Figma: Standart Product Page → Estimated Shipping, and the collapsible pair).

  It renders [ui-detail-card] and decides only what goes in: the glyph, the heading,
  whether it opens, and whether the inside is prose or a run of lines. The lines are
  [_ui-product-detail-row] blocks, so a shop that wants a fourth shipping line adds
  one rather than waiting for a fourth setting here.

  The copy is the card's own. A card whose words differ from product to product is
  not this block but a `detail_panel` metaobject entry drawn by
  [_ui-product-panels] — that is where "Cocoa, cream, hazelnut, sea salt" belongs,
  since it is true of exactly one item in the catalogue.

  The lines, though, can still come from the product: `rows_metafield` names a list
  of `detail_row` entries, and those are drawn in place of the blocks below. One
  list replaces what used to be a metafield per line, and it lets a product state a
  cut-off time the template never anticipated.
{%- enddoc -%}

{%- liquid
  assign product_resource = closest.product

  assign row_entries = ''
  assign rows_key = block.settings.rows_metafield
  if rows_key != blank
    assign rows_field = product_resource.metafields.custom[rows_key]
    if rows_field.type == 'list.metaobject_reference'
      assign row_entries = rows_field.value
    endif
  endif
-%}

{%- capture panel_rows -%}
  {%- if row_entries.size > 0 -%}
    {%- for row in row_entries -%}
      {% render 'ui-detail-line', label: row.label.value, value: row.value.value %}
    {%- endfor -%}
  {%- elsif block.blocks.size > 0 -%}
    {% content_for 'blocks' %}
  {%- endif -%}
{%- endcapture -%}

{% render 'ui-detail-card',
  title: block.settings.title,
  icon: block.settings.icon,
  summary: block.settings.intro,
  body: block.settings.body,
  rows: panel_rows,
  collapsible: block.settings.collapsible,
  padding: block.settings.padding,
  attributes: block.shopify_attributes
%}

{% schema %}
{
  "name": "Detail card",
  "tag": null,
  "blocks": [
    {
      "type": "_ui-product-detail-row"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "title",
      "label": "Card title",
      "default": "Estimated shipping"
    },
    {
      "type": "select",
      "id": "icon",
      "label": "t:settings.icon",
      "options": [
        { "value": "none", "label": "t:options.none" },
        { "value": "shipping-fast", "label": "Shipping" },
        { "value": "info-circle", "label": "Information" },
        { "value": "thermometer", "label": "Thermometer" },
        { "value": "gift", "label": "Gift" },
        { "value": "wheat-slash", "label": "Gluten free" },
        { "value": "cookie", "label": "Cookie" },
        { "value": "hand-holding-heart", "label": "Hand and heart" },
        { "value": "envelope", "label": "Envelope" },
        { "value": "check", "label": "Check" },
        { "value": "sparkle", "label": "Sparkle" },
        { "value": "rating-star", "label": "Star" }
      ],
      "default": "shipping-fast"
    },
    {
      "type": "checkbox",
      "id": "collapsible",
      "label": "Opens and closes",
      "default": false
    },
    {
      "type": "select",
      "id": "padding",
      "label": "t:content.padding",
      "options": [
        { "value": "default", "label": "t:options.default" },
        { "value": "tight", "label": "t:options.tight" }
      ],
      "default": "tight"
    },
    {
      "type": "header",
      "content": "Copy"
    },
    {
      "type": "inline_richtext",
      "id": "intro",
      "label": "Always shown"
    },
    {
      "type": "richtext",
      "id": "body",
      "label": "Shown when opened"
    },
    {
      "type": "text",
      "id": "rows_metafield",
      "label": "Per-product lines",
      "info": "A custom.* list of detail_row metaobject entries. Filled in on a product, it replaces the lines below for that product.",
      "default": "shipping_rows"
    }
  ],
  "presets": [
    {
      "name": "Detail card"
    }
  ]
}
{% endschema %}
