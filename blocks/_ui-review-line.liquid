{%- doc -%}
  The social proof line: a row of reviewers' faces, the stars, and the rating
  beside the number of reviews.

  The faces come one of two ways. Left to itself the row is [_ui-avatar] blocks,
  so a merchant can show three or eight and reorder them, and the section holding
  this needs no `case` statement to read them back. Given a single picture of the
  whole row — the overlapping strip a designer hands over already assembled — it
  uses that instead and the blocks stand down.

  Both are here because they fail differently. Separate faces stay separate: a
  shop swaps one person without re-exporting the row. One picture keeps the
  overlap, the ordering and the white edges exactly as they were drawn, which is
  what you want when the strip came out of the design file rather than out of a
  camera.

  The stars are decorative — the rating is written out next to them, so a screen
  reader is told the number rather than counting glyphs.

  `layout` chooses between the two arrangements the file draws: `stacked` puts the
  stars over the wording, which is what the hero needs beside its faces, and `inline`
  sets them on one line, which is what a section heading needs under it.
{%- enddoc -%}

{%- liquid
  assign star_count = block.settings.rating_stars
  assign padding_start = block.settings.padding_block_start
  assign padding_end = block.settings.padding_block_end
  assign has_text = false
  if block.settings.rating_text != blank or block.settings.reviews_text != blank
    assign has_text = true
  endif
-%}

<div
  class="ui-review-line ui-review-line--{{ block.settings.layout | default: 'stacked' }}"
  style="
    --ui-review-line-gap: {{ block.settings.gap }}px;
    --ui-review-line-text-size: {{ block.settings.text_size_mobile }}px;
    --ui-review-line-text-size-desktop: {{ block.settings.text_size }}px;
    {%- if padding_start > 0 %} --ui-review-line-padding-start: {{ padding_start }}px;{% endif -%}
    {%- if padding_end > 0 %} --ui-review-line-padding-end: {{ padding_end }}px;{% endif -%}
  "
  {{ block.shopify_attributes }}
>
  {%- if block.settings.image != blank -%}
    <span class="ui-review-line__strip">
      {% render 'image', image: block.settings.image, height: 66, class: 'ui-review-line__strip-image' %}
    </span>
  {%- else -%}
    <div class="ui-review-line__avatars">
      {% content_for 'blocks' %}
    </div>
  {%- endif -%}

  {%- if star_count > 0 or has_text -%}
    <div class="ui-review-line__rating">
      {%- if star_count > 0 -%}
        <span class="ui-review-line__stars" aria-hidden="true">
          {%- for i in (1..star_count) -%}
            {{- 'icon-ui-rating-star.svg' | inline_asset_content -}}
          {%- endfor -%}
        </span>
      {%- endif -%}

      {%- if has_text -%}
        <p class="ui-review-line__text">
          {%- if block.settings.rating_text != blank -%}
            <span>{{ block.settings.rating_text }}</span>
          {%- endif -%}
          {%- if block.settings.rating_text != blank and block.settings.reviews_text != blank -%}
            <span class="ui-review-line__divider" aria-hidden="true"></span>
          {%- endif -%}
          {%- if block.settings.reviews_text != blank -%}
            <span>{{ block.settings.reviews_text }}</span>
          {%- endif -%}
        </p>
      {%- endif -%}
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  .ui-review-line {
    /*
     * The one place the face size is written. Both arrangements read it, so a
     * row of blocks and a row that arrived as a single picture stand the same
     * height as each other.
     */
    --ui-avatar-size: 26px;

    display: flex;
    align-items: center;
    gap: var(--ui-review-line-gap, 11px);
    padding-block: var(--ui-review-line-padding-start, 0px) var(--ui-review-line-padding-end, 0px);
  }

  .ui-review-line__avatars {
    display: flex;
    flex: 0 0 auto;
  }

  /*
   * The assembled strip carries its own overlap, so it is sized by height alone
   * and keeps whatever width its proportion asks for. The file's strip is drawn
   * at the desktop row's proportion, which is why it lands on the same width
   * there and comes out a little tighter on a phone: the gap between faces is a
   * fixed step, so the row a merchant sees is not the same shape at both sizes
   * and one picture can only be one of them.
   */
  .ui-review-line__strip {
    display: block;
    flex: 0 0 auto;
    height: var(--ui-avatar-size, 26px);
  }

  .ui-review-line__strip-image {
    display: block;
    width: auto;
    height: 100%;
  }

  /* With no avatar blocks the wrapper is still in the markup — the block region has to
     exist for the editor — and an empty flex item still takes its share of the gap,
     which pushes the stars off centre. Taken out of the layout until something is in
     it. Whitespace does not count as content for `:has(*)`, so it stays hidden until
     a block is actually added. */
  .ui-review-line__avatars:not(:has(*)) {
    display: none;
  }

  .ui-review-line__rating {
    display: flex;
    flex-direction: column;
    gap: var(--ui-review-line-stars-gap, 5px);
  }

  /* One line, stars first — the arrangement a section heading sits above. */
  .ui-review-line--inline .ui-review-line__rating {
    flex-direction: row;
    align-items: center;
    gap: var(--ui-review-line-inline-gap, 8px);
  }

  .ui-review-line__stars {
    display: flex;
    gap: var(--ui-review-line-star-gap, 3px);
    color: var(--ui-color-primary);
  }

  .ui-review-line__stars > svg {
    display: block;
    flex: 0 0 auto;
    width: var(--ui-review-line-star-width, 10px);
    height: auto;
  }

  .ui-review-line__text {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: var(--ui-color-gray);
    font-family: var(--ui-font-body);
    font-size: var(--ui-review-line-text-size, 14px);
    font-weight: var(--ui-font-body-weight);
    line-height: var(--ui-line-height);
    white-space: nowrap;
  }

  @media screen and (min-width: 750px) {
    .ui-review-line__text {
      font-size: var(--ui-review-line-text-size-desktop, var(--ui-review-line-text-size, 14px));
    }
  }

  .ui-review-line__divider {
    width: 1px;
    height: 12px;
    background-color: var(--ui-color-gray);
  }

  @media screen and (min-width: 750px) {
    .ui-review-line {
      --ui-avatar-size: 33px;
      --ui-review-line-stars-gap: 4px;
      --ui-review-line-star-gap: 3.5px;
      --ui-review-line-star-width: 12px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Review line",
  "tag": null,
  "blocks": [
    {
      "type": "_ui-avatar"
    }
  ],
  "settings": [
    {
      "type": "image_picker",
      "id": "image",
      "label": "Faces as one picture",
      "info": "The whole row already assembled, overlaps and all. Left empty, the row is built from the reviewer blocks below instead."
    },
    {
      "type": "range",
      "id": "rating_stars",
      "label": "Filled stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "rating_text",
      "label": "Rating",
      "default": "4.9 rating"
    },
    {
      "type": "text",
      "id": "reviews_text",
      "label": "Review count",
      "default": "12,000+ reviews"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "stacked",
          "label": "Stars above the wording"
        },
        {
          "value": "inline",
          "label": "Stars beside the wording"
        }
      ],
      "default": "stacked"
    },
    {
      "type": "range",
      "id": "text_size",
      "label": "t:settings.size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "text_size_mobile",
      "label": "t:content.mobile_size",
      "min": 10,
      "max": 24,
      "step": 1,
      "unit": "px",
      "default": 14
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "info": "Between the faces and the rating.",
      "min": 0,
      "max": 40,
      "step": 1,
      "unit": "px",
      "default": 11
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Review line",
      "blocks": {
        "one": {
          "type": "_ui-avatar"
        },
        "two": {
          "type": "_ui-avatar"
        },
        "three": {
          "type": "_ui-avatar"
        },
        "four": {
          "type": "_ui-avatar"
        },
        "five": {
          "type": "_ui-avatar"
        }
      },
      "block_order": [
        "one",
        "two",
        "three",
        "four",
        "five"
      ]
    }
  ]
}
{% endschema %}
