{%- doc -%}
  One customer review: a rating, the words, and who said them.

  A block rather than a run of settings on the section, so the merchant can add a
  fifth review, drop the third, or reorder them without a developer — which is the
  whole point of the arrangement in docs/section-settings.md.

  The avatar is drawn from the name's first letter rather than an image. The file
  draws a plain purple disc with a single letter in it, and asking a merchant for a
  headshot to reproduce that would be asking for work the design does not use. An
  `image` is honoured when one is given.

  The quote is a plain `text`, not richtext: it is somebody's words repeated, and the
  bold, links and headings a richtext field offers have no business in them.
{%- enddoc -%}

{%- liquid
  assign stars = block.settings.rating | at_most: 5
  assign initial = block.settings.name | strip | slice: 0
-%}

<div class="ui-testimonial" {{ block.shopify_attributes }}>
  <div class="ui-testimonial__body">
    {%- if stars > 0 -%}
      <span class="ui-testimonial__stars" aria-hidden="true">
        {%- for i in (1..stars) -%}
          {{- 'icon-ui-star-filled.svg' | inline_asset_content -}}
        {%- endfor -%}
      </span>
    {%- endif -%}

    {%- if block.settings.quote != blank -%}
      <blockquote class="ui-testimonial__quote">{{ block.settings.quote }}</blockquote>
    {%- endif -%}
  </div>

  {%- if block.settings.name != blank or block.settings.image != blank -%}
    <div class="ui-testimonial__author">
      <span class="ui-testimonial__avatar">
        {%- if block.settings.image != blank -%}
          {% render 'image', image: block.settings.image, class: 'ui-testimonial__avatar-image' %}
        {%- else -%}
          <span class="ui-testimonial__initial" aria-hidden="true">{{ initial }}</span>
        {%- endif -%}
      </span>

      <span class="ui-testimonial__who">
        {%- if block.settings.name != blank -%}
          <cite class="ui-testimonial__name">{{ block.settings.name }}</cite>
        {%- endif -%}
        {%- if block.settings.role != blank -%}
          <span class="ui-testimonial__role">{{ block.settings.role }}</span>
        {%- endif -%}
      </span>
    </div>
  {%- endif -%}
</div>

{% stylesheet %}
  :root {
    --ui-testimonial-padding: 20px;
    --ui-testimonial-body-gap: 16px;
    --ui-testimonial-author-gap: 32px;

    /* The quote holds 16px at both widths — only the padding and the gaps step. A
       phone gets a narrower column, not smaller type. */
    --ui-testimonial-quote-size: 16px;
    --ui-testimonial-avatar-size: 36px;
  }

  @media screen and (min-width: 750px) {
    :root {
      --ui-testimonial-padding: 24px;
      --ui-testimonial-body-gap: 24px;
      --ui-testimonial-author-gap: 48px;
    }
  }

  .ui-testimonial {
    display: flex;
    flex-direction: column;

    /* The author sits on the bottom edge however short the quote is, so a row of
       cards lines its faces up. */
    justify-content: space-between;
    gap: var(--ui-testimonial-author-gap);
    box-sizing: border-box;
    width: 100%;

    /* No height here on purpose. A flex or grid parent stretches its children by
       default, but only while their cross size is `auto` — writing `height: 100%`
       switches that off and leaves each card as tall as its own quote, so a row of
       them comes out ragged. */
    padding: var(--ui-testimonial-padding);
    border-radius: var(--ui-radius-sm);
    background-color: var(--ui-color-light-blue);
  }

  .ui-testimonial__body {
    display: flex;
    flex-direction: column;
    gap: var(--ui-testimonial-body-gap);
  }

  /* The file sets the stars edge to edge — the glyph carries its own spacing. */
  .ui-testimonial__stars {
    display: flex;
    color: var(--ui-color-primary);
  }

  .ui-testimonial__stars > svg {
    display: block;
    flex: 0 0 auto;
    width: 20px;
    height: 20px;
  }

  .ui-testimonial__quote {
    margin: 0;
    font-family: var(--ui-font-body);
    font-weight: var(--ui-font-body-weight);
    font-size: var(--ui-testimonial-quote-size);
    line-height: 1.3;
    color: var(--ui-color-black);
  }

  .ui-testimonial__author {
    display: flex;
    align-items: center;
    gap: 14px;
  }

  .ui-testimonial__avatar {
    display: flex;
    align-items: center;
    justify-content: center;
    flex: 0 0 auto;
    width: var(--ui-testimonial-avatar-size);
    height: var(--ui-testimonial-avatar-size);
    overflow: hidden;
    border-radius: 50%;
    background-color: var(--ui-color-primary);
  }

  .ui-testimonial__avatar-image {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .ui-testimonial__initial {
    font-family: var(--ui-font-accent);
    font-weight: var(--font-accent--weight-semibold, 600);
    font-size: 14px;
    line-height: 1.1;
    text-transform: uppercase;
    color: var(--ui-color-white);
  }

  .ui-testimonial__who {
    display: flex;
    flex-direction: column;
    gap: 2px;
  }

  .ui-testimonial__name {
    font-family: var(--ui-font-body);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.1;
    font-style: normal;
    color: var(--ui-color-primary);
  }

  .ui-testimonial__role {
    font-family: var(--ui-font-body);
    font-weight: var(--ui-font-body-weight);
    font-size: 12px;
    line-height: 1.1;
    color: var(--ui-color-gray);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonial",
  "tag": null,
  "settings": [
    {
      "type": "richtext",
      "id": "quote",
      "label": "Review",
      "default": "<p>\"Jen and Chris are a joy to work with. In the executive briefing space, where we host high volumes of C-level clients, Treat House creations are always a standout. Clients rave about the quality, creativity, and the personal touch that makes every experience memorable. I truly look forward to many more years of partnership.\"</p>"
    },
    {
      "type": "range",
      "id": "rating",
      "label": "Filled stars",
      "min": 0,
      "max": 5,
      "step": 1,
      "default": 5
    },
    {
      "type": "text",
      "id": "name",
      "label": "Name",
      "default": "Jazmine D"
    },
    {
      "type": "text",
      "id": "role",
      "label": "Company or role",
      "default": "ServiceNow"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "Optional. Without one the avatar shows the first letter of the name."
    }
  ],
  "presets": [
    {
      "name": "Testimonial"
    }
  ]
}
{% endschema %}
