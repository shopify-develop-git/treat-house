

{% render 'cart-products' %}

{%- comment -%}
  The gift message the drawer offers, under the lines on the page as well, so
  the two cart surfaces ask the same questions. It is Shopify's cart note,
  posted through the same `cart-form` (`form="cart-form"` on the textarea) and
  saved live by `cart-note.js`, which the snippet loads. Not rendered into the
  empty state, and never alongside the drawer: `header-actions.liquid` skips
  the drawer on the cart template, so the note's id stays unique.
{%- endcomment -%}
{%- unless cart.empty? or force_empty -%}
  {% render 'ui-cart-drawer', part: 'gift' %}
{%- endunless -%}

{% stylesheet %}
  .cart-page__title + .cart-page__items {
    margin-block-start: var(--margin-lg);
  }

  /* The gift note on the page: no drawer gutter to inset from, and a little
     room above it after the last line's divider. */
  .cart-page__items .ui-gift-note {
    margin-inline: 0;
    margin-block-start: var(--margin-lg);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "t:names.cart_products",
  "tag": null,
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 8,
      "max": 36,
      "step": 4,
      "unit": "px",
      "default": 24
    },
    {
      "type": "select",
      "id": "image_ratio",
      "label": "t:settings.aspect_ratio",
      "options": [
        {
          "value": "adapt",
          "label": "t:options.auto"
        },
        {
          "value": "portrait",
          "label": "t:options.portrait"
        },
        {
          "value": "square",
          "label": "t:options.square"
        }
      ],
      "default": "adapt"
    },
    {
      "type": "checkbox",
      "id": "dividers",
      "label": "t:settings.dividers",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "vendor",
      "label": "t:settings.vendor",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-start",
      "label": "t:settings.left",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-inline-end",
      "label": "t:settings.right",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "t:names.cart_items"
    }
  ]
}
{% endschema %}
