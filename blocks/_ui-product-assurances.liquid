{%- doc -%}
  The four reassurances under the buy row (Figma: Standart Product Page → info).

  The same bargain [_ui-product-chips] strikes: the blocks below are the template's
  defaults, and a product overrides them through a `custom.*` list of single-line
  text values written `icon:Label`. The two rows are separate because they are two
  components in the file and not one wearing a flag — these are a 24px glyph above
  its wording, spread across the column, where a tag is a 14px glyph inside an
  outlined pill.

  The row spreads rather than counting columns: each item keeps the width its
  wording needs and the slack goes between them, which is how the file draws four
  items of four different widths. Each has a floor, so once four of them no longer
  fit the column the row breaks to two rows of two — a phone needs no breakpoint
  here, and a merchant who adds a fifth item does not have to be given one.
{%- enddoc -%}

{%- liquid
  assign key = block.settings.metafield
  assign field = ''
  if key != blank
    assign field = closest.product.metafields.custom[key]
  endif

  assign entries = ''
  if field.type == 'list.single_line_text_field'
    assign entries = field.value
  endif
-%}

<div
  class="ui-product-assurances"
  style="
    --ui-product-assurances-gap: {{ block.settings.gap }}px;
    --ui-product-assurances-min: {{ block.settings.min_width }}px;
  "
  {{ block.shopify_attributes }}
>
  {%- if entries.size > 0 -%}
    {%- for entry in entries -%}
      {%- liquid
        assign parts = entry | split: ':'
        assign entry_icon = ''
        assign entry_label = entry
        if parts.size > 1
          assign entry_icon = parts[0] | strip
          assign entry_label = parts | slice: 1, 20 | join: ':' | strip
        endif
      -%}
      {% render 'ui-icon-label', icon: entry_icon, label: entry_label %}
    {%- endfor -%}
  {%- else -%}
    {% content_for 'blocks' %}
  {%- endif -%}
</div>

{% stylesheet %}
  /*
   * Spread, not a grid of equal columns. The four items are drawn at four
   * different widths — 140, 77, 123 and 131 across the 586px column — and equal
   * columns cut the widest of them to 131 and wrapped "Gift-Ready Packaging" onto
   * a second line. Space-between gives each its own width and puts the slack
   * between them, which is what the file does.
   */
  .ui-product-assurances {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: var(--ui-product-assurances-gap, 20px);
  }

  /* The floor that makes the row wrap instead of squeezing: four of these no
     longer fit a phone's column, so it breaks to two rows of two on its own. */
  .ui-product-assurances > * {
    flex: 0 1 auto;
    min-inline-size: var(--ui-product-assurances-min, 120px);
  }

  .ui-product-assurances:not(:has(*)) {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Reassurance row",
  "tag": null,
  "blocks": [
    {
      "type": "_ui-product-assurance"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "metafield",
      "label": "Per-product metafield",
      "info": "A custom.* list of single-line text values, each one icon:Label. Filled in on a product, it replaces the items below for that product.",
      "default": "product_assurances"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "min_width",
      "label": "Narrowest item",
      "info": "Where the row drops to fewer columns.",
      "min": 80,
      "max": 220,
      "step": 10,
      "unit": "px",
      "default": 120
    }
  ],
  "presets": [
    {
      "name": "Reassurance row",
      "blocks": {
        "packaging": {
          "type": "_ui-product-assurance",
          "settings": { "icon": "gift", "label": "Gift-Ready Packaging" }
        },
        "gluten_free": {
          "type": "_ui-product-assurance",
          "settings": { "icon": "wheat-slash", "label": "Gluten-Free" }
        },
        "handcrafted": {
          "type": "_ui-product-assurance",
          "settings": { "icon": "cookie", "label": "Handcrafted Treats" }
        },
        "share_love": {
          "type": "_ui-product-assurance",
          "settings": { "icon": "hand-holding-heart", "label": "Made to Share Love" }
        }
      },
      "block_order": ["packaging", "gluten_free", "handcrafted", "share_love"]
    }
  ]
}
{% endschema %}
