{%- doc -%}
  One packaging choice in the box builder.

  It does not name a variant. The three pack sizes are three separate products
  whose option values do not match — "Individual packs + ($3.00)" on the twelve,
  "+ ($9.00)" on the thirty-six — so a choice written as a value string would
  bind to one pack and miss the others. It is written as the two answers instead,
  and the section finds the variant that gives them for whichever pack is
  currently chosen.

  The price is not a setting either. A choice that stands for a product takes that
  product's price, multiplied by how many of it the pack needs. A choice with no
  product behind it quotes nothing at all — a row that is still a placeholder has
  no business naming a figure, even one the variants could supply.
{%- enddoc -%}

{%- liquid
  assign packs = section.settings.pack_collection.products

  # One entry per pack: the variant this choice resolves to there, what it costs,
  # and what it adds over the same pack with nothing chosen. The script only ever
  # reads these, so no price is ever worked out in JavaScript.
  assign entries = ''

  # A choice that stands for a product takes that product's price and name. The
  # same product is the same money whichever pack it goes in, so this is worked
  # out once and every pack in the map below carries it.
  assign linked_product = block.settings.product
  assign capacity = block.settings.capacity

  for pack in packs
    assign option_one = pack.options_with_values[0]
    assign option_two = pack.options_with_values[1]

    assign want_one = option_one.values[0]
    if block.settings.gift_box and option_one.values.size > 1
      assign want_one = option_one.values[1]
    endif

    assign want_two = option_two.values[0]
    if block.settings.individual_packs and option_two.values.size > 1
      assign want_two = option_two.values[1]
    endif

    assign chosen = null
    assign base = null
    for variant in pack.variants
      if variant.option1 == option_one.values[0] and variant.option2 == option_two.values[0]
        assign base = variant
      endif
      if variant.option1 == want_one and variant.option2 == want_two
        assign chosen = variant
      endif
    endfor

    if chosen == null
      continue
    endif

    ##
    # How many of this packaging the pack needs. A box that holds twelve is one
    # box for a twelve and two for a twenty-four, so the figure the row shows is
    # the product's price times that — and it is worked out per pack, which is
    # why it lives in the loop rather than above it.
    #
    # Liquid divides integers by truncating, so the ceiling is taken by adding
    # one less than the divisor first.
    assign pack_size = pack.metafields.custom.pack_size.value | default: pack.metafields.custom.pack_size
    if pack_size == blank
      assign pack_size = pack.title | split: ' ' | first | times: 1
    endif

    assign units = 1
    if capacity > 0 and pack_size > capacity
      assign units = pack_size | plus: capacity | minus: 1 | divided_by: capacity
    endif

    if linked_product != blank
      assign line_price = linked_product.price | times: units
      if line_price > 0
        assign note = line_price | money | prepend: '+ '
      else
        assign note = 'content.included' | t
      endif
    else
      ##
      # Nothing is quoted for a choice with no product behind it. The pack's own
      # variants would give a figure — a real one, which the total already
      # reflects — but a row that is still waiting for its product should not be
      # the thing that names a price. "Included" is the one exception, because it
      # is not a price: it says the pack costs the same either way, which is what
      # the two variants being equal means.
      assign extra = chosen.price | minus: base.price
      if extra > 0
        assign note = ''
      else
        assign note = 'content.included' | t
      endif
    endif

    # Money is formatted into its own variable first. A `money` in the middle of
    # an append chain formats everything accumulated so far, not the price — the
    # same trap the Product row documents, and here it silently produced a map
    # that would not parse.
    assign price_text = chosen.price | money

    assign entry = '"' | append: pack.handle | append: '":{"id":' | append: chosen.id
    assign entry = entry | append: ',"available":' | append: chosen.available
    assign entry = entry | append: ',"price":' | append: chosen.price
    assign entry = entry | append: ',"priceText":"' | append: price_text | append: '"'
    assign entry = entry | append: ',"note":"' | append: note | append: '"'
    assign entry = entry | append: ',"units":' | append: units
    # Resolved first, not appended through a filter. `default` at the end of an
    # append chain applies to the whole string, which is never blank — so a
    # product with no available variant would have written `"unitId":}` and left
    # the map unparseable.
    assign unit_id = linked_product.first_available_variant.id
    if unit_id == blank
      assign unit_id = linked_product.variants.first.id
    endif
    if unit_id != blank
      assign entry = entry | append: ',"unitId":' | append: unit_id
    endif
    assign entry = entry | append: '}'

    if entries == ''
      assign entries = entry
    else
      assign entries = entries | append: ',' | append: entry
    endif
  endfor

  assign packaging_map = entries | prepend: '{' | append: '}'

  # The row shows the first pack's figures until the reader picks another.
  #
  # The note wanted is the first one after this pack's marker, which is index 1 of
  # the split — the part before it is the rest of that pack's entry. Reaching for
  # `last` instead lands on the final pack in the map, which is how the gift box
  # opened quoting the thirty-six's price under the twelve.
  assign first_handle = packs.first.handle
  assign first_note = ''
  if first_handle != blank
    assign marker = '"' | append: first_handle | append: '":'
    assign after = packaging_map | split: marker | last
    assign note_parts = after | split: '"note":"'
    if note_parts.size > 1
      assign first_note = note_parts[1] | split: '"' | first
    endif
  endif
-%}

{%- liquid
  # A choice may stand for a product the shop already sells — the gift box is
  # one — and then the row takes its picture, its name and its price from there
  # rather than asking for all three again.
  assign row_product = block.settings.product

  assign row_image = block.settings.image
  if row_image == blank
    assign row_image = row_product.featured_image
  endif

  # The product's own name, when there is one. The typed title is what a choice
  # with no product behind it is called.
  assign row_title = block.settings.title
  if row_product != blank
    assign row_title = row_product.title
  endif
-%}

{%- if packaging_map != '{}' -%}
  {% capture packaging_attributes %}
    data-packaging="{{ block.id }}"
    data-packaging-map="{{ packaging_map | escape }}"
  {% endcapture %}

  {% render 'ui-option-row',
    name: 'customize-packaging',
    value: block.id,
    title: row_title,
    description: block.settings.description,
    price_note: first_note,
    image: row_image,
    attributes: packaging_attributes,
    class: 'customize-box__packaging-row'
  %}
{%- endif -%}

{% schema %}
{
  "name": "Packaging choice",
  "tag": null,
  "settings": [
    {
      "type": "product",
      "id": "product",
      "label": "Product",
      "info": "Its name, its picture and its price become the row. Leave it empty and the fields below are used instead — the row then shows no price, since there is nothing behind it to charge."
    },
    {
      "type": "number",
      "id": "capacity",
      "label": "Treats it holds",
      "info": "How many treats fit in one. A box that holds 12 counts as two for a 24 pack, and the price shown follows. Leave empty for packaging that scales with the box rather than being counted."
    },
    {
      "type": "text",
      "id": "title",
      "label": "t:settings.title",
      "info": "Used only when no product is chosen above."
    },
    {
      "type": "text",
      "id": "description",
      "label": "t:settings.text",
      "default": "Simple, everyday packaging"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "Used only when no product is chosen above."
    },
    {
      "type": "header",
      "content": "Product options"
    },
    {
      "type": "paragraph",
      "content": "Which answers this choice gives to the pack product's own options. The price follows from them."
    },
    {
      "type": "checkbox",
      "id": "gift_box",
      "label": "Gift box",
      "default": false
    },
    {
      "type": "checkbox",
      "id": "individual_packs",
      "label": "Individually wrapped",
      "default": false
    }
  ],
  "presets": [
    {
      "name": "Packaging choice"
    }
  ]
}
{% endschema %}
