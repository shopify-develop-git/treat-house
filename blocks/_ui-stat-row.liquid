{%- doc -%}
  The row of figures under a section's copy, with a rule between each pair.

  Hosts [_ui-stat] blocks, so the count is the merchant's and not a number baked
  into a template.

  The rules are borders on the figures rather than elements of their own. The file
  draws them as zero-width vectors between flex children, which is the same spacing
  as a border plus the row's gap on each side, and a border cannot be left behind
  when a merchant removes the figure next to it.
{%- enddoc -%}

<div
  class="ui-stat-row"
  style="--ui-stat-row-gap: {{ block.settings.gap }}px;"
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .ui-stat-row {
    display: flex;
    align-items: stretch;
    justify-content: center;
    flex-wrap: wrap;
    gap: var(--ui-stat-row-gap, 25px);
  }

  /* Gap on one side, padding on the other, with the rule between them — so the
     spacing either side of a rule matches, and the first figure carries none. */
  .ui-stat-row > :not(:first-child) {
    padding-inline-start: var(--ui-stat-row-gap, 25px);
    border-inline-start: 1px solid var(--ui-color-border-gray);
  }

  @media screen and (min-width: 750px) {
    .ui-stat-row {
      --ui-stat-row-gap: var(--ui-stat-row-gap-desktop, 32px);
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Statistics row",
  "tag": null,
  "blocks": [{ "type": "_ui-stat" }],
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 8,
      "max": 48,
      "step": 1,
      "unit": "px",
      "default": 25
    }
  ],
  "presets": [
    {
      "name": "Statistics row",
      "blocks": {
        "one": { "type": "_ui-stat" },
        "two": { "type": "_ui-stat", "settings": { "value": "40+", "label": "Countries served" } },
        "three": { "type": "_ui-stat", "settings": { "value": "98%", "label": "Client satisfaction" } }
      },
      "block_order": ["one", "two", "three"]
    }
  ]
}
{% endschema %}
