{%- doc -%}
  The variant control (Figma: Standart Product Page → Choose Your Box).

  A merchant wrapper around [ui-product-variant-picker], which is where the kit's
  disclosure meets Horizon's `<variant-picker>`. Nothing about the look is decided
  here; what the merchant gets is the wording above the control.

  `label_prefix` leads the option's own name rather than replacing it, so a product
  whose option is called Box reads "Choose your Box" and one called Size reads
  "Choose your Size" — one setting that keeps working when the catalogue grows a
  second kind of product. Left blank, the option's name stands alone.

  `image` is the gift-box photo for the packaging option's second value (the
  upgrade). The picker prefers the variant's own featured media; this stands in
  when a gift-box variant has none, so one photo covers every pack product.
{%- enddoc -%}

<div class="ui-product-variants" {{ block.shopify_attributes }}>
  {%- assign custom_flavor_option = '' -%}
  {%- liquid
    assign has_custom_count = false
    assign native_flavor_option = ''
    assign standard_flavor_option = ''
    for product_option in closest.product.options_with_values
      assign option_name_lower = product_option.name | downcase
      if option_name_lower contains 'how many custom treats'
        assign has_custom_count = true
      endif
      if option_name_lower contains 'flavor' or option_name_lower contains 'flavour'
        assign native_flavor_option = product_option.name
        for option_value in product_option.values
          if option_value.name == 'Standard Flavor'
            assign standard_flavor_option = product_option.name
          endif
        endfor
      endif
    endfor
    assign use_standard_flavors = false
    if has_custom_count and native_flavor_option == ''
      assign use_standard_flavors = true
    elsif has_custom_count and standard_flavor_option != ''
      assign use_standard_flavors = true
      assign custom_flavor_option = standard_flavor_option
    elsif native_flavor_option == ''
      if closest.product.handle == 'custom-school-deluxe' or closest.product.handle == 'custom-college-deluxe'
        assign use_standard_flavors = true
      endif
    endif
  -%}
  {%- if use_standard_flavors -%}
    {% render 'ui-custom-treat-flavors', product_resource: closest.product, option_name: custom_flavor_option %}
  {%- endif -%}
  {% render 'ui-product-variant-picker',
    product_resource: closest.product,
    label_prefix: block.settings.label_prefix,
    gift_box_image: block.settings.image,
    hide_option_name: custom_flavor_option
  %}
</div>

{% stylesheet %}
  .ui-product-variants {
    /* Nothing to draw of its own. It exists so the theme editor has an element to
       outline when the block is selected, and so the picker fills the column. */
    display: flex;
    flex-direction: column;
    gap: 24px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Variant picker",
  "tag": null,
  "settings": [
    {
      "type": "text",
      "id": "label_prefix",
      "label": "Wording above the control",
      "info": "Leads the option's own name: \"Choose your\" gives \"Choose your Box\". Leave empty to show the option's name on its own.",
      "default": "Choose your"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Gift box image",
      "info": "Shown beside the gift box choice when the variant has no image of its own. Leave empty to use only the variant's media."
    }
  ],
  "presets": [
    {
      "name": "Variant picker"
    }
  ]
}
{% endschema %}
