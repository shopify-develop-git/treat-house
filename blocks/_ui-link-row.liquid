{%- doc -%}
  Two or more calls to action standing side by side.

  A section's content area is a column, so every block in it is a row of its own
  and a pair of buttons next to each other cannot be two siblings. They are
  [_ui-link] blocks nested in this one, which keeps the look in `ui-button` where
  the rest of the theme reads it from.

  Below 750px the row stacks, because that is what the file draws on a phone and
  two of our labels do not fit beside each other at that width. A section that
  needs otherwise sets `--ui-link-row-direction`.

  A section that wants the buttons to share one width sets
  `--ui-link-row-item-width` on the row; the kit otherwise sizes each button by
  its own label.
{%- enddoc -%}

{%- liquid
  assign padding_start = block.settings.padding_block_start
  assign padding_end = block.settings.padding_block_end
-%}

<div
  class="ui-link-row"
  style="
    --ui-link-row-gap: {{ block.settings.gap }}px;
    {%- if padding_start > 0 %} --ui-link-row-padding-start: {{ padding_start }}px;{% endif -%}
    {%- if padding_end > 0 %} --ui-link-row-padding-end: {{ padding_end }}px;{% endif -%}
  "
  {{ block.shopify_attributes }}
>
  {% content_for 'blocks' %}
</div>

{% stylesheet %}
  .ui-link-row {
    display: flex;
    flex-direction: var(--ui-link-row-direction, column);
    flex-wrap: wrap;
    align-items: stretch;
    gap: var(--ui-link-row-gap, 16px);
    padding-block: var(--ui-link-row-padding-start, 0px) var(--ui-link-row-padding-end, 0px);

    /*
     * A link in a row is spaced by the row's gap. Without this it would also
     * inherit whatever top padding the section set for the links standing on
     * their own beneath it.
     */
    --ui-link-padding-start: 0px;
    --ui-link-padding-end: 0px;
  }

  @media screen and (min-width: 750px) {
    .ui-link-row {
      flex-direction: var(--ui-link-row-direction, row);
      align-items: flex-start;
    }
  }

  /*
   * Outranks the kit's own `width: fit-content` on a plain class, so the choice
   * does not come down to which stylesheet the theme concatenates last.
   */
  .ui-link-row .ui-button {
    width: var(--ui-link-row-item-width, fit-content);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Button row",
  "tag": null,
  "blocks": [
    { "type": "_ui-link" }
  ],
  "settings": [
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "info": "Between the buttons.",
      "min": 0,
      "max": 48,
      "step": 2,
      "unit": "px",
      "default": 16
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding_block_start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding_block_end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 2,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Button row",
      "blocks": {
        "primary": { "type": "_ui-link" },
        "secondary": {
          "type": "_ui-link",
          "settings": { "label": "Customize treats", "variant": "secondary" }
        }
      },
      "block_order": ["primary", "secondary"]
    }
  ]
}
{% endschema %}
