        },
        {
          "value": "gift",
          "label": "Gift"
        },
        {
          "value": "cookie",
          "label": "Cookie"
        },
        {
          "value": "hand-holding-heart",
          "label": "Hand and heart"
        },
        {
          "value": "smiling-baby",
          "label": "Baby"
        },
        {
          "value": "wheat-slash",
          "label": "Gluten free"
        },
        {
          "value": "shipping-fast",
          "label": "Shipping"
        },
        {
          "value": "thermometer",
          "label": "Thermometer"
        },
        {
          "value": "info-circle",
          "label": "Information"
        },
        {
          "value": "envelope",
          "label": "Envelope"
        },
        {
