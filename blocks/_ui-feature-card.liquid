          "label": "Check"
        },
        {
          "value": "sparkle",
          "label": "Sparkle"
        },
        {
          "value": "sparkles",
          "label": "Sparkles"
        },
        {
          "value": "cake-birthday",
          "label": "Birthday cake"
        },
