
{%- doc -%}
  Renders a header menu block.

  @param {string} [variant] - What version of the menu to render. Defaults to header menu.
  @param {string} [transparent] - Show a transparent menu
{%- enddoc -%}

{% liquid
  assign block_settings = block.settings
%}

{% case variant %}
  {% when 'mobile' %}
    <div
      class="header__drawer"
      ref="headerDrawerContainer"
      data-hydration-key="header-drawer-mobile"
      {{ block.shopify_attributes }}
    >
      {% render 'header-drawer',
        linklist: block_settings.menu,
        data_header_drawer_type: 'mobile-drawer',
        wishlist_url: section.settings.wishlist_url
      %}
    </div>

  {% when 'navigation_bar' %}
    {% if block_settings.navigation_bar == true %}
      <div
        class="menu-list menu-list--mobile{% if transparent == blank %} color-{{ block_settings.color_scheme_navigation_bar }}{% endif %}"
        style="--menu-horizontal-gap: 15px; --mobile-nav-margin: auto;"
        data-hydration-key="header-menu-mobile-navigation-bar"
      >
        <div class="menu-list__scroll-container">
          <ul
            class="menu-list__list list-unstyled"
            role="list"
          >
            {% for link in block_settings.menu.links %}
              <li>
                <a
                  href="{{ link.url }}"
                  id="MenuItem-{{ link.handle }}"
                  class="menu-list__item"
                  {% if link.current %}
                    aria-current="page"
                  {% endif %}
                >
                  {{- link.title -}}
                </a>
              </li>
            {% endfor %}
          </ul>
        </div>
      </div>
    {% endif %}
  {% else %}
    {% liquid
      assign block_settings = block.settings
      assign menu_content_type = block_settings.menu_style | default: 'text'
      assign image_border_radius = block_settings.image_border_radius
      assign color_scheme_classes = ''
      assign color_scheme_setting_id = 'color_scheme_' | append: section.settings.menu_row
      assign current_color_scheme = block_settings.color_scheme
      assign parent_color_scheme = section.settings[color_scheme_setting_id]

      if parent_color_scheme.id != current_color_scheme.id
        assign color_scheme_classes = ' color-' | append: current_color_scheme
      endif

      # Check if header and menu colors match. This is used to apply different padding styles in css
      if parent_color_scheme.settings.background.rgb == current_color_scheme.settings.background.rgb
        assign color_scheme_classes = color_scheme_classes | append: ' color-scheme-matches-parent'
      endif

      ##
      # A merchant who has not picked a picture still gets one, from the
      # collection the button already points at. It is the same photograph the
      # collection page shows, so the card is right rather than empty on the day
      # the menu is switched on.
      assign promo_image = block_settings.promo_image
      if promo_image == blank and block_settings.promo_button_link contains '/collections/'
        assign promo_handle = block_settings.promo_button_link | split: '/collections/' | last | split: '?' | first
        assign promo_image = collections[promo_handle].featured_image
      endif

      assign has_promo = false
      if promo_image != blank
        assign has_promo = true
      elsif block_settings.promo_heading != blank
        assign has_promo = true
      elsif block_settings.promo_text != blank
        assign has_promo = true
      elsif block_settings.promo_button_label != blank
        assign has_promo = true
      endif

      if block_settings.menu_style == 'featured_collections'
        assign ratio = block_settings.featured_collections_aspect_ratio
      elsif block_settings.menu_style == 'featured_products'
        assign ratio = block_settings.featured_products_aspect_ratio
      endif
    %}

    {% capture children %}
      {% for link in block_settings.menu.links %}
        <li
          role="presentation"
          class="menu-list__list-item"
          on:focus="/activate"
          on:blur="/deactivate"
          on:pointerenter="/activate"
          on:pointerleave="/deactivate"
        >
          <a
            href="{{ link.url }}"
            data-skip-node-update="true"
            class="menu-list__link{% if link.active %} menu-list__link--active{% endif %}"
            {%- if link.links != blank -%}
              aria-controls="submenu-{{ forloop.index }}"
              aria-haspopup="true"
              aria-expanded="false"
            {%- endif -%}
            ref="menuitem"
          >
            <span class="menu-list__link-title">{{- link.title -}}</span>
          </a>
          {%- if link.links != blank -%}
            <div class="menu-list__submenu{{ color_scheme_classes }}" ref="submenu[]">
              <div
                id="submenu-{{ forloop.index }}"
                class="menu-list__submenu-inner"
                style="{% render 'submenu-font-styles', settings: block_settings %}"
              >
                {% assign list_id = 'MegaMenuList-' | append: forloop.index %}
                <div class="mega-menu section section--full-width-margin section--{{ section.settings.section_width }}">
                  {%- comment -%}
                    The file names the open panel down its left edge. It is the same
                    word as the item that opened it, so it is taken from there rather
                    than made a setting — a title that could disagree with the link
                    above it is a title that eventually will.
                  {%- endcomment -%}
                  <p class="mega-menu__title" aria-hidden="true">{{ link.title }}</p>

                  <div
                    class="mega-menu__grid"
                    data-menu-grid-id="{{ list_id }}"
                  >
                    {% render 'mega-menu-list',
                      parent_link: link,
                      id: list_id,
                      section: section,
                      grid_columns_count: 6,
                      grid_columns_count_tablet: 4,
                      grid_columns_count_collection_images: 8,
                      menu_content_type: menu_content_type,
                      content_aspect_ratio: ratio,
                      image_border_radius: image_border_radius
                    %}
                  </div>

                  {%- comment -%}
                    Horizon's four submenu styles all build themselves out of the
                    navigation, so none of them can show the picture, the line of
                    copy and the button the file draws down the right of a panel.

                    The card is settings on this block rather than a block of its
                    own, which is the exception to the rule in CLAUDE.md and not a
                    choice: a static block needs a literal `id`, so it cannot be
                    keyed to the panel it opens from, and `content_for 'blocks'`
                    renders its list once wherever it is written rather than once
                    per panel. Settings render in every panel, which is what the
                    file draws — the same card three times.
                  {%- endcomment -%}
                  {%- if has_promo -%}
                    {% render 'ui-mega-promo',
                      class: 'mega-menu__promo',
                      image: promo_image,
                      heading: block_settings.promo_heading,
                      text: block_settings.promo_text,
                      button_label: block_settings.promo_button_label,
                      button_link: block_settings.promo_button_link
                    %}
                  {%- endif -%}
                </div>
              </div>
            </div>
          {%- endif -%}
        </li>
      {% endfor %}
      <li
        class="menu-list__list-item"
        role="presentation"
        slot="more"
        on:focus="/activate"
        on:blur="/deactivate"
        on:pointerenter="/activate"
        on:pointerleave="/deactivate"
      >
        <button role="menuitem" class="menu-list__link button-unstyled">
          <span class="menu-list__link-title">{{ 'actions.more' | t }}</span>
        </button>
      </li>
    {% endcapture %}

    <script src="{{ 'ui-mega-menu-align.js' | asset_url }}" type="module"></script>

    <header-menu
      ref="headerMenu"
      class="header-menu"
      {{ block.shopify_attributes }}
      data-hydration-key="header-menu"
    >
      <div class="header-menu__inner">
        <ui-mega-menu-align>
        <nav
          class="menu-list"
          style="
            {% render 'menu-font-styles', settings: block_settings %}
            --th-caret: url({{ 'icon-ui-caret-down.svg' | asset_url }});
          "
        >
          {% assign class = 'overflow-menu' | append: color_scheme_classes %}
          {% render 'overflow-list',
            class: class,
            ref: 'overflowMenu',
            children: children,
            minimum-items: 2,
            data-testid: 'header-menu-overflow-list',
            attributes: 'data-skip-node-update'
          %}
        </nav>
        </ui-mega-menu-align>
      </div>

      <script
        src="{{ 'header-menu.js' | asset_url }}"
        type="module"
        fetchpriority="low"
      ></script>
    </header-menu>
{% endcase %}

{% stylesheet %}
  .menu-list--mobile {
    &.menu-list {
      display: grid;
    }

    & .menu-list__list {
      width: max-content;
      margin-inline: auto;
      gap: var(--menu-horizontal-gap);
    }

    & li {
      width: max-content;
      padding-block: var(--padding-sm);
    }

    & li:first-of-type {
      padding-inline-start: var(--menu-horizontal-gap);
    }

    & li:last-of-type {
      padding-inline-end: var(--menu-horizontal-gap);
    }

    & a {
      color: var(--color-foreground);
    }
  }

  .menu-list__scroll-container {
    position: relative;
    overflow-x: auto;
    mask-image: linear-gradient(to right, transparent, #000 20px, #000 calc(100% - 20px), transparent);
    padding-block: var(--padding-2xs);
  }

  /* Drawer menu featured content */
  .menu-drawer__featured-content {
    z-index: var(--layer-base);
    container-type: inline-size;
  }

  .menu-drawer__featured-content--childlist {
    z-index: var(--layer-flat);
  }

  .menu-drawer__featured-content-list {
    display: flex;
    gap: 1em;
    overflow-x: auto;
    padding-block-end: var(--padding-lg);
  }

  .menu-drawer__featured-content-list-item {
    flex: 0 0 auto;
  }

  .menu-drawer__featured-content-list-item--product {
    width: 35cqi;
  }

  .menu-drawer__featured-content-list-item--collection img.resource-card__image {
    width: 80cqi;
  }

  .menu-drawer__featured-content-list-item:first-child {
    margin-inline-start: var(--margin-xl);
  }

  .menu-drawer__featured-content-list-item:last-child {
    margin-inline-end: var(--margin-xl);
  }

  .menu-list {
    --menu-horizontal-gap: var(--gap-xl);
    --menu-vertical-gap: var(--gap-xl);

    display: flex;
    height: 100%;
  }

  .menu-list__list {
    display: flex;
    justify-content: var(--grid-area-alignment);
  }

  .menu-list__list-item {
    flex-shrink: 0;
    white-space: nowrap;
    display: flex;
    align-items: center;
    height: 100%;
  }

  .menu-list__list-item[aria-hidden='true'] {
    visibility: hidden;
  }

  .menu-list__link {
    font-family: var(--menu-top-level-font-family);
    font-style: var(--menu-top-level-font-style);
    font-weight: var(--menu-top-level-font-weight);
    font-size: var(--menu-top-level-font-size);
    line-height: var(--menu-top-level-font-line-height);
    text-transform: var(--menu-top-level-font-case);
    color: var(--menu-top-level-font-color);
    transition: color var(--animation-speed) var(--animation-easing);
    text-decoration: none;
    display: flex;
    flex-direction: column;
    justify-content: center;
    cursor: pointer;
    height: 100%;
    margin-block: 0;

    &:hover,
    &:focus {
      color: var(--menu-top-level-font-color);
    }

    @media screen and (min-width: 750px) {
      font-size: var(--menu-top-level-font-size-desktop);
    }
  }

  .menu-list__link-title {
    padding-inline: calc(var(--gap-xl) / 2);
  }
  [slot='overflow'] .menu-list__link-title {
    padding-inline: 0;
  }

  .menu-list__list-item:not([slot='overflow']) {
    flex-direction: column;
  }
  .menu-list__list-item:not([slot='overflow'])::after {
    content: '';
    width: 100%;
    height: var(--header-padding);
    margin-bottom: calc(-1 * var(--header-padding));
  }

  [slot='overflow'] > .menu-list__link::after {
    content: none;
  }

  /*
        High specificity selectors to subdue non-hovered links without javascript.
        If the need for js-generated `hovered` and `focused` classes arises for another reason we can simplify these.
      */
  .menu-list:where(:has(.menu-list__list-item:hover)),
  .menu-list:where(:has(.menu-list__list-item:focus-within)),
  .menu-list:where(:has(.menu-list__list-item:not([aria-hidden='true']) .menu-list__link--active)) {
    .menu-list__link {
      color: rgb(var(--menu-top-level-font-color-rgb) / var(--opacity-subdued-text));
    }
  }

  /* stylelint-disable-next-line selector-max-specificity */
  .menu-list:not(:has(.menu-list__list-item:hover)) .menu-list__link--active,
  .menu-list .menu-list__list-item:where(:hover, :focus-within) .menu-list__link,
  .menu-list .menu-list__list-item[slot='overflow'] .menu-list__link[aria-expanded='true'] {
    color: var(--menu-top-level-font-color);
  }

  .overflow-menu::part(list) {
    /* Make sure focus outline is not cut off by overflow hidden */
    --focus-outline-size: calc(var(--focus-outline-offset) + var(--focus-outline-width));

    gap: 0;
    margin-inline: calc(-1 * var(--menu-horizontal-gap) / 2);
  }

  .overflow-menu {
    background-color: transparent;
    padding: var(--focus-outline-size);
    margin: calc(-1 * var(--focus-outline-size));
  }

  /* the submenu background element to animate */
  .overflow-menu::after {
    content: '';
    position: absolute;
    top: calc(100% - 1px + var(--border-bottom-width));
    left: 0;
    width: 100%;
    height: var(--submenu-height);
    background-color: var(--color-background);
    box-shadow: var(--shadow-popover);
    clip-path: inset(0.5px 0 -100px 0); /* stylelint-disable-line */
    opacity: var(--submenu-opacity, 1);
    transition: height var(--submenu-animation-speed) var(--ease-out-cubic),
      opacity var(--animation-speed-slow) var(--ease-out-cubic) var(--animation-speed-fast);
    z-index: calc(var(--layer-header-menu) - 1);
  }

  /** mega menu **/
  .menu-list__submenu,
  .overflow-menu::part(overflow) {
    --submenu-padding-block-start: var(--padding-3xl);
    --submenu-padding-block-end: var(--padding-3xl);

    background-color: transparent;
  }

  .header__row[style*='--border-bottom-width: 0px'] {
    .menu-list__submenu.color-scheme-matches-parent,
    .overflow-menu.color-scheme-matches-parent::part(overflow) {
      --submenu-padding-block-start: 0px;
    }
  }

  .menu-list__list-item:where(:not([slot='overflow'])) > .menu-list__submenu,
  .overflow-menu::part(overflow) {
    --submenu-content-opacity: 0;
    --submenu-content-animation: opacity calc(var(--submenu-animation-speed) * 0.75) var(--animation-easing);

    visibility: hidden;
    background-color: var(--color-background);
    position: absolute;
    width: 100%;
    left: 0;
    top: calc(100% - 1px + var(--border-bottom-width));
    z-index: var(--layer-header-menu);
    padding-inline: var(--padding-inline);
    clip-path: rect(0 100% var(--submenu-height) 0); /* stylelint-disable-line */
    transition: clip-path var(--submenu-animation-speed) var(--ease-out-cubic);
  }

  /* Show the submenus on hover */
  .menu-list__list-item:has([aria-expanded='true']) > .menu-list__submenu,
  /* Show the overflow menu when a menu item is hovered */
  .overflow-menu:has([slot="overflow"] [aria-expanded='true'])::part(overflow),
  /* Keep the submenus open when they are hovered */
  .menu-list__submenu:is(:hover),
  .overflow-menu::part(overflow):hover {
    --submenu-content-opacity: 1;

    visibility: visible;
  }

  .menu-list__submenu-inner,
  .overflow-menu::part(overflow-list) {
    grid-column: 2;
    padding-block-start: var(--submenu-padding-block-start);
    padding-block-end: var(--submenu-padding-block-end);
    padding-inline: var(--section-padding-inline);
  }

  .overflow-menu::part(overflow) {
    --menu-top-level-font-size: var(--font-size--xlarge);

    display: grid;
    grid-template-columns: var(--full-page-grid-with-margins);
  }

  .overflow-menu::part(overflow-list) {
    --submenu-content-opacity: 0;

    position: relative;
    display: grid;
    grid-template-columns: minmax(auto, 200px) 1fr;
    grid-template-areas: 'left right';
    grid-template-rows: max-content;
    grid-gap: 0;
  }

  /* Make overflow menu scrollable when content exceeds viewport */
  .menu-list__submenu-inner,
  .overflow-menu::part(overflow-list) {
    max-height: calc(80vh - var(--header-height));
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: thin;
    scrollbar-color: rgb(var(--color-foreground-rgb) / var(--opacity-40)) transparent;
  }

  .menu-list__list-item:is([slot='overflow']) {
    --menu-top-level-font-color: var(--color-foreground);
    --menu-top-level-font-color-rgb: var(--color-foreground-rgb);

    display: contents;
    white-space: normal;

    .menu-list__link {
      --submenu-content-opacity: 0;

      grid-area: left;
      grid-row: auto;
      height: min-content;
      font-size: var(--font-size--xl);
      opacity: var(--submenu-content-opacity);
      transition: var(--submenu-content-animation);
    }

    .menu-list__submenu {
      visibility: hidden;
      grid-row: 1;
      grid-area: right;
      grid-row-end: span calc(var(--overflow-count) + 1);
      padding-inline-start: var(--menu-horizontal-gap);

      .menu-list__submenu-inner {
        padding-block-start: 0;
        grid-column: unset;
      }
    }

    .menu-list__link[aria-expanded='true'] + .menu-list__submenu {
      visibility: visible;
    }
  }

  .header-menu {
    height: 100%;
  }
  .header-menu[data-overflow-expanded='true'] .menu-list__list-item:where([slot='overflow']) .menu-list__link {
    --submenu-content-opacity: 1;
  }

  .menu-list__submenu-inner {
    position: relative;
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    opacity: var(--submenu-content-opacity);
    transition: var(--submenu-content-animation);
  }

  .mega-menu__link {
    font-family: var(--menu-child-font-family);
    font-style: var(--menu-child-font-style);
    font-weight: var(--menu-child-font-weight);
    font-size: var(--menu-child-font-size);
    line-height: var(--menu-child-font-line-height);
    text-transform: var(--menu-child-font-case);
    color: var(--menu-child-font-color);
    white-space: normal;
    text-decoration: none;
    display: inline-flex;
    padding: var(--padding-2xs) 0;
    transition: color var(--animation-speed) var(--animation-easing);

    &:hover {
      color: var(--menu-child-active-font-color);
    }
  }

  .mega-menu__link--parent {
    font-family: var(--menu-parent-font-family);
    font-style: var(--menu-parent-font-style);
    font-weight: var(--menu-parent-font-weight);
    font-size: var(--menu-parent-font-size);
    line-height: var(--menu-parent-font-line-height);
    text-transform: var(--menu-parent-font-case);
    color: var(--menu-parent-font-color);

    &:hover {
      color: var(--menu-parent-active-font-color);
    }
  }

  @media screen and (max-width: 989px) {
    .mega-menu__content-list-item--hidden-tablet {
      display: none;
    }
  }

  .mega-menu__link:has(.mega-menu__link-image) {
    display: flex;
    flex-direction: column;
    padding-inline: 0;
    padding-block: var(--padding-sm) 0;
  }

  .mega-menu__link-image {
    width: 100%;
    position: relative;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--padding-sm);
    object-fit: cover;
    border-radius: var(--menu-image-border-radius);
  }

  /* Fix alignment for collection image mode links without images */

  /* Target only top-level links (direct children of column > div) in collection image mode */
  .mega-menu__grid:has(.mega-menu__link-image)
    .mega-menu__column
    > div
    > .mega-menu__link:not(:has(.mega-menu__link-image)) {
    display: flex;
    flex-direction: column;
    padding-inline: 0;
    padding-block: var(--padding-sm) 0;
  }

  .mega-menu__grid:has(.mega-menu__link-image)
    .mega-menu__column
    > div
    > .mega-menu__link:not(:has(.mega-menu__link-image))::before {
    content: '';
    display: block;
    width: 100%;
    aspect-ratio: 16 / 9;
    margin-bottom: var(--padding-sm);
    background-color: var(--color-foreground-muted);
    opacity: 0.1;
    border-radius: var(--menu-image-border-radius);
  }

  .mega-menu__grid {
    display: grid;
    grid-template-columns: repeat(var(--menu-columns-tablet), minmax(0, 1fr));
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);
    width: 100%;

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-columns-desktop), minmax(0, 1fr));
    }
  }

  .mega-menu__column {
    grid-column: span 1;
  }

  .mega-menu__column--span-2 {
    grid-column: span 2;
  }

  .mega-menu__column--span-3 {
    grid-column: span 3;
  }

  .mega-menu__column--span-4 {
    grid-column: span 4;
  }

  .mega-menu__column--wide-collection-image {
    grid-column: span 1;

    @media screen and (min-width: 990px) {
      grid-column: span 2;
    }
  }

  .mega-menu__submenu .mega-menu__column--wide-collection-image {
    grid-column: span 1;
  }

  .mega-menu__content-list {
    display: grid;
    justify-content: end;
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);
  }

  .mega-menu__content-list--products {
    grid-template-columns: repeat(var(--menu-content-columns-tablet), minmax(0, 1fr));

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-content-columns-desktop), minmax(0, 1fr));
    }
  }

  .mega-menu__content-list--collections {
    grid-template-columns: repeat(var(--menu-content-columns-tablet), minmax(0, 300px));

    @media screen and (min-width: 990px) {
      grid-template-columns: repeat(var(--menu-content-columns-desktop), minmax(0, 300px));
    }
  }

  .mega-menu__list {
    display: grid;
    grid-template-columns: subgrid;
    grid-column: span var(--menu-columns-tablet);
    gap: var(--menu-vertical-gap) var(--menu-horizontal-gap);

    @media screen and (min-width: 990px) {
      grid-column: span var(--menu-columns-desktop);
    }
  }

  .mega-menu__content {
    grid-column: span var(--menu-content-columns-tablet) / -1;

    @media screen and (min-width: 990px) {
      grid-column: span var(--menu-content-columns-desktop) / -1;
    }
  }

  .menu-list__list-item[slot='overflow'] .section {
    grid-template-columns: 1fr;
  }

  .menu-list__list-item[slot='overflow'] .section .mega-menu__grid {
    grid-column: 1;
  }

  .mega-menu__content-list li {
    white-space: normal;
  }

  /* mega more menu */
  .mega-menu__more-list {
    --menu-child-font-size: var(--font-size--xl);

    width: 200px;
  }

  .mega-menu__submenu {
    /* preserves the inherited grid layout when this submenu wrapper is used */
    display: contents;
  }

  /* ------------------------------------------------------------------
     Treat House menu

     The file sets the top level 24px apart and hangs a small caret 6px after any
     label that opens onto something. The caret is the exported vector, painted
     through a mask so it takes the link's colour rather than carrying its own —
     the file draws it the same black as the label, and a mask keeps it that way if
     the palette ever moves.

     It is drawn rather than marked up because the theme builds this list in three
     places — row, drawer and navigation bar — and a pseudo-element reaches all of
     them without touching any.
     ------------------------------------------------------------------ */

  @media screen and (min-width: 750px) {
    /* Set on the list, not on the menu around it. The theme declares this on
       `.menu-list` itself, so a value handed down from an ancestor is overwritten
       before it ever reaches the row. */
    #header-component[data-menu-style='menu'] .menu-list {
      --menu-horizontal-gap: 24px;
    }

    /* The rest of the type is declared inline on that same nav, and no stylesheet
       outbids an inline style. Redeclaring on the link instead does: a custom
       property set on an element beats the one it would otherwise inherit, and the
       link's own `color: var(--menu-top-level-font-color)` picks it up. Going
       through the variable rather than setting `color` outright is what keeps the
       hover state — it fades the same variable, and a flat colour here would
       silently switch that off. */
    #header-component[data-menu-style='menu'] .menu-list__link {
      --menu-top-level-font-line-height: 1.3;

      /* The theme runs the top level in the body colour, which is a grey. The file
         draws it the same black as the headings. */
      --menu-top-level-font-color: var(--color-foreground-heading);
      --menu-top-level-font-color-rgb: var(--color-foreground-heading-rgb);
    }

    /* The theme spaces this list by padding each end of every label by half the gap,
       which also puts half a gap outside the first and the last. Moving the spacing
       to a real gap makes the measurement the one the file gives — and makes the row
       start and end on the text, which is what decides where a space-between row
       actually sits. */
    #header-component[data-menu-style='menu'] .menu-list .overflow-menu::part(list) {
      gap: var(--menu-horizontal-gap);
      margin-inline: 0;
    }

    #header-component[data-menu-style='menu'] .menu-list__link-title {
      padding-inline: 0;
    }

    /* The link is a column here, which is why a caret appended to it lands under the
       label rather than after it. There is only ever one thing in it, so turning the
       row the right way round costs nothing. */
    #header-component[data-menu-style='menu'] .menu-list__link {
      flex-direction: row;
      align-items: center;
      padding-block: 0;
      padding-inline: 0;
    }

    /* The theme answers a hover by draining the colour out of every other label, so
       the row greys around whatever the pointer is on. Nothing happens here instead:
       a label being pointed at neither fades its neighbours nor changes size. The
       only thing a hover does in this row is open a panel, and the item that opens
       one says so with the pill below.

       Killed by raising the opacity the labels fade to, rather than by out-weighing
       the rules that do the fading: there are three of them, each keyed on a
       different :has(), and one flat colour laid over the top would take the hover
       and the active link with it. At full opacity the subdued colour and the normal
       one are the same colour, and every one of those rules keeps working. */
    #header-component[data-menu-style='menu'] .menu-list__link {
      --opacity-subdued-text: 1;
    }

    /* The item whose panel is open becomes a purple pill with a white label and its
       caret turned over. In the theme that state and a hover are the same thing —
       hovering an item with children is what opens the panel — so the two are
       written as one.

       Drawn outside the box rather than made of padding. Padding would widen the
       item by 32 and shove every label to its right along by that much — the row
       moving under the pointer at the moment the panel opens. The pill is the same
       32 wider and 12 taller than its label either way, but as a pseudo-element it
       takes part in no layout at all: nothing shifts, nothing reflows, and the hit
       area of every item is exactly what it was.

       What that costs is the gap. The file moves the neighbours out of the way and
       keeps 24px of air around the pill; holding them still means the pill reaches
       into that gap instead, leaving 8. There is no arrangement that has both — a
       pill 32 wider than its label, 24px of air, and a row that does not move — so
       this trades the air for the stillness. */
    #header-component[data-menu-style='menu'] .menu-list__link {
      /* Somewhere for the pill to sit behind the label rather than behind the row. */
      position: relative;
      z-index: 0;
    }

    /* The labels are 21px of text sitting in the middle of a 67px header, and the
       panel opens 22px below them — so a pointer travelling from a label to the
       panel crosses 22px of nothing, loses the hover, and the panel shuts before it
       arrives. The theme keeps an invisible strip under each item for exactly this,
       but it is not rendering here.

       The file has no gap to cross: its menu items are 67 tall, the full height of
       the header, top to bottom. Made so — the column stretches, the boxes inside it
       fill it, and negative margins take it back over the row's own padding, so the
       item ends where the panel begins. */
    #header-component[data-menu-style='menu'] .header__column--center {
      align-self: stretch;
      margin-block: calc(-1 * var(--th-header-pad-block));
    }

    #header-component[data-menu-style='menu'] :is(
      .header__column--center header-menu,
      .header__column--center .header-menu__inner,
      .header__column--center .menu-list,
      .header__column--center .overflow-menu,
      .header__column--center .menu-list__list-item,
      .header__column--center .menu-list__link
    ) {
      height: 100%;
    }

    /* Every top-level item takes the pill, not only the ones that open a panel.
       An item that goes straight to a page answers a pointer the same way as one
       that drops — otherwise half the row responds and half looks dead, and which
       half is which is not something a reader can see before pointing at it. Only
       the caret below stays behind `:has(.menu-list__submenu)`, because only those
       items have one to turn. */
    #header-component[data-menu-style='menu']
      .menu-list__list-item:where(:hover, :focus-within)
      > .menu-list__link {
      --menu-top-level-font-color: var(--ui-color-white);
      --menu-top-level-font-color-rgb: 255 255 255;
    }

    #header-component[data-menu-style='menu']
      .menu-list__list-item:where(:hover, :focus-within)
      > .menu-list__link::before {
      content: '';
      position: absolute;
      z-index: -1;
      top: 50%;
      left: -16px;
      right: -16px;

      /* Sized to the label rather than to the link, which spans the whole header
         height so that a pointer on its way down to the panel never leaves it. */
      height: calc(1.3em + 12px);
      transform: translateY(-50%);
      border-radius: var(--ui-radius-sm);
      background-color: var(--ui-color-primary);
    }

    #header-component[data-menu-style='menu']
      .menu-list__list-item:has(.menu-list__submenu):where(:hover, :focus-within)
      > .menu-list__link::after {
      transform: rotate(180deg);
    }

    #header-component[data-menu-style='menu'] li:has(.menu-list__submenu) > .menu-list__link::after {
      content: '';
      width: 9px;
      height: 9px;
      margin-inline-start: 6px;
      background-color: currentcolor;
      transition: transform var(--animation-speed) var(--animation-easing);
      mask-image: var(--th-caret);
      mask-repeat: no-repeat;
      mask-position: center;
      mask-size: contain;
    }


  }

  /* ------------------------------------------------------------------
     Treat House mega menu

     The panel is a white card that drops from under the header and rounds off its
     two bottom corners. Three things sit in it, pushed to the edges of the page
     column: the name of the open menu on the left, the link columns in the middle,
     and a collection card on the right.

     The columns are the shop's navigation, not settings — a second-level item is a
     column heading and its own children are the links under it. That means the
     panel is only as deep as the menu built in the admin: a navigation with one
     level under the top item renders one column of links and no heading, which is
     what it should do rather than invent structure that is not there.
     ------------------------------------------------------------------ */

  @media screen and (min-width: 1050px) {
    /*
     * The rounded bottom corners have to go on the element that paints the white
     * — `.menu-list__submenu` — not on the panel inside it, which is transparent
     * and would round nothing. Its inner scroller carries 28px of Horizon's own
     * bottom padding, which the file does not draw: with it the white runs 388px
     * against the 360 in the design, and the corners curve above the edge of the
     * colour rather than on it.
     */
    #header-component[data-menu-style='menu'] .menu-list__submenu {
      border-end-start-radius: 20px;
      border-end-end-radius: 20px;
    }

    #header-component[data-menu-style='menu'] .menu-list__submenu-inner {
      padding-block-end: 0;
      border-end-start-radius: 20px;
      border-end-end-radius: 20px;
    }

    /* The measuring element is not a box: it wraps the nav only so it has the
       items to measure, and must not become a layout step between the header row
       and the menu inside it. */
    ui-mega-menu-align {
      display: contents;
    }

    #header-component[data-menu-style='menu'] .mega-menu {
      position: relative;
      display: flex;
      align-items: flex-start;
      gap: 24px;
      box-sizing: border-box;
      padding: 24px var(--ui-page-margin);
    }

    /*
     * The title is taken out of the flow so it cannot push the columns along.
     * It belongs to the page margin — the same left edge the header's logo sits
     * on — while the columns belong to the navigation item overhead, and those
     * are two different measurements that a row of flex items cannot both obey.
     */
    #header-component[data-menu-style='menu'] .mega-menu__title {
      position: absolute;
      inset-block-start: 24px;
      inset-inline-start: var(--ui-page-margin);
      margin: 0;
      /* Merienda. `--ui-font-accent` is Outfit — the button face — which is not
         this; the display face is the theme's heading family. */
      font-family: var(--font-heading--family);
      font-size: 24px;
      font-weight: 700;
      line-height: 1.1;
      color: var(--ui-color-primary);
    }

    /*
     * `--th-mega-start` is written by `ui-mega-menu-align.js`: the distance from
     * this panel's content box to the left edge of the label that opened it. The
     * file draws every panel that way and the three it draws agree to within
     * 1.5px, so it is the rule rather than a coincidence of one layout.
     *
     * The floor keeps the columns clear of the absolutely-positioned title —
     * 175px of it plus the 24px gap — for a navigation item far enough left that
     * the two would otherwise collide.
     */
    #header-component[data-menu-style='menu'] .mega-menu__grid {
      flex: 0 1 auto;
      min-width: 0;
      margin-inline-start: max(var(--th-mega-start, 199px), 199px);
      padding-block-start: 9px;
    }

    /*
     * The card holds the 255px it was drawn at and takes the panel's height, so
     * the picture inside it absorbs the difference between a panel with one
     * column of links and a panel with two. `margin-inline-start: auto` is what
     * puts it against the page margin when the links do not fill the row —
     * `justify-content` cannot, because the title has to stay at the far left.
     */
    #header-component[data-menu-style='menu'] .mega-menu__promo {
      flex: 0 0 auto;
      align-self: flex-start;
      margin-inline-start: auto;
    }

    /* The columns sit far apart — 120px — and each one is a heading, a stack of
       links and, when the navigation carries one, a last link that reads as a
       button. */
    #header-component[data-menu-style='menu'] .mega-menu__list {
      display: flex;
      gap: 120px;
    }

    #header-component[data-menu-style='menu'] .mega-menu__column {
      display: flex;
      flex-direction: column;
      gap: 24px;
    }

    #header-component[data-menu-style='menu'] .mega-menu__link--parent {
      font-family: var(--font-heading--family);
      font-size: 14px;
      font-weight: 700;
      line-height: 1.1;
      color: var(--ui-color-primary);
    }

    /* Every second heading takes the orange, which is how the file separates one
       column from the next without a rule between them. */
    #header-component[data-menu-style='menu']
      .mega-menu__column:nth-child(even)
      .mega-menu__link--parent {
      color: var(--ui-color-orange);
    }

    #header-component[data-menu-style='menu'] .mega-menu__link:not(.mega-menu__link--parent) {
      font-family: var(--ui-font-body);
      font-size: 14px;
      font-weight: var(--ui-font-body-weight);
      line-height: 1.3;
      color: var(--ui-color-black);
    }

    #header-component[data-menu-style='menu'] .mega-menu__column > ul {
      display: flex;
      flex-direction: column;
      gap: 16px;
      margin: 0;
      padding: 0;
      list-style: none;
    }
  }

  /* ------------------------------------------------------------------
     The drawer.

     No mobile menu is drawn in the file — the only mobile header there is the
     closed one — so this takes its language from the two things that are drawn:
     the mega menu panel, which sets a group heading in Merienda purple with its
     neighbour in orange and the links under it in Nunito, and the mobile header,
     whose margin is 16px.

     Horizon's own three-level behaviour is left alone. It slides a panel in per
     top-level item and stacks the groups inside it, which is the right shape for
     this menu; what it gets wrong is only the type and the margin.
     ------------------------------------------------------------------ */

  /* Line the rows up with the logo above them — 16px, the phone's page margin.

     Written out rather than taken from `--ui-page-margin`, which is the page
     gutter and steps to 40px at 750. The drawer is a panel of its own and stops
     growing at 25rem there, so the gutter would put 40px each side of a 400px
     panel and indent the navigation for no reason: the window it is measured
     against is not the box these rows are in. */
  #header-component .menu-drawer__menu {
    padding-inline: 16px;
  }

  /* The utility area below the navigation is inset 20px by the theme while the
     navigation above it is on 16, which puts the two columns of text 4px out of
     line down the whole drawer. One margin, both of them. */
  #header-component .menu-drawer__utility-links {
    margin-inline: 16px;
    padding-inline: 0;
  }

  /* The file draws navigation in the heading black, never the body grey, and a
     row is the same height whether or not it opens anything — Horizon gives the
     ones that do 64px and the ones that do not 56, which reads as a mistake. */
  #header-component .menu-drawer__menu-item {
    box-sizing: border-box;
    min-height: 48px;
    padding-block: 0;
    font-family: var(--ui-font-body);
    font-size: 16px;
    font-weight: var(--ui-font-body-weight);
    line-height: 1.3;
    color: var(--color-foreground-heading);
  }

  /* A group heading inside a panel — "By Format", "Gifting & More". Same face,
     size and colours as the column headings the mega menu draws, including the
     orange every second one takes: stacked or side by side, that alternation is
     what separates one group from the next without a rule between them. */
  #header-component .menu-drawer__menu-item--parent {
    min-height: 0;
    margin-block-start: 8px;
    font-family: var(--font-heading--family);
    font-size: 14px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--ui-color-primary);
  }

  #header-component
    .menu-drawer__menu--childlist
    > .menu-drawer__list-item:nth-child(even)
    .menu-drawer__menu-item--parent {
    color: var(--ui-color-orange);
  }

  #header-component .menu-drawer__menu-item--child {
    min-height: 40px;
    font-size: 14px;
  }

  /* The caret is what makes a row that opens something 8px taller than one that
     does not: it is a 24px glyph in 16px of vertical padding, which outgrows the
     48px the row is set to. Its touch target is the whole row anyway — the
     `<summary>` around it — so the padding here is decoration, not reach. */
  #header-component .menu-drawer__menu-item > .icon-caret {
    padding-block: 12px;
  }

  /* The panel names itself down its own top edge, the way the mega menu names
     itself down its left one. It is the back control as well, so the caret keeps
     the colour of the word beside it. */
  #header-component .menu-drawer__back-button .menu-drawer__menu-item-text {
    font-family: var(--font-heading--family);
    font-size: 20px;
    font-weight: 700;
    line-height: 1.1;
    color: var(--ui-color-primary);
  }

  #header-component .menu-drawer__back-button .icon-caret {
    color: var(--ui-color-primary);
  }

  /* Close is the burger, still. The theme puts it top left as a bare glyph while
     the control the reader just pressed was a sky-blue tile on the right, so the
     button appears to move across the screen and change into something else in
     the act of opening. Same tile, same corner, and it reads as one control in
     two states.

     Every close in the drawer takes it — the first view's and the one beside a
     panel's back button — because they are the same control and a reader who
     learns the tile once should not have to learn a second thing two taps in. */
  #header-component .menu-drawer__close-button {
    display: grid;
    place-items: center;
    box-sizing: border-box;
    flex: 0 0 auto;
    width: var(--th-burger-size, 44px);
    height: var(--th-burger-size, 44px);
    padding: 0;
    border-radius: 10px;
    background-color: var(--ui-color-sky-blue);
  }

  /* `margin-inline-start: auto` rather than `align-self`, because the two places
     this button appears run their flex in different directions: the drawer is a
     column, where `flex-end` would mean the right, and a panel's button row is a
     row, where the same word means the bottom. An auto margin means the right in
     both. `flex: 0 0 auto` above it is what stops the row — where the back button
     is 303px wide and the space is not — from shrinking the tile to 35. */
  #header-component .menu-drawer > .menu-drawer__close-button {
    margin: 16px 16px 0 auto;
  }

  #header-component .menu-drawer__nav-buttons .menu-drawer__close-button {
    margin-inline: auto 16px;
  }

  /* The glyph is drawn at a viewBox of 14 with its cross across 10 of it, so a
     21px box puts the cross at 15 and the stroke divided back to the 1.5px every
     other icon in the header is drawn with. Left at the box's own scale it comes
     out over three times as heavy as the burger, and fills the tile besides. */
  #header-component .menu-drawer__close-button .header-drawer-icon--close,
  #header-component .menu-drawer__close-button .header-drawer-icon--close > svg {
    --icon-stroke-width: 1px;

    width: 21px;
    height: 21px;
  }

  /* The caret takes the brand purple, which is the one place the first view has
     to say whose menu it is — everything else on it is a word. */
  #header-component .menu-drawer__menu-item > .icon-caret {
    color: var(--ui-color-primary);
  }

{% endstylesheet %}

{% schema %}
{
  "name": "t:names.menu",
  "tag": null,
  "settings": [
    {
      "type": "link_list",
      "id": "menu",
      "label": "t:settings.menu",
      "default": "main-menu"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "primary"
    },
    {
      "type": "header",
      "content": "t:content.typography"
    },
    {
      "type": "select",
      "id": "type_font_primary_size",
      "label": "t:settings.top_level_size",
      "options": [
        {
          "value": "0.625rem",
          "label": "10px"
        },
        {
          "value": "0.75rem",
          "label": "12px"
        },
        {
          "value": "0.875rem",
          "label": "14px"
        },
        {
          "value": "1rem",
          "label": "16px"
        },
        {
          "value": "1.125rem",
          "label": "18px"
        }
      ],
      "default": "1rem"
    },
    {
      "type": "select",
      "id": "menu_font_style",
      "label": "t:settings.submenu_size",
      "options": [
        {
          "value": "regular",
          "label": "t:options.small"
        },
        {
          "value": "inverse",
          "label": "t:options.medium"
        },
        {
          "value": "inverse_large",
          "label": "t:options.large"
        }
      ],
      "default": "inverse"
    },
    {
      "type": "select",
      "id": "type_font_primary_link",
      "label": "t:settings.font",
      "options": [
        {
          "value": "body",
          "label": "t:options.body"
        },
        {
          "value": "subheading",
          "label": "t:options.subheading"
        },
