{%- doc -%}
  The row of claim tags under the description (Figma: Standart Product Page →
  Gluten-Free and Arrives gift-ready).

  What the merchant arranges here are the defaults for the template: the tags every
  product wears unless it says otherwise. A product says otherwise through the
  metafield named in `metafield` — a list of `icon_label` metaobject entries, each
  carrying an `icon` and a `label`.

  Metaobjects rather than text: the same claims repeat across the catalogue, so
  "Gluten-Free" is one entry every product points at rather than a string retyped on
  each. It also ends the `icon:Label` encoding this block used to parse by hand,
  which was a string pretending to be two fields.

  When the metafield is empty or missing the tag blocks below stand, which is what
  keeps the row from disappearing on the products nobody has got to yet.
{%- enddoc -%}

{%- liquid
  assign key = block.settings.metafield
  assign field = ''
  if key != blank
    assign field = closest.product.metafields.custom[key]
  endif

  assign entries = ''
  if field.type == 'list.metaobject_reference'
    assign entries = field.value
  endif
-%}

<div
  class="ui-product-chips"
  style="--ui-product-chips-gap: {{ block.settings.gap }}px;"
  {{ block.shopify_attributes }}
>
  {%- if entries.size > 0 -%}
    {%- for entry in entries -%}
      {%- liquid
        # `.value` rather than the field itself: a metaobject field hands back a
        # metafield drop, and the icon is resolved by string.
        #
        # The picked icon is a readable name off a choice list, so anything the
        # list does not offer goes in `custom_icon` as an asset name — and when
        # it is filled it is the more specific of the two, so it wins.
        assign entry_icon = entry.custom_icon.value | default: entry.icon.value
        assign entry_label = entry.label.value
      -%}
      {%- if entry_label != blank -%}
        {% render 'ui-tag', icon: entry_icon, label: entry_label %}
      {%- endif -%}
    {%- endfor -%}
  {%- else -%}
    {% content_for 'blocks' %}
  {%- endif -%}
</div>

{% stylesheet %}
  .ui-product-chips {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--ui-product-chips-gap, 12px);
  }

  /* The region has to be in the markup for the editor even when the metafield has
     taken over, and an empty flex item would still take its share of the gap. */
  .ui-product-chips:not(:has(*)) {
    display: none;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Tag row",
  "tag": null,
  "blocks": [
    {
      "type": "_ui-product-chip"
    }
  ],
  "settings": [
    {
      "type": "text",
      "id": "metafield",
      "label": "Per-product metafield",
      "info": "A custom.* list of icon_label metaobject entries. Filled in on a product, it replaces the tags below for that product.",
      "default": "product_chips"
    },
    {
      "type": "range",
      "id": "gap",
      "label": "t:settings.gap",
      "min": 0,
      "max": 40,
      "step": 2,
      "unit": "px",
      "default": 12
    }
  ],
  "presets": [
    {
      "name": "Tag row",
      "blocks": {
        "gluten_free": {
          "type": "_ui-product-chip",
          "settings": {
            "icon": "wheat-slash",
            "label": "Gluten-Free"
          }
        },
        "gift_ready": {
          "type": "_ui-product-chip",
          "settings": {
            "icon": "gift",
            "label": "Arrives gift-ready"
          }
        }
      },
      "block_order": ["gluten_free", "gift_ready"]
    }
  ]
}
{% endschema %}
