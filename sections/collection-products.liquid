{% comment %}
  Shared retail collection grid. Shopify supplies native product order; the
  controller filters the complete visible batch by explicit pack titles and
  starting price before progressively revealing cards. Unfinished Search &
  Discovery metafields are not presented as customer filters.
{% endcomment %}

{%- liquid
  assign products_per_page = section.settings.products_per_page

  assign show_filters = section.settings.show_filters
  assign show_sort = section.settings.show_sort
  assign curated_products = section.settings.retail_products
  if curated_products == blank
    case collection.handle
      when 'get-well'
        assign curated_products = settings.get_well_retail_products
      when 'congratulations'
        assign curated_products = settings.congratulations_retail_products
    endcase
  endif
  assign has_curated_products = false
  if curated_products.size > 0
    assign has_curated_products = true
    # Native facets and sort describe collection membership, not the curated list.
    assign show_filters = false
    assign show_sort = false
  endif

  # The facets already applied, rebuilt as a query fragment so a sort link can carry
  # them. `url_to_add`/`url_to_remove` answer a different question — they each move
  # one value — and there is no filter that gives back the current query string.
  capture applied_params
    for group in collection.filters
      if group.param_name contains 'filter.p.m.custom.'
        continue
      endif
      for value in group.active_values
        echo '&'
        echo value.param_name
        echo '='
        echo value.value | url_encode
      endfor
      if group.min_value.value != blank
        echo '&'
        echo group.min_value.param_name
        echo '='
        echo group.min_value.value
      endif
      if group.max_value.value != blank
        echo '&'
        echo group.max_value.param_name
        echo '='
        echo group.max_value.value
      endif
    endfor
  endcapture

  assign active_count = 0
  for group in collection.filters
    if group.param_name contains 'filter.p.m.custom.'
      continue
    endif
    assign active_count = active_count | plus: group.active_values.size
  endfor
-%}

{%- if collection.handle == 'holidays' and settings.seasonal_hub_collections.size > 0 -%}
  {% render 'ui-seasonal-hub', collections: settings.seasonal_hub_collections %}
{%- else -%}
<script src="{{ 'th-collection-products.js' | asset_url }}" defer></script>
{% comment %}
  Keep the document's native collection analytics bounded to 24 products. Larger
  retail lists are enhanced through a layout-free Section Rendering response;
  failed/no-JavaScript requests retain this honest page count and native links.
{% endcomment %}
{% paginate collection.products by 24 %}
  {%- liquid
    assign grid_products = collection.products
    if has_curated_products
      assign grid_products = curated_products
    endif
    assign visible_count = 0
    assign pack_sizes = ''
    assign count_is_partial = false
    assign out_of_range = false
    if has_curated_products == false and paginate.current_page > 1 and paginate.current_page > paginate.pages
      assign out_of_range = true
    endif
    capture first_page_url
      echo collection.url
      echo '?sort_by='
      echo collection.sort_by | default: collection.default_sort_by | url_encode
      echo applied_params
    endcapture
    if paginate.pages > 1 and has_curated_products == false
      assign count_is_partial = true
    endif
  -%}
  {%- liquid
    for product in grid_products
      capture off_channel
        render 'channel-hidden', product: product, collection: collection
      endcapture
      if off_channel != blank
        continue
      endif
      assign visible_count = visible_count | plus: 1
      assign pack_title = product.title | downcase | replace: '-', ' ' | replace: '–', ' ' | replace: '—', ' ' | prepend: ' '
      assign sizes = '6,12,24,36' | split: ','
      for size in sizes
        assign size_pattern = size | prepend: ' ' | append: ' pack'
        if pack_title contains size_pattern
          assign pack_sizes = pack_sizes | append: size | append: ','
          break
        endif
      endfor
    endfor
  -%}
  {%- capture product_cards -%}
    {% render 'collection-product-cards', products: grid_products, collection: collection, section_id: section.id %}
  {%- endcapture -%}
  {%- if has_curated_products -%}
    {% render 'curated-product-analytics', products: grid_products, collection: collection %}
  {%- endif -%}
<div class="section-background color-{{ section.settings.color_scheme }}"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="collection-products-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <th-collection-products
    class="collection-products"
    data-page-size="{{ products_per_page }}"
    data-collection-handle="{{ collection.handle | escape }}"
    data-native-page="{{ paginate.current_page }}"
    data-native-partial="{{ count_is_partial }}"
    {%- if count_is_partial and has_curated_products == false and request.design_mode == false %}
      data-hydrate-section="collection-products-data"
    {%- endif %}
    {% if out_of_range %}data-first-page-url="{{ first_page_url | escape }}"{% endif %}
    style="
      --collection-products-columns: {{ section.settings.columns }};
      --collection-products-columns-md: {{ section.settings.columns_md }};
      --collection-products-columns-sm: {{ section.settings.columns_sm }};
    "
  >
    {%- if show_filters or show_sort or section.settings.show_count -%}
      <div class="collection-products__top">
        {%- if show_filters or show_sort -%}
        <div class="collection-products__controls">
          {%- if show_filters -%}
            <div data-collection-filter-slot>
              {%- if count_is_partial or visible_count > 4 -%}
                {% render 'ui-catalog-filters', section_id: section.id, pack_sizes: pack_sizes %}
              {%- endif -%}
            </div>
          {%- endif -%}

          {%- if show_sort and collection.sort_options.size > 0 -%}
            {%- liquid
              assign current_sort = collection.sort_by | default: collection.default_sort_by
              assign current_sort_label = ''

              capture sort_items
                for option in collection.sort_options
                  assign is_active = false
                  if option.value == current_sort
                    assign is_active = true
                  endif

                  capture option_link
                    echo collection.url
                    echo '?sort_by='
                    echo option.value
                    echo applied_params
                  endcapture

                  render 'ui-menu-item', label: option.name, link: option_link, selected: is_active
                endfor
              endcapture

              for option in collection.sort_options
                if option.value == current_sort
                  assign current_sort_label = option.name
                  break
                endif
              endfor
            -%}
            {% render 'ui-sort-dropdown',
              items: sort_items,
              label: current_sort_label,
              class: 'collection-products__sort'
            %}
          {%- endif -%}
        </div>

        {%- endif -%}
        {%- if active_count > 0 and has_curated_products == false -%}
          <div class="collection-products__applied">
            {%- for group in collection.filters -%}
              {%- if group.param_name contains 'filter.p.m.custom.' -%}{% continue %}{%- endif -%}
              {%- for value in group.active_values -%}
                {% render 'ui-filter-chip',
                  label: value.label,
                  remove_link: value.url_to_remove,
                  remove_label: 'Remove filter'
                %}
              {%- endfor -%}
            {%- endfor -%}
            {% render 'ui-button', variant: 'link', label: 'Clear all', link: collection.url %}
          </div>
        {%- endif -%}

        {%- if section.settings.show_count and out_of_range == false -%}
          <p class="collection-products__count" data-collection-count aria-live="polite">
            {{- visible_count }}
            {% if visible_count == 1 %}product{% else %}products{% endif %}
            {%- if count_is_partial %} on this page{% endif -%}
          </p>
        {%- endif -%}
      </div>
    {%- endif -%}

      <ul class="collection-products__grid" role="list" data-collection-grid{% if visible_count == 0 %} hidden{% endif %}>
        {{ product_cards }}
      </ul>
      <p class="collection-products__empty" data-collection-filter-empty hidden>No treats match these filters. Try another pack size or price.</p>
      <p class="collection-products__progress" data-collection-progress aria-live="polite"></p>
      <div class="collection-products__more" data-collection-more hidden>
        {% render 'ui-button', variant: 'secondary', label: 'Show more treats', type: 'button', attributes: 'data-collection-more-button' %}
      </div>
      {%- if visible_count == 0 -%}
        <p class="collection-products__empty" data-collection-fallback-empty>
          {%- if out_of_range -%}
            This page has moved. View the collection to keep shopping.
            {% render 'ui-button', variant: 'link', label: 'View products', link: first_page_url %}
          {%- elsif active_count > 0 and has_curated_products == false -%}
            {{ section.settings.empty_text }}
            {% render 'ui-button', variant: 'link', label: 'Clear all', link: collection.url %}
          {%- else -%}
            {%- if count_is_partial -%}
              No retail treats on this page. Browse another page or shop all treats.
            {%- else -%}
              {{ section.settings.empty_text_none | default: 'Nothing here right now. Check back soon.' }}
            {%- endif -%}
            {% render 'ui-button', variant: 'link', label: 'Shop all treats', link: routes.all_products_collection_url %}
          {%- endif -%}
        </p>
      {%- endif -%}

      {%- if count_is_partial -%}
        <p class="collection-products__progress" data-collection-load-status role="status" hidden></p>
        <nav class="collection-products__pagination" aria-label="Pagination">
          {%- liquid
            assign previous_disabled = true
            assign next_disabled = true
            if paginate.previous.is_link
              assign previous_disabled = false
            endif
            if paginate.next.is_link
              assign next_disabled = false
            endif
          -%}
          {% render 'ui-pagination-arrow',
            direction: 'left',
            link: paginate.previous.url,
            disabled: previous_disabled
          %}
          {%- for part in paginate.parts -%}
            {%- if part.is_link -%}
              {% render 'ui-pagination-item', label: part.title, link: part.url %}
            {%- elsif part.title == '&hellip;' -%}
              <span class="collection-products__ellipsis" aria-hidden="true">…</span>
            {%- else -%}
              {% render 'ui-pagination-item', label: part.title, current: true %}
            {%- endif -%}
          {%- endfor -%}
          {% render 'ui-pagination-arrow',
            direction: 'right',
            link: paginate.next.url,
            disabled: next_disabled
          %}
        </nav>
      {%- endif -%}
  </th-collection-products>
</div>
{% endpaginate %}

{%- endif -%}
{% stylesheet %}
  .collection-products__grid[hidden],
  .collection-products__progress[hidden],
  .collection-products__item[hidden],
  .collection-products__more[hidden],
  .collection-products__empty[hidden],
  .collection-products__catalog-filters[hidden],
  .collection-products__progress:empty {
    display: none;
  }

  .collection-products__more,
  .collection-products__progress {
    text-align: center;
  }

  /* Collection products. Mobile first; the drawn four columns arrive at 1200px. */
  .collection-products {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .collection-products__top {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .collection-products__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .collection-products__controls > [data-collection-filter-slot] {
    display: contents;
  }

  .collection-products__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    min-inline-size: 0;
  }

  .collection-products__filters-label {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--ui-color-black);
    font-family: var(--ui-font-accent);
    font-size: 12px;
    font-weight: 500;
    line-height: var(--ui-line-height);
    text-transform: uppercase;
  }

  .collection-products__filters-icon {
    display: block;
    flex: 0 0 auto;
    inline-size: 16px;
    block-size: 16px;
  }

  .collection-products__filters-icon > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Empty, and only here to own the price fields. */
  .collection-products__price-form {
    display: none;
  }

  .collection-products__applied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  /*
   * The rule under the controls is a border on the count rather than an element of
   * its own, so a page with nothing applied and nothing to sort does not leave a
   * line floating over the grid.
   */
  .collection-products__count {
    margin: 0;
    padding-block-start: 24px;
    border-block-start: 1px solid var(--ui-color-border-gray);
    color: var(--ui-color-gray);
    font-family: var(--ui-font-body);
    font-size: 16px;
    font-weight: var(--ui-font-body-weight);
    line-height: var(--ui-line-height);
  }

  .collection-products__grid {
    display: grid;
    grid-template-columns: repeat(var(--collection-products-columns-sm, 2), minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-products__item {
    display: flex;
    min-inline-size: 0;
  }

  .collection-products__item > .ui-product-card {
    inline-size: 100%;
  }

  .collection-products__empty {
    margin: 0;
    color: var(--ui-color-gray);
    font-family: var(--ui-font-body);
    font-size: 16px;
    line-height: var(--ui-line-height);
  }

  .collection-products__pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .collection-products__ellipsis {
    color: var(--ui-color-gray);
    font-family: var(--ui-font-body);
  }

  /*
   * Three counts, as `CLAUDE.md` asks. The file draws four across at 1440 in a
   * 305px card; at 750 a quarter of the page column is 157px, which is narrower
   * than the card's own basket and price row, so the middle tier drops one.
   */
  @media screen and (min-width: 750px) {
    .collection-products__grid {
      grid-template-columns: repeat(var(--collection-products-columns-md, 3), minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1200px) {
    .collection-products__grid {
      grid-template-columns: repeat(var(--collection-products-columns, 4), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection products",
  "tag": "section",
  "settings": [
    {
      "type": "product_list",
      "id": "retail_products",
      "label": "Retail products for this collection",
      "info": "Optional curated selection for this template. Replaces collection membership in this draft, preserving retail and seasonal exclusions. Leave empty to use the collection and its filters and sorting.",
      "limit": 50
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show the filters",
      "info": "The groups come from the collection's own filters, set in Shopify under Search & Discovery. With none set the row hides itself.",
      "default": true
    },
    {
      "type": "text",
      "id": "filters_label",
      "label": "Word before the filters",
      "default": "Filters",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show the sort control",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show how many products",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "When nothing matches the filters",
      "default": "No products match these filters."
    },
    {
      "type": "text",
      "id": "empty_text_none",
      "label": "When the collection is empty",
      "default": "Nothing here right now. Check back soon."
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "info": "From 1200px up.",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_md",
      "label": "Columns from 750px",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_sm",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products shown at a time",
      "info": "Customers can reveal more treats. Without JavaScript, all retail products in the current batch are shown.",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Collection products",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
