{% comment %}
  Shared retail collection grid. Shopify supplies native product order; the
  controller filters the complete visible batch by explicit pack titles and
  starting price before progressively revealing cards. Unfinished Search &
  Discovery metafields are not presented as customer filters.
{% endcomment %}

{%- comment -%}
  This section can be requested without layout/theme.liquid. Enforce the
  collection's own access decision before rendering its contents.
{%- endcomment -%}
{%- capture collection_access -%}
  {%- render 'locksmith-variables', scope: 'subject', subject: collection, variable: 'access_granted' -%}
{%- endcapture -%}
{%- if collection_access == 'true' -%}
{%- liquid
  assign products_per_page = section.settings.products_per_page

  assign show_filters = section.settings.show_filters
  assign show_sort = section.settings.show_sort
  assign curated_products = section.settings.retail_products
  if curated_products == blank
    case collection.handle
      when 'get-well'
        assign curated_products = settings.get_well_retail_products
      when 'congratulations'
        assign curated_products = settings.congratulations_retail_products
    endcase
  endif
  assign has_curated_products = false
  if curated_products.size > 0
    assign has_curated_products = true
    # Native facets and sort describe collection membership, not the curated list.
    assign show_filters = false
    assign show_sort = false
  endif

  # The facets already applied, rebuilt as a query fragment so a sort link can carry
  # them. `url_to_add`/`url_to_remove` answer a different question — they each move
  # one value — and there is no filter that gives back the current query string.
  capture applied_params
    for group in collection.filters
      if group.param_name contains 'filter.p.m.custom.'
        continue
      endif
      for value in group.active_values
        echo '&'
        echo value.param_name
        echo '='
        echo value.value | url_encode
      endfor
      if group.min_value.value != blank
        echo '&'
        echo group.min_value.param_name
        echo '='
        echo group.min_value.value
      endif
      if group.max_value.value != blank
        echo '&'
        echo group.max_value.param_name
        echo '='
        echo group.max_value.value
      endif
    endfor
  endcapture

  assign active_count = 0
  for group in collection.filters
    if group.param_name contains 'filter.p.m.custom.'
      continue
    endif
    assign active_count = active_count | plus: group.active_values.size
  endfor
-%}

{%- if collection.handle == 'holidays' and settings.seasonal_hub_collections.size > 0 -%}
  {% render 'ui-seasonal-hub', collections: settings.seasonal_hub_collections %}
{%- else -%}
<script src="{{ 'th-collection-products.js' | asset_url }}" defer></script>
{% comment %}
  Keep the document's native collection analytics bounded to 24 products. Larger
  retail lists are enhanced through a layout-free Section Rendering response;
  failed/no-JavaScript requests retain this honest page count and native links.
{% endcomment %}
{% paginate collection.products by 24 %}
  {% render 'collection-products-source',
    mode: 'grid',
    collection: collection,
    section: section,
    paginate: paginate,
    curated_products: curated_products,
    has_curated_products: has_curated_products,
    products_per_page: products_per_page,
    show_filters: show_filters,
    show_sort: show_sort,
    applied_params: applied_params,
    active_count: active_count
  %}
{% endpaginate %}

{%- endif -%}
{%- else -%}
  <template data-collection-access-denied></template>
{%- endif -%}
{% stylesheet %}
  .section.collection-products-section--catalog {
    padding-block-start: 24px;
  }

  .collection-products__grid[hidden],
  .collection-products__progress[hidden],
  .collection-products__item[hidden],
  .collection-products__more[hidden],
  .collection-products__empty[hidden],
  .collection-products__catalog-filters[hidden],
  .collection-products__progress:empty {
    display: none;
  }

  .collection-products__more,
  .collection-products__progress {
    text-align: center;
  }

  /* Collection products. Mobile first; the drawn four columns arrive at 1200px. */
  .collection-products {
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .collection-products__top {
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .collection-products__controls {
    display: flex;
    flex-wrap: wrap;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
  }

  .collection-products__controls > [data-collection-filter-slot] {
    display: contents;
  }

  .collection-products__filters {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px;
    min-inline-size: 0;
  }

  .collection-products__filters-label {
    display: flex;
    align-items: center;
    gap: 4px;
    color: var(--ui-color-black);
    font-family: var(--ui-font-accent);
    font-size: 12px;
    font-weight: 500;
    line-height: var(--ui-line-height);
    text-transform: uppercase;
  }

  .collection-products__filters-icon {
    display: block;
    flex: 0 0 auto;
    inline-size: 16px;
    block-size: 16px;
  }

  .collection-products__filters-icon > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* Empty, and only here to own the price fields. */
  .collection-products__price-form {
    display: none;
  }

  .collection-products__applied {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px;
  }

  /*
   * The rule under the controls is a border on the count rather than an element of
   * its own, so a page with nothing applied and nothing to sort does not leave a
   * line floating over the grid.
   */
  .collection-products__count {
    margin: 0;
    padding-block-start: 24px;
    border-block-start: 1px solid var(--ui-color-border-gray);
    color: var(--ui-color-gray);
    font-family: var(--ui-font-body);
    font-size: 16px;
    font-weight: var(--ui-font-body-weight);
    line-height: var(--ui-line-height);
  }

  .collection-products__grid {
    display: grid;
    grid-template-columns: repeat(var(--collection-products-columns-sm, 2), minmax(0, 1fr));
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .collection-products__item {
    display: flex;
    min-inline-size: 0;
  }

  .collection-products__item > .ui-product-card {
    inline-size: 100%;
  }

  .collection-products__empty {
    margin: 0;
    color: var(--ui-color-gray);
    font-family: var(--ui-font-body);
    font-size: 16px;
    line-height: var(--ui-line-height);
  }

  .collection-products__pagination {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 8px;
  }

  .collection-products__ellipsis {
    color: var(--ui-color-gray);
    font-family: var(--ui-font-body);
  }

  /*
   * Three counts, as `CLAUDE.md` asks. The file draws four across at 1440 in a
   * 305px card; at 750 a quarter of the page column is 157px, which is narrower
   * than the card's own basket and price row, so the middle tier drops one.
   */
  @media screen and (min-width: 750px) {
    .collection-products__grid {
      grid-template-columns: repeat(var(--collection-products-columns-md, 3), minmax(0, 1fr));
    }
  }

  @media screen and (min-width: 1200px) {
    .collection-products__grid {
      grid-template-columns: repeat(var(--collection-products-columns, 4), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Collection products",
  "tag": "section",
  "settings": [
    {
      "type": "product_list",
      "id": "retail_products",
      "label": "Retail products for this collection",
      "info": "Optional curated selection for this template. Replaces collection membership in this draft, preserving retail and seasonal exclusions. Leave empty to use the collection and its filters and sorting.",
      "limit": 50
    },
    {
      "type": "header",
      "content": "Filtering and sorting"
    },
    {
      "type": "checkbox",
      "id": "show_filters",
      "label": "Show the filters",
      "info": "The groups come from the collection's own filters, set in Shopify under Search & Discovery. With none set the row hides itself.",
      "default": true
    },
    {
      "type": "text",
      "id": "filters_label",
      "label": "Word before the filters",
      "default": "Filters",
      "visible_if": "{{ section.settings.show_filters }}"
    },
    {
      "type": "checkbox",
      "id": "show_sort",
      "label": "Show the sort control",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_count",
      "label": "Show how many products",
      "default": true
    },
    {
      "type": "text",
      "id": "empty_text",
      "label": "When nothing matches the filters",
      "default": "No products match these filters."
    },
    {
      "type": "text",
      "id": "empty_text_none",
      "label": "When the collection is empty",
      "default": "Nothing here right now. Check back soon."
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "t:settings.columns",
      "info": "From 1200px up.",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_md",
      "label": "Columns from 750px",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "columns_sm",
      "label": "Columns on mobile",
      "options": [
        { "value": "1", "label": "1" },
        { "value": "2", "label": "2" }
      ],
      "default": "2"
    },
    {
      "type": "range",
      "id": "products_per_page",
      "label": "Products shown at a time",
      "info": "Customers can reveal more treats. Without JavaScript, all retail products in the current batch are shown.",
      "min": 4,
      "max": 48,
      "step": 4,
      "default": 24
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        { "value": "page-width", "label": "t:options.page" },
        { "value": "full-width", "label": "t:options.full" }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Collection products",
      "category": "t:categories.products"
    }
  ]
}
{% endschema %}
