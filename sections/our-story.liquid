{% comment %}
  Our story — Figma: Work Page → Our story (desktop 491:15093, mobile 491:14837).

  A tinted band with the copy beside the photograph on desktop and stacked on
  mobile. The band runs the full width of the viewport while the content stops at
  the page width, so the colour reaches the edges on a wide screen without the
  text following it out.

  The section owns the band, the photograph and the arrangement. The heading and
  the copy are blocks, so a second page can tell a different story in the same
  frame. See `docs/section-settings.md`.

  Mobile centres the text; desktop sets it to the left. That is the file, not an
  oversight.

  The file draws this frame twice. Our story is a photograph on a tinted band; Custom
  Treats is a cut-out standing on a tinted tile with a button under the copy, on the
  white page. The columns are the same to within three pixels — 618 of media, about
  560 of copy, 100 between — so they are one section with `background`, `media_style`
  and a `_ui-link` block, not two sections that would drift apart the first time the
  gutter moves.

  `media_style` is the substantive one. `photo` crops a photograph to fill the frame
  at the ratio Our story draws. `cut-out` gives the frame its own tinted fill and sets
  the picture inside it whole, because a cut-out treat cropped to fill is a cut-out
  with its corners cut off.
{% endcomment %}

<div
  class="our-story our-story--on-{{ section.settings.background }} our-story--media-{{ section.settings.media_position }} our-story--{{ section.settings.media_style }}"
  style="
    --our-story-block-padding: {{ section.settings.vertical_padding_mobile }}px;
    --our-story-block-padding-desktop: {{ section.settings.vertical_padding }}px;
    --our-story-text-gap-desktop: {{ section.settings.text_gap }}px;
  "
  data-testid="our-story-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="our-story__inner">
    <div class="our-story__text">
      {% content_for 'blocks' %}
    </div>

    <div class="our-story__media">
      {%- if section.settings.image != blank -%}
        {% render 'image', image: section.settings.image, height: 552, class: 'our-story__image' %}
      {%- else -%}
        {%- comment -%} Photography is not in yet; hold the frame so the band reads true. {%- endcomment -%}
        <span class="our-story__image-placeholder" aria-hidden="true"></span>
      {%- endif -%}
    </div>
  </div>
</div>

{% stylesheet %}
  /* Our story. Mobile first; the two-column layout starts at the theme's 750px. */
  .our-story {
    --our-story-gap: 32px;
    --our-story-text-gap: 24px;
    --our-story-radius: 16px;

    background-color: var(--our-story-background, var(--ui-color-light-blue));
  }

  /*
   * The band is the section's; the tile behind a cut-out is the frame's. They are
   * two decisions and the file makes them differently in each cut — Custom Treats
   * puts the tint inside the frame and leaves the page white.
   */
  .our-story--on-white {
    --our-story-background: var(--ui-color-white);
  }

  .our-story--on-none {
    --our-story-background: transparent;
  }

  .our-story__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    box-sizing: border-box;
    gap: var(--our-story-gap);
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    padding-block: var(--our-story-block-padding, 64px);
    padding-inline: var(--ui-page-margin);
  }

  /*
   * Two columns from 990px, not the theme's usual 750px. The photograph is drawn
   * 618 wide against the copy's 562, so at 750px the pair has 570px to share and
   * neither is worth reading.
   */
  @media screen and (min-width: 990px) {
    /*
     * The file draws the columns 562 and 618 inside 1280 with 100 between them.
     * As fr they keep that proportion at every width, so the loss is shared —
     * a fixed 618 on the photograph made the copy pay all of it, and by 960px
     * the copy was down to 230.
     */
    .our-story__inner {
      display: grid;
      grid-template-columns: minmax(0, 562fr) minmax(0, 618fr);
      align-items: center;
      gap: 100px;
      padding-block: var(--our-story-block-padding-desktop, 32px);
    }

    .our-story--media-start .our-story__inner {
      grid-template-columns: minmax(0, 618fr) minmax(0, 562fr);
    }

    .our-story--media-start .our-story__media {
      order: -1;
    }
  }

  /*
   * The content area. The measurements the file draws reach the blocks as
   * custom properties, and a block writes its own only when the merchant moves
   * the matching setting — so these are defaults, not overrides.
   */
  .our-story__text {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: var(--our-story-text-gap);
    width: 100%;

    /*
     * Stacked, the copy has the whole page column, which above 750px is more
     * than twice the measure the file sets. The cap is the width it has on the
     * widest frame drawn; on a phone nothing reaches it.
     */
    max-width: 634px;
    margin-inline: auto;
    text-align: center;
  }

  @media screen and (min-width: 990px) {
    .our-story__text {
      /* The copy stops short of the column it sits in, as the file draws it. */
      --ui-text-max-width: 521px;

      align-items: flex-start;
      gap: var(--our-story-text-gap-desktop, 32px);
      max-width: none;
      margin-inline: 0;
      text-align: start;
    }
  }

  /*
   * The button stands further from the copy than the copy does from the heading —
   * 32 on a phone and 48 above it, against the column's own 24. That is the
   * section saying where a block stands, not the block saying it: `_ui-link` has
   * one padding setting and this wants two figures.
   */
  .our-story__text > .ui-link {
    margin-block-start: 8px;
  }

  @media screen and (min-width: 990px) {
    .our-story__text > .ui-link {
      margin-block-start: 24px;
    }
  }

  .our-story__media {
    width: 100%;

    /*
     * Stacked, the photograph keeps the width it is drawn at on the widest
     * frame instead of growing with the page: at 880px the ratio would spend
     * 786px of scroll on it.
     */
    max-width: 618px;
    margin-inline: auto;
  }

  @media screen and (min-width: 990px) {
    .our-story__media {
      max-width: none;
      margin-inline: 0;
    }
  }

  .our-story__image,
  .our-story__image-placeholder {
    display: block;
    width: 100%;
    aspect-ratio: var(--our-story-ratio, 345 / 308);
    border-radius: var(--our-story-radius);
    object-fit: var(--our-story-image-fit, cover);
  }

  /*
   * The cut-out frame. Its two ratios are the file's own and are not the
   * photograph's: 358 by 278 on a phone and 618 by 419 above it, against the one
   * ratio a photograph keeps at both sizes. They ride with the style rather than
   * becoming settings, because the frame is the drawn geometry and the merchant's
   * decision is which of the two treatments this is.
   */
  .our-story--cut-out {
    --our-story-ratio: 358 / 278;
  }

  /*
   * On this style the frame holds the shape and the tint, and the picture sits
   * inside it whole. The file gives the tile no padding — the cut-out simply does
   * not reach the sides, which is what `contain` does on its own once the frame is
   * wider than the picture.
   */
  .our-story--cut-out .our-story__media {
    aspect-ratio: var(--our-story-ratio);
    overflow: hidden;
    border-radius: var(--our-story-radius);
    background-color: var(--our-story-tile, var(--ui-color-light-blue));
  }

  .our-story--cut-out .our-story__image,
  .our-story--cut-out .our-story__image-placeholder {
    /* The frame carries the ratio now, so the picture takes the height it is given
       and keeps its own proportions inside it. */
    aspect-ratio: auto;
    block-size: 100%;
    border-radius: 0;
    object-fit: contain;
  }

  .our-story--cut-out .our-story__image-placeholder {
    background-color: transparent;
  }

  @media screen and (min-width: 990px) {
    .our-story--cut-out {
      --our-story-ratio: 618 / 419;
    }
  }

  .our-story__image-placeholder {
    background-color: var(--ui-color-border-gray);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Our story",
  "tag": "section",
  "blocks": [
    {
      "type": "_ui-heading"
    },
    {
      "type": "_ui-text"
    },
    {
      "type": "_ui-link"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "t:settings.image",
      "info": "Left empty, the frame is held with a placeholder."
    },
    {
      "type": "select",
      "id": "media_style",
      "label": "How the picture sits in its frame",
      "options": [
        {
          "value": "photo",
          "label": "A photograph, cropped to fill"
        },
        {
          "value": "cut-out",
          "label": "A cut-out on a tinted tile"
        }
      ],
      "default": "photo"
    },
    {
      "type": "select",
      "id": "media_position",
      "label": "Image position",
      "info": "Which side of the copy the photograph stands on. Below 750px it always follows the copy.",
      "options": [
        {
          "value": "end",
          "label": "t:options.right"
        },
        {
          "value": "start",
          "label": "t:options.left"
        }
      ],
      "default": "end"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "text_gap",
      "label": "Gap between the heading and the copy",
      "info": "Above 990px. Below it the file draws 24 in both cuts, which is what the column takes.",
      "min": 8,
      "max": 64,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "light-blue",
          "label": "Light blue"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "none",
          "label": "Transparent"
        }
      ],
      "default": "light-blue"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "t:settings.vertical_padding",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 32
    },
    {
      "type": "range",
      "id": "vertical_padding_mobile",
      "label": "Vertical padding on mobile",
      "info": "The band is taller on a phone than on a desktop in the file, because the copy and the photograph stand one above the other.",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Our story",
      "category": "t:categories.storytelling",
      "blocks": {
        "heading": {
          "type": "_ui-heading",
          "settings": {
            "heading": "<h2>Our <em>story</em></h2>"
          }
        },
        "body": {
          "type": "_ui-text",
          "settings": {
            "text": "<p>The idea for Treat House was inspired by a charitable bake sale that Daniel and Eli Russell had in 2011. The proceeds went to provide athletic equipment for impoverished children in Africa.</p><p>Giving back to our greater community has always been key to Treat House's mission. For the first year of business, Treat House donated 10 cents for every treat sold to the Food Bank of NY.</p><p>Starting in 2015 Treat House formed a partnership with the Lymphoma and Leukemia Society. Now we are thrilled to also partner with The Andrew McDonough B+ Foundation. We have been blown away by their commitment to help fight those affected by childhood cancer.</p>"
          }
        }
      },
      "block_order": [
        "heading",
        "body"
      ]
    },
    {
      "name": "Custom treats",
      "category": "t:categories.storytelling",
      "settings": {
        "media_style": "cut-out",
        "media_position": "start",
        "background": "white",
        "text_gap": 24,
        "vertical_padding": 80,
        "vertical_padding_mobile": 64
      },
      "blocks": {
        "heading": {
          "type": "_ui-heading",
          "settings": {
            "heading": "<h2><em>Custom</em> Treats</h2>"
          }
        },
        "body": {
          "type": "_ui-text",
          "settings": {
            "text": "<p>Create a one-of-a-kind treat made just for you. Personalize it with your own photo, message, or design.</p>",
            "max_width": 400
          }
        },
        "cta": {
          "type": "_ui-link",
          "settings": {
            "label": "Create your custom treat",
            "variant": "primary"
          }
        }
      },
      "block_order": [
        "heading",
        "body",
        "cta"
      ]
    }
  ]
}
