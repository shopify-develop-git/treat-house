      "limit": 12
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Cards to show",
      "info": "The most the row will hold. Related and Recently viewed may have fewer.",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "paragraph",
      "content": "Badges and taglines come from the product metafields custom.badge, custom.badge_tone and custom.tagline. Tones: purple, orange, yellow, sky-blue."
