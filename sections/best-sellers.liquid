{% comment %}
  A titled row of product cards. The file draws it twice — Best Sellers and Custom
  Treats — and the two differ only in settings, so they are one section with two
  presets rather than two sections that would drift apart.

  What separates them: the heading is left with the button beside it in one and
  centred with the button beneath in the other; the accent leads the heading in one
  and trails it in the other; the band is tinted in one and white in the other; and
  the media is a little shorter where titles run to two lines.

  The section owns the row, the band and the arrangement. The title and the call
  to action are static blocks, standing in the grid areas the layout puts them
  in rather than in a content column, because the button moves from beside the
  heading to under the row and back. See `docs/section-settings.md`.

  Built from the kit: ui-product-card for the tiles and ui-pagination-arrow for
  the carousel controls.

  Desktop and mobile are the same markup in a different grid. One button serves
  both — grid areas move it from beside the heading to under the row, so it is not
  rendered twice and the tab order stays in reading order at either width.

  Below 750px the row is a scroll-snap carousel with the neighbours peeking, as the
  file draws it. The row stays that one scroll-snap track at every width — only the
  card's width changes, from the drawn 240px to a share of the columns asked for. A
  row that does not fit therefore scrolls rather than wrapping a lone card onto a
  second line, which reads as a mistake rather than a choice.

  The arrows show only while there is somewhere to go: ui-carousel.js marks the
  element `data-scrollable` whenever the track overflows, so a row that fits has no
  controls and needs no breakpoint to hide them.

  Badges come from product metafields — `custom.badge` for the text and
  `custom.badge_tone` for the colour — since they are editorial and change per
  product, not per section. The same goes for `custom.tagline`, which falls back to
  the start of the product's description.
{% endcomment %}

{%- liquid
  assign chosen = section.settings.products
  assign card_limit = section.settings.max_products

  assign onboarding_titles = 'Birthday 12-Pack,Birthday Bash Box,Birthday Party Bar,Custom Photo,Gluten Free 12-Pack' | split: ','
  assign onboarding_copy = 'Classic birthday assortment,Birthday Party in a box,Classic birthday assortment,12 Pack of Custom Birthday Treats,Gluten-Free Crispy Rice' | split: ','
  assign onboarding_prices = '$ 38.00,$ 99.00,$ 60.00,$ 42.00,$ 36.00' | split: ','
  assign onboarding_badges = 'Bestsellers,New,Gift ready,Custom photo,' | split: ','
  assign onboarding_tones = 'orange,yellow,purple,sky-blue,purple' | split: ','
-%}

<div class="section-background color-{{ section.settings.color_scheme }} best-sellers-bg best-sellers-bg--{{ section.settings.background }}"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="best-sellers-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div
    class="best-sellers best-sellers--cta-{{ section.settings.cta_position }} best-sellers--heading-{{ section.settings.heading_alignment }}"
    style="
      --ui-product-card-media-ratio: {{ section.settings.media_ratio }};
      --best-sellers-columns: {{ section.settings.columns }};
      --best-sellers-columns-md: {{ section.settings.columns_md }};
      --best-sellers-columns-sm: {{ section.settings.columns_sm }};
    "
  >
    {% content_for 'block', type: '_ui-heading', id: 'heading' %}

    <ui-carousel class="best-sellers__viewport">
      <ul class="best-sellers__track" role="list" data-carousel-track>
        {%- if chosen.size > 0 -%}
          {%- for product in chosen limit: card_limit -%}
            {%- liquid
              assign tagline = product.metafields.custom.tagline
              if tagline == blank
                assign tagline = product.description | strip_html | truncatewords: 6
              endif

              # A named argument takes no filter, so `price: product.price | money`
              # hands the card the raw cents and says nothing about it. Format first.
              assign price = product.price | money
            -%}

            {%- capture add_control -%}
              {% render 'ui-product-card-add', product: product, section_id: section.id %}
            {%- endcapture -%}
            <li class="best-sellers__item">
              {% render 'ui-product-card',
                title: product.title,
                subtitle: tagline,
                price: price,
                image: product.featured_image,
                link: product.url,
                badge: product.metafields.custom.badge,
                badge_tone: product.metafields.custom.badge_tone,
                add_content: add_control
              %}
            </li>
          {%- endfor -%}
        {%- else -%}
          {%- for placeholder_title in onboarding_titles limit: card_limit -%}
            {%- assign i = forloop.index0 -%}
            <li class="best-sellers__item">
              {% render 'ui-product-card',
                title: placeholder_title,
                subtitle: onboarding_copy[i],
                price: onboarding_prices[i],
                badge: onboarding_badges[i],
                badge_tone: onboarding_tones[i]
              %}
            </li>
          {%- endfor -%}
        {%- endif -%}
      </ul>

      {% render 'ui-pagination-arrow',
        direction: 'left',
        class: 'best-sellers__arrow best-sellers__arrow--prev',
        attributes: 'data-carousel-prev'
      %}
      {% render 'ui-pagination-arrow',
        direction: 'right',
        class: 'best-sellers__arrow best-sellers__arrow--next',
        attributes: 'data-carousel-next'
      %}
    </ui-carousel>

    {% content_for 'block', type: '_ui-link', id: 'cta' %}
  </div>
</div>

{% render 'ui-carousel' %}

{% stylesheet %}
  /*
   * The tint goes on .section-background, not on .section. Horizon forces every
   * section transparent from base.css at a specificity of four classes, because the
   * background is this element's job — painting .section instead loses silently and
   * the section comes out white.
   *
   * Compound with .section-background so this outranks the colour scheme's own
   * background rather than depending on which stylesheet is concatenated last.
   */
  .section-background.best-sellers-bg--light-blue {
    background-color: var(--ui-color-light-blue);
  }

  .section-background.best-sellers-bg--white {
    background-color: var(--ui-color-white);
  }

  .best-sellers {
    display: grid;

    /* minmax(0, …) or the carousel, which overflows on purpose, sizes the track it
       sits in and drags the button and the row's own padding out with it. */
    grid-template-columns: minmax(0, 1fr);
    grid-template-areas:
      'heading'
      'row'
      'cta';
    gap: 32px;
  }

  /*
   * Centred over the row on mobile, beside it on desktop. Reached as a child of
   * the section rather than by a class of its own: the heading block owns its
   * type and this owns where it stands, and a descendant selector outweighs the
   * block's own rules without depending on which stylesheet is concatenated last.
   */
  .best-sellers > .ui-heading {
    grid-area: heading;
    text-align: center;
  }

  .best-sellers__viewport {
    grid-area: row;
    position: relative;
    display: block;

    /* The row runs to the window edge so the neighbouring cards peek, while the
       arrows stay on the page's own margin. */
    margin-inline: calc(var(--page-margin) * -1);

    /* Opens on the second card: the peeking arrangement is drawn already moved
       along, and a first card flush to the edge hides that the row scrolls. */
    --ui-carousel-start: 2;
  }

  .best-sellers__track {
    display: flex;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    /* Half a viewport either side of a card centres the first and last one. */
    padding-inline: calc((100% - var(--best-sellers-card-width, 240px)) / 2);
  }

  .best-sellers__track::-webkit-scrollbar {
    display: none;
  }

  .best-sellers__item {
    flex: 0 0 var(--best-sellers-card-width, 240px);
    display: flex;
    scroll-snap-align: center;
  }

  .best-sellers__arrow {
    position: absolute;
    inset-block-start: 50%;
    transform: translateY(-50%);
    z-index: 1;
  }

  .best-sellers__arrow--prev {
    inset-inline-start: var(--page-margin);
  }

  .best-sellers__arrow--next {
    inset-inline-end: var(--page-margin);
  }

  /* Named with the component class so this does not depend on which stylesheet is
     concatenated last. The attribute comes from ui-carousel.js. */
  .ui-pagination-arrow.best-sellers__arrow {
    display: none;
  }

  .best-sellers__viewport[data-scrollable] .ui-pagination-arrow.best-sellers__arrow {
    display: inline-flex;
  }

  .best-sellers > .ui-link {
    grid-area: cta;
  }

  .best-sellers > .ui-link .ui-button {
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .best-sellers {
      /* minmax(0, …) so a long heading cannot push the button out of the row. */
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas:
        'heading cta'
        'row row';
      align-items: center;
      gap: 48px 20px;
    }

    .best-sellers > .ui-heading {
      text-align: start;
    }

    .best-sellers--heading-center.best-sellers > .ui-heading {
      text-align: center;
    }

    /* The button under the row wants the mobile stack back, just with the desktop
       rhythm — one column, and the button centred rather than stretched. */
    .best-sellers--cta-below {
      grid-template-columns: minmax(0, 1fr);
      grid-template-areas:
        'heading'
        'row'
        'cta';
      gap: 48px;
    }

    .best-sellers--cta-below > .ui-link {
      justify-self: center;
    }

    /* Back inside the page column: a grid has nothing to peek past. */
    .best-sellers__viewport {
      margin-inline: 0;

      /* No peeking card to reveal once the cards fill the row. */
      --ui-carousel-start: 1;
    }

    .best-sellers__track {
      padding-inline: 0;
      scroll-snap-type: x proximity;
    }

    /* A column is a card width, not a grid track. */
    .best-sellers__item {
      flex-basis: calc(
        (100% - (var(--best-sellers-columns-sm, 3) - 1) * 20px) / var(--best-sellers-columns-sm, 3)
      );
      scroll-snap-align: start;
    }

    /* The row sits inside the page column now, so the arrows sit on its own edges. */
    .best-sellers__arrow--prev {
      inset-inline-start: 0;
    }

    .best-sellers__arrow--next {
      inset-inline-end: 0;
    }

    .best-sellers > .ui-link .ui-button {
      width: auto;
    }
  }

  /*
   * The file draws five columns, and five only reach the 240px card at 1440px.
   * The steps below it are chosen by what they do to the card rather than by the
   * theme's usual breakpoints: three columns are already 360px wide by 1199px,
   * half again the width drawn, so the fourth arrives at 1024px instead.
   */
  @media screen and (min-width: 1024px) {
    .best-sellers__item {
      flex-basis: calc(
        (100% - (var(--best-sellers-columns-md, 4) - 1) * 20px) / var(--best-sellers-columns-md, 4)
      );
    }
  }

  @media screen and (min-width: 1440px) {
    .best-sellers__item {
      flex-basis: calc(
        (100% - (var(--best-sellers-columns, 5) - 1) * 20px) / var(--best-sellers-columns, 5)
      );
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Product row",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Products"
    },
    {
      "type": "product_list",
      "id": "products",
      "label": "Products",
      "limit": 12
    },
    {
      "type": "range",
      "id": "max_products",
      "label": "Cards to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 5
    },
    {
      "type": "paragraph",
      "content": "Badges and taglines come from the product metafields custom.badge, custom.badge_tone and custom.tagline. Tones: purple, orange, yellow, sky-blue."
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Heading alignment",
      "info": "Above 750px only. Below it the heading is centred over the row.",
      "options": [
        {
          "value": "start",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Centred"
        }
      ],
      "default": "start"
    },
    {
      "type": "select",
      "id": "cta_position",
      "label": "Button position",
      "options": [
        {
          "value": "heading",
          "label": "Beside the heading"
        },
        {
          "value": "below",
          "label": "Below the row"
        }
      ],
      "default": "heading"
    },
    {
      "type": "select",
      "id": "media_ratio",
      "label": "Image shape",
      "info": "The media's natural height. A card whose title runs to two lines shrinks it rather than growing the card.",
      "options": [
        {
          "value": "240 / 215",
          "label": "Standard"
        },
        {
          "value": "4 / 3",
          "label": "Shorter (4:3)"
        },
        {
          "value": "1 / 1",
          "label": "Square"
        },
        {
          "value": "3 / 4",
          "label": "Taller (3:4)"
        }
      ],
      "default": "240 / 215"
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns from 1440px",
      "min": 3,
      "max": 6,
      "step": 1,
      "default": 5
    },
    {
      "type": "range",
      "id": "columns_md",
      "label": "Columns 1024–1439px",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "columns_sm",
      "label": "Columns 750–1023px",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "light-blue",
          "label": "Light blue"
        },
        {
          "value": "white",
          "label": "White"
        },
        {
          "value": "none",
          "label": "Colour scheme"
        }
      ],
      "default": "light-blue"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Bestsellers",
      "category": "t:categories.products",
      "settings": {
        "heading_alignment": "start",
        "cta_position": "heading",
        "background": "light-blue",
        "media_ratio": "240 / 215"
      },
      "blocks": {
        "heading": {
          "type": "_ui-heading",
          "static": true,
          "settings": {
            "heading": "<h2>Bestsellers</h2>"
          }
        },
        "cta": {
          "type": "_ui-link",
          "static": true,
          "settings": {
            "label": "View all products",
            "variant": "primary"
          }
        }
      }
    },
    {
      "name": "Custom treats",
      "category": "t:categories.products",
      "settings": {
        "heading_alignment": "center",
        "cta_position": "below",
        "background": "white",
        "media_ratio": "4 / 3"
      },
      "blocks": {
        "heading": {
          "type": "_ui-heading",
          "static": true,
          "settings": {
            "heading": "<h2><em>Custom</em> Treats</h2>"
          }
        },
        "cta": {
          "type": "_ui-link",
          "static": true,
          "settings": {
            "label": "View all products",
            "variant": "primary"
          }
        }
      }
    }
  ]
}
{% endschema %}
