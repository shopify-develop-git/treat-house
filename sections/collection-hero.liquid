{{ 'catalog-components.css' | asset_url | stylesheet_tag }}

{% comment %}
  Rounded collection banner using real transparent product photography on one
  continuous brand-blue background. Known approved cutouts replace the older
  generated banner images; a custom.hero_cutout collection file can override
  them for future merchant updates. Other collection imagery retains its normal
  image-picker/metafield behavior. Title and body remain editable theme blocks.
{% endcomment %}

{%- liquid
  assign hero_collection = collection
  if request.visual_preview_mode and hero_collection == blank
    assign hero_collection = collections.all
  endif
  assign is_catalog_header = false
  assign is_wholesale_header = false
  if hero_collection.handle == 'all' or hero_collection.handle == 'shop-all'
    assign is_catalog_header = true
  elsif hero_collection.handle == 'wholesale-page'
    assign is_catalog_header = true
    assign is_wholesale_header = true
  endif

  assign hero_image = section.settings.image
  assign hero_image_mobile = section.settings.image_mobile

  # The collection's own banner wins over the template's. `.value` is what a
  # file_reference hands back — the metafield object itself is not an image, and
  # asking it for a URL renders nothing rather than failing loudly.
  assign image_key = section.settings.image_metafield
  if image_key != blank
    assign from_collection = hero_collection.metafields.custom[image_key].value
    if from_collection != blank
      assign hero_image = from_collection
    endif
  endif

  assign image_key_mobile = section.settings.image_mobile_metafield
  if image_key_mobile != blank
    assign from_collection_mobile = hero_collection.metafields.custom[image_key_mobile].value
    if from_collection_mobile != blank
      assign hero_image_mobile = from_collection_mobile
    endif
  endif

  # Either picker on its own is a whole banner. Only both empty holds the frame.
  if hero_image == blank
    assign hero_image = hero_image_mobile
  endif

  capture hero_image_asset
    render 'collection-hero-asset', collection: hero_collection
  endcapture
  assign hero_image_asset = hero_image_asset | strip
  assign hero_cutout = hero_collection.metafields.custom.hero_cutout.value
  assign is_cutout_banner = false
  if hero_image_asset != blank or hero_cutout != blank
    assign is_cutout_banner = true
    assign hero_image = hero_cutout
    assign hero_image_mobile = ''
  endif
  assign hero_asset_width = 600
  assign hero_asset_height = 660
-%}

<div
  class="section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }}{% if is_catalog_header %} collection-hero-section--catalog{% endif %}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="collection-hero-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div
    class="collection-hero{% if is_catalog_header %} collection-hero--catalog{% endif %}{% if is_wholesale_header %} collection-hero--wholesale{% endif %}"
    style="
      --collection-hero-height: {{ section.settings.height_mobile }}px;
      --collection-hero-height-desktop: {{ section.settings.height }}px;
    "
  >
    {%- if section.settings.show_breadcrumb and is_catalog_header == false -%}
      {% render 'ui-breadcrumb',
        parent_title: section.settings.parent_title,
        parent_url: section.settings.parent_link,
        current: hero_collection.title,
        class: 'collection-hero__breadcrumb'
      %}
    {%- endif -%}

    <div class="collection-hero__card{% if is_cutout_banner and is_catalog_header == false %} collection-hero__card--cutout{% endif %}">
      {%- unless is_catalog_header -%}
      <div class="collection-hero__media" aria-hidden="true">
        {%- if hero_image != blank -%}
          <picture>
            {%- if hero_image_mobile != blank -%}
              <source
                media="(max-width: 749px)"
                srcset="
                  {{ hero_image_mobile | image_url: width: 750 }} 1x,
                  {{ hero_image_mobile | image_url: width: 1500 }} 2x
                "
              >
            {%- endif -%}
            {% render 'image', image: hero_image, height: 760, class: 'collection-hero__image', loading: 'eager' %}
          </picture>
        {%- elsif hero_image_asset != blank -%}
          <img
            src="{{ hero_image_asset | asset_url }}"
            width="{{ hero_asset_width }}"
            height="{{ hero_asset_height }}"
            class="collection-hero__image"
            loading="eager"
            alt=""
          >
        {%- else -%}
          {%- comment -%} Photography is not in yet; hold the frame so the band reads true. {%- endcomment -%}
          <span class="collection-hero__image collection-hero__image--placeholder"></span>
        {%- endif -%}
      </div>

      {%- if section.settings.show_scrim and is_cutout_banner == false -%}
        <span
          class="collection-hero__scrim"
          style="--collection-hero-scrim: {{ section.settings.scrim_opacity | divided_by: 100.0 }};"
          aria-hidden="true"
        ></span>
      {%- endif -%}
      {%- endunless -%}

      <div class="collection-hero__content">
        {%- if section.settings.show_star and is_catalog_header == false -%}
          <span class="collection-hero__star" aria-hidden="true">
            {{- 'icon-ui-sparkle.svg' | inline_asset_content -}}
          </span>
        {%- endif -%}

        <div class="collection-hero__text">
          {%- if is_wholesale_header -%}
            <h1 class="collection-hero__wholesale-heading">{{ 'content.wholesale_catalog_title' | t }}</h1>
            <p class="collection-hero__wholesale-description">{{ 'content.wholesale_catalog_description' | t }}</p>
          {%- else -%}
            {% content_for 'blocks' %}
          {%- endif -%}
        </div>
      </div>
    </div>
  </div>
</div>

{% comment %} Styles are owned by assets/catalog-components.css and loaded by catalog render parents. {% endcomment %}

{% schema %}
{
  "name": "Collection hero",
  "tag": "section",
  "blocks": [
    {
      "type": "_ui-heading"
    },
    {
      "type": "_ui-text"
    }
  ],
  "settings": [
    {
      "type": "header",
      "content": "t:content.media"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Banner, every collection",
      "info": "Fallback for collections without an approved cutout. For a cutout replacement, set the collection file metafield custom.hero_cutout."
    },
    {
      "type": "image_picker",
      "id": "image_mobile",
      "label": "Banner on mobile, every collection",
      "info": "A crop cut for the taller shape a phone gives the banner. Left empty, the desktop picture is centre-cropped and loses about three fifths of its width."
    },
    {
      "type": "header",
      "content": "Per collection"
    },
    {
      "type": "paragraph",
      "content": "Use the collection File metafield custom.hero_cutout for transparent product photography. The banner metafields below apply to collections without approved cutouts."
    },
    {
      "type": "text",
      "id": "image_metafield",
      "label": "Banner metafield",
      "info": "The key under the custom namespace. Empty switches the metafield off.",
      "default": "hero_image"
    },
    {
      "type": "text",
      "id": "image_mobile_metafield",
      "label": "Mobile banner metafield",
      "default": "hero_image_mobile"
    },
    {
      "type": "checkbox",
      "id": "show_scrim",
      "label": "Lighten the photograph behind the words",
      "info": "Off is what the file draws. Turn it on where the collection's own picture is busy or dark under the heading.",
      "default": false
    },
    {
      "type": "range",
      "id": "scrim_opacity",
      "label": "How much",
      "min": 10,
      "max": 90,
      "step": 5,
      "unit": "%",
      "default": 60,
      "visible_if": "{{ section.settings.show_scrim }}"
    },
    {
      "type": "checkbox",
      "id": "show_star",
      "label": "Show the star",
      "default": true
    },
    {
      "type": "header",
      "content": "Breadcrumb"
    },
    {
      "type": "checkbox",
      "id": "show_breadcrumb",
      "label": "Show the breadcrumb",
      "default": true
    },
    {
      "type": "text",
      "id": "parent_title",
      "label": "Step between home and this page",
      "info": "Left empty, the trail runs straight from Home to the collection.",
      "default": "Shop Treats",
      "visible_if": "{{ section.settings.show_breadcrumb }}"
    },
    {
      "type": "url",
      "id": "parent_link",
      "label": "Where that step goes",
      "visible_if": "{{ section.settings.show_breadcrumb }}"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "range",
      "id": "height",
      "label": "Banner height",
      "info": "A floor. A longer sentence grows the banner rather than spilling out of it.",
      "min": 240,
      "max": 640,
      "step": 10,
      "unit": "px",
      "default": 380
    },
    {
      "type": "range",
      "id": "height_mobile",
      "label": "Banner height on mobile",
      "min": 180,
      "max": 480,
      "step": 10,
      "unit": "px",
      "default": 260
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 24
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Collection hero",
      "category": "t:categories.banners",
      "blocks": {
        "heading": {
          "type": "_ui-heading",
          "settings": {
            "heading": "<h1><em>Birthday</em> Treats</h1>",
            "heading_size": 48,
            "heading_size_mobile": 32
          }
        },
        "body": {
          "type": "_ui-text",
          "settings": {
            "text": "<p>A small spark of joy for their day. Birthday packs, custom photo treats, gift boxes, and choose-your-own options, all gift-ready on arrival.</p>",
            "text_size": 16,
            "text_size_mobile": 14
          }
        }
      },
      "block_order": [
        "heading",
        "body"
      ]
    }
  ]
}
{% endschema %}
