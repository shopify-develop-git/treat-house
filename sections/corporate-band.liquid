{% comment %}
  Direct email contact with a visible address and an optional inquiry-form link.
  The form remains usable when a visitor has no email app configured.
{% endcomment %}

{%- liquid
  assign band_label = section.settings.label
  assign band_link = section.settings.link
  assign link_protocol = band_link | split: ':' | first
  if link_protocol == 'mailto'
    assign email_address = band_link | remove_first: 'mailto:' | split: '?' | first
  endif
-%}

{%- if band_label != blank -%}
  <div
    class="section section--page-width spacing-style"
    style="{% render 'spacing-style', settings: section.settings %}"
    data-testid="corporate-band-{{ section.id }}"
    {{ section.shopify_attributes }}
  >
    <div class="corporate-band">
      {%- if band_link != blank -%}
        <a class="corporate-band__link" href="{{ band_link | escape }}">
          {{ band_label | escape }}
          {% if email_address != blank %}
            <span class="corporate-band__email">{{ email_address | escape }}</span>
          {%- endif -%}
        </a>
      {%- else -%}
        <span class="corporate-band__link">{{ band_label | escape }}</span>
      {%- endif -%}
      {%- if email_address != blank -%}
        <th-copy-email
          class="corporate-band__copy"
          data-email="{{ email_address | escape }}"
          data-success-message="{{ section.settings.copy_email_success | escape }}"
          data-fallback-message="{{ section.settings.copy_email_fallback | escape }}"
        >
          <button type="button" class="ui-button corporate-band__copy-button" data-copy-email hidden>
            {{ section.settings.copy_email_label | escape }}
          </button>
          <p class="corporate-band__copy-status" data-copy-status role="status" aria-live="polite"></p>
          <input
            class="corporate-band__copy-field"
            data-copy-field
            type="text"
            value="{{ email_address | escape }}"
            aria-label="{{ 'blocks.contact_form.email' | t }}"
            readonly
            hidden
          >
        </th-copy-email>
        <script type="module" src="{{ 'th-copy-email.js' | asset_url }}"></script>
      {%- endif -%}
      {%- if section.settings.form_link != blank -%}
        <a class="corporate-band__form" href="{{ section.settings.form_link | escape }}">Prefer a form? Tell us about your gift</a>
      {%- endif -%}
    </div>
  </div>
{%- endif -%}

{% stylesheet %}
  /*
   * Page width with a radius, not a full-bleed strip. The file draws the purple
   * starting at the same 80 the rest of the page starts at (535:22504 is the
   * 1280 inside the 1440 frame) and rounds it like the panels above and below
   * it — so the section sits in the `.section` grid and lets that place it,
   * rather than reaching the window edges and padding itself. The round is the
   * kit's small one, 2px, which is what 535:22504 carries — not the 20 the pale
   * panels elsewhere on the page take.
   */
  .corporate-band {
    display: flex;
    flex-direction: column;
    gap: 16px;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;

    /*
     * 32 above and below, and the gutter's own step across. The file draws 80
     * either side at 1440, which is the page margin at that width — so the band
     * takes `--ui-page-margin` and steps with the page instead of holding 80 down
     * to a phone, where it would leave a centred line almost no room.
     *
     * No min-height: the padding and the line make the drawn 90 on their own
     * (32 + 24 x 1.1 + 32), and a second source for one measurement is how the
     * two drift apart the first time either moves.
     */
    padding: 32px var(--ui-page-margin);
    border-radius: var(--ui-radius-sm);
    background-color: var(--ui-color-primary);
    text-align: center;
  }

  /*
   * The heading face, not the body one — the file sets this line in the page's
   * own heading type at the size a subheading takes. It is an invitation, and it
   * reads in the rest of the page's voice rather than like a footer link.
   *
   * Upright, and bold. It used to be `font-style: italic` at weight 400, which
   * was reading the face rather than the file: the heading font is a script and
   * already leans, so the italic was a second slant synthesised on top of it, and
   * 400 was a weight the theme does not load — the browser faked that too. The
   * file says Bold, 24, and nothing about a slant.
   */
  .corporate-band__link {
    color: var(--ui-color-white);
    font-family: var(--font-heading--family);
    font-size: 24px;
    font-weight: 700;
    line-height: 1.1;
    text-decoration: underline solid;
    text-decoration-thickness: from-font;
    text-underline-position: from-font;
  }

  a.corporate-band__link:hover {
    color: var(--ui-color-sky-blue);
  }

  .corporate-band__email {
    display: block;
    margin-top: 12px;
    font-family: var(--font-body--family);
    font-size: 18px;
    font-weight: 400;
    line-height: 1.5;
    overflow-wrap: anywhere;
  }

  .corporate-band__copy {
    display: grid;
    justify-items: center;
    gap: 12px;
    width: 100%;
    max-width: 420px;
    color: var(--ui-color-white);
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.5;
  }

  .corporate-band .corporate-band__copy-button {
    --ui-button-background: var(--ui-color-white);
    --ui-button-color: var(--ui-color-primary);
    --ui-button-border-color: var(--ui-color-white);
    --ui-button-border-width: 1px;
    --ui-button-font-size: 16px;
    min-height: 44px;
    max-width: 100%;
  }

  .corporate-band .corporate-band__copy-button:not(:disabled):hover {
    --ui-button-background: var(--ui-color-sky-blue);
    --ui-button-border-color: var(--ui-color-sky-blue);
  }

  .corporate-band .corporate-band__copy-button:focus-visible {
    outline: 2px solid var(--ui-color-white);
    outline-offset: 4px;
  }

  .corporate-band__copy-status {
    margin: 0;
  }

  .corporate-band__copy-status:empty {
    display: none;
  }

  .corporate-band__copy-field {
    box-sizing: border-box;
    width: 100%;
    min-width: 0;
    min-height: 44px;
    border: 1px solid var(--ui-color-white);
    border-radius: var(--ui-radius-sm);
    padding: 10px 12px;
    background: var(--ui-color-white);
    color: var(--ui-color-primary);
    font: inherit;
  }

  .corporate-band__copy [hidden] {
    display: none;
  }

  .corporate-band__form {
    color: var(--ui-color-white);
    font-family: var(--font-body--family);
    font-size: 16px;
    line-height: 1.5;
    padding-block: 10px;
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .corporate-band__form:hover {
    color: var(--ui-color-sky-blue);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Corporate band",
  "tag": "section",
  "settings": [
    {
      "type": "text",
      "id": "label",
      "label": "t:settings.text",
      "info": "Left empty, the band does not render.",
      "default": "Email our client and team gifts specialist."
    },
    {
      "type": "url",
      "id": "link",
      "label": "t:settings.link",
      "info": "A mailto: address works here."
    },
    {
      "type": "url",
      "id": "form_link",
      "label": "Inquiry form link",
      "info": "An alternative for customers who do not use an email app."
    },
    {
      "type": "text",
      "id": "copy_email_label",
      "label": "Copy email button label",
      "default": "Copy email address"
    },
    {
      "type": "text",
      "id": "copy_email_success",
      "label": "Email copied message",
      "default": "Email address copied."
    },
    {
      "type": "text",
      "id": "copy_email_fallback",
      "label": "Manual copy message",
      "default": "Select and copy the email address below."
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 0
    }
  ],
  "presets": [
    {
      "name": "Corporate band"
    }
  ]
}
{% endschema %}
