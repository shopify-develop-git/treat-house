{% comment %}
  Request a Corporate Gifting Quote (Figma: 508:12153, and 508:12683 for the state
  after it is sent).

  Two states in one section, because they are two states of one thing rather than
  two sections a merchant has to remember to swap: the form, and the panel that
  replaces it once the request is in. Shopify decides which, not a setting and not
  a script — `{% form 'contact' %}` posts to the shop, redirects back with
  `?contact_posted=true`, and `form.posted_successfully?` is true on that render.
  So the confirmation survives a reload, works with JavaScript off, and cannot be
  reached by anyone who has not actually sent anything.

  The fields are a fixed composition rather than a merchant's list — the layout is
  drawn around two columns of them and a quote needs the answers it needs — so
  they are the section's, with their labels as the file writes them: Name, Email,
  Company, Phone, Number of gifts, Budget range, Requested delivery date,
  Customization, Delivery location, Notes. Every `contact[Label]` field is echoed
  into Shopify's notification email as a "Label: value" line, and a hidden
  `contact[Inquiry type]` marks the mail as corporate so it can be told apart
  from the general contact page, which posts to the same inbox.

  What a merchant does change is exposed: the budget ranges and customization
  options on offer, the helper lines under the quantity and date fields, and
  every word of the confirmation, which is blocks.

  The whole form lives in a 630 column centred in the page, which is half the
  1280 content width. That is narrow on purpose: a quote form with its fields
  stretched over a desktop's full width reads as a chore.
{% endcomment %}

{%- liquid
  assign budget_ranges = section.settings.budget_ranges | default: 'Under $500, $500-$1000, $1000-$2500, $2500-$5000, $5000+, Not sure yet'
  assign customization_options = section.settings.customization_options | default: 'Logo treats, Custom colors or theme, Printed photo, Gift message, Not sure yet'
  assign quantity_hint = section.settings.quantity_hint
  assign date_min_days = section.settings.date_min_days | default: 3
  # The note under the date field follows the earliest-date setting unless the
  # merchant writes their own, so the two cannot drift apart.
  assign date_hint = section.settings.date_hint
  if date_hint == blank
    if date_min_days == 1
      assign date_hint = 'Optional. Dates open from 1 day out.'
    elsif date_min_days > 1
      assign date_hint = 'Optional. Dates open from ' | append: date_min_days | append: ' days out.'
    else
      assign date_hint = 'Optional.'
    endif
  endif
  assign submit_label = section.settings.submit_label | default: 'Submit inquiry'
-%}

<div
  class="section section--page-width spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="corporate-quote-form-{{ section.id }}"
  data-corporate-quote
  {{ section.shopify_attributes }}
>
  {%- form 'contact', class: 'corporate-quote' -%}
    {%- if form.posted_successfully? -%}
      <div class="corporate-quote__confirmation" data-corporate-quote-sent tabindex="-1">
        <span class="corporate-quote__sparkle" aria-hidden="true">
          {{- 'icon-ui-sparkle.svg' | inline_asset_content -}}
        </span>

        <div class="corporate-quote__confirmation-content">
          {% content_for 'block', type: '_ui-heading', id: 'success-heading' %}
          {% content_for 'block', type: '_ui-text', id: 'success-copy' %}
          {% content_for 'block', type: '_ui-link-row', id: 'success-buttons' %}
        </div>
      </div>
    {%- else -%}
      {% content_for 'blocks' %}

      {%- comment -%}
        Shopify reports a failed post through `form.errors`, and the only field it
        validates itself is the email. Its message is put on that field so the
        error lands where the fix is, rather than in a banner above a form the
        visitor then has to search. A short live line above the grid still names
        the problem, so a screen reader hears it without hunting for the field.
      {%- endcomment -%}
      {%- liquid
        assign email_error = blank
        if form.errors
          assign email_error = form.errors.messages.email | default: form.errors.messages.form
        endif
      -%}

      {%- if form.errors -%}
        <p class="corporate-quote__alert" role="alert" data-corporate-quote-error>
          Your inquiry was not sent. Please check the highlighted field and try again.
        </p>
      {%- endif -%}

      <p class="corporate-quote__required-note">* Required</p>

      <input type="hidden" name="contact[Inquiry type]" value="Corporate gifting">

      <div class="corporate-quote__grid">
        {% render 'ui-input',
          label: 'Name',
          name: 'contact[name]',
          value: form.name,
          required: true,
          attributes: 'autocomplete="name"'
        %}

        {% render 'ui-input',
          label: 'Email',
          type: 'email',
          name: 'contact[email]',
          value: form.email,
          error: email_error,
          required: true,
          attributes: 'autocomplete="email"'
        %}

        {% render 'ui-input',
          label: 'Company',
          name: 'contact[Company]',
          attributes: 'autocomplete="organization"'
        %}

        {% render 'ui-input',
          label: 'Phone',
          type: 'tel',
          name: 'contact[Phone]',
          attributes: 'autocomplete="tel"'
        %}

        {% render 'ui-input',
          label: 'Number of gifts',
          type: 'number',
          name: 'contact[Number of gifts]',
          hint: quantity_hint,
          required: true,
          attributes: 'min="1" step="1" inputmode="numeric"'
        %}

        {% render 'ui-select',
          label: 'Budget range',
          name: 'contact[Budget range]',
          placeholder: 'Select a range...',
          options: budget_ranges
        %}

        {%- capture date_attributes -%}
          data-corporate-quote-date data-min-days="{{ date_min_days }}"
        {%- endcapture -%}
        {% render 'ui-input',
          label: 'Requested delivery date',
          type: 'date',
          name: 'contact[Requested delivery date]',
          hint: date_hint,
          class: 'corporate-quote__date',
          attributes: date_attributes
        %}

        {% render 'ui-select',
          label: 'Customization',
          name: 'contact[Customization]',
          placeholder: 'Select an option...',
          options: customization_options
        %}

        <div class="corporate-quote__wide">
          {% render 'ui-input',
            label: 'Delivery location',
            name: 'contact[Delivery location]',
            placeholder: "City and state, or 'multiple addresses'"
          %}
        </div>

        <div class="corporate-quote__wide">
          {% render 'ui-input',
            label: 'Notes',
            textarea: true,
            rows: '5',
            name: 'contact[body]',
            value: form.body,
            placeholder: section.settings.notes_placeholder
          %}
        </div>

        {%- comment -%}
          One order going to forty desks is the corporate case, and Shopify's cart
          carries one address. The list travels beside the order instead: a
          spreadsheet with a row per recipient, which is what the shop already
          hands its corporate customers by hand.

          A link, not a file field. `{% form 'contact' %}` posts no attachment, so
          a box that looked like it took one would swallow the document in
          silence — [ui-upload-field] documents that trap and offers `link` for
          exactly this. The filled sheet comes back on the reply to the quote,
          which is a conversation that has already started by then.

          Rendered only when there is a file to reach. A dashed panel pointing
          nowhere is worse than no panel.
        {%- endcomment -%}
        {%- if section.settings.shipping_template_url != blank -%}
          <div class="corporate-quote__wide corporate-quote__template">
            <div class="corporate-quote__template-copy">
              <p class="corporate-quote__template-title">
                <span class="corporate-quote__template-icon" aria-hidden="true">
                  {{- 'icon-ui-shipping-fast.svg' | inline_asset_content -}}
                </span>
                Shipping to several addresses?
              </p>
              {%- if section.settings.shipping_template_hint != blank -%}
                <p class="corporate-quote__template-note">{{ section.settings.shipping_template_hint }}</p>
              {%- endif -%}
            </div>

            {% render 'ui-button',
              variant: 'secondary',
              label: section.settings.shipping_template_prompt,
              link: section.settings.shipping_template_url,
              class: 'corporate-quote__template-button'
            %}
          </div>
        {%- endif -%}
      </div>

      {%- comment -%}
        The kit's own button, not a `<button>` wearing its class names. Hand-rolled,
        it was `width: fit-content` and `margin: 0` — the snippet's own rules, which
        a section stylesheet of the same weight loses to on order alone, so the
        button came out 163 wide against the 630 the file draws and sat flush under
        the notes field. `full_width` is the switch that answers it.
      {%- endcomment -%}
      {% render 'ui-button',
        variant: 'primary',
        label: submit_label,
        type: 'submit',
        full_width: true,
        class: 'corporate-quote__submit'
      %}
    {%- endif -%}
  {%- endform -%}
</div>

<script>
  /*
   * Two small jobs, both progressive: the form posts and confirms without a
   * line of this running.
   *
   * 1. The delivery date's `min` is today plus the lead time the section sets
   *    (3 days by default). A server cannot know the visitor's today, so the
   *    floor is written here, in local time, and a value below it is cleared.
   * 2. Shopify redirects back to the top of the page after a post. On a page
   *    where the form is the last section, that leaves both the error and the
   *    confirmation off screen — so on either render the form is scrolled into
   *    view and the first invalid field, or the confirmation panel, is focused.
   */
  (function () {
    var root = document.querySelector('[data-corporate-quote]');
    if (!root) return;

    var dateInputs = root.querySelectorAll('[data-corporate-quote-date]');
    for (var i = 0; i < dateInputs.length; i++) {
      var input = dateInputs[i];
      var days = parseInt(input.getAttribute('data-min-days'), 10);
      if (isNaN(days) || days < 0) days = 0;
      var floor = new Date();
      floor.setHours(0, 0, 0, 0);
      floor.setDate(floor.getDate() + days);
      var pad = function (n) { return (n < 10 ? '0' : '') + n; };
      var min = floor.getFullYear() + '-' + pad(floor.getMonth() + 1) + '-' + pad(floor.getDate());
      input.setAttribute('min', min);
      if (input.value && input.value < min) input.value = '';
    }

    var sent = root.querySelector('[data-corporate-quote-sent]');
    var errored = root.querySelector('[data-corporate-quote-error]');
    var posted = /[?&]contact_posted=true/.test(window.location.search);
    if (!sent && !errored && !posted) return;

    var form = root.querySelector('form');
    var target = sent || root.querySelector('[aria-invalid="true"]') || form;
    if (!target) return;

    window.requestAnimationFrame(function () {
      (form || target).scrollIntoView({ block: 'start' });
      try {
        target.focus({ preventScroll: true });
      } catch (e) {
        target.focus();
      }
    });
  })();
</script>

{% stylesheet %}
  /*
   * 630 centred, whatever the page is doing around it. The section sits in the
   * `.section` grid, which already places it in the central column, so this only
   * has to narrow that column rather than pad itself — see the page geometry note
   * in CLAUDE.md.
   */
  .corporate-quote {
    box-sizing: border-box;
    width: 100%;
    max-width: 630px;
    margin-inline: auto;

    /*
     * The hero's "Send an inquiry" points at this form's own id, which Shopify
     * writes as `contact_form`. The header stays on the screen as the page
     * scrolls, so the landing has to start below it — its height plus enough air
     * for the heading to read as a heading rather than as a line jammed under the
     * navigation.
     */
    scroll-margin-block-start: calc(var(--header-height, 60px) + 40px);
  }

  /* The file leaves 48 between the heading and the first row of fields. */
  .corporate-quote > :is(.ui-heading, h1, h2, h3) {
    margin-block: 0 48px;
    text-align: center;
  }

  /* The heading's 48 is shared with the two short lines that can sit under it. */
  .corporate-quote > :is(.ui-heading, h1, h2, h3):has(+ .corporate-quote__alert),
  .corporate-quote > :is(.ui-heading, h1, h2, h3):has(+ .corporate-quote__required-note) {
    margin-block-end: 24px;
  }

  .corporate-quote__alert {
    margin: 0 0 16px;
    padding: 12px 16px;
    border: 1px solid var(--ui-color-error);
    border-radius: var(--ui-radius-sm);
    color: var(--ui-color-error);
    font-size: 14px;
    line-height: 1.4;
  }

  .corporate-quote__required-note {
    margin: 0 0 16px;
    font-family: var(--ui-font-accent);
    font-size: 12px;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--ui-color-gray);
  }

  /*
   * Required fields carry a star after the label. It comes from the control's own
   * `required`, so the mark and the rule cannot drift apart. The star is styled
   * text: screen readers already announce the control as required.
   */
  .corporate-quote :is(.ui-input, .ui-select):has([required]) > :is(.ui-input__label, .ui-select__label)::after {
    content: ' *';
    color: var(--ui-color-error);
  }

  /*
   * Two columns of 305 with a 20 gutter is exactly 630, so the columns are
   * written as fractions and the gutter as the gap — the same pair of numbers,
   * without a width that stops being true the moment the container moves.
   *
   * `align-items: start` because a field carrying a hint line is 20px taller
   * than the one beside it. Stretched, the shorter field would grow a gap under
   * its own box and the two controls would stop lining up.
   */
  /*
   * The panel that hands over the shipping template. Copy on the left, the action
   * on the right — the same shape the cart's gift note and the product page's gift
   * message card already use, so a visitor meets one pattern three times rather
   * than three patterns once.
   *
   * It replaced a dashed [ui-upload-field]. That component is the zone a file is
   * dropped *into*; wearing it, a link out read as a box waiting to be filled and
   * nobody could tell it was a button. The component was right for the wholesale
   * form it was drawn for and wrong here, which is a thing worth writing down.
   */
  .corporate-quote__template {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 20px;
    box-sizing: border-box;
    padding: 16px 20px;
    border-radius: var(--ui-radius-sm);
    background-color: var(--ui-color-light-blue);
  }

  .corporate-quote__template-copy {
    display: flex;
    flex-direction: column;
    gap: 4px;
    min-width: 0;
  }

  .corporate-quote__template-title {
    display: flex;
    align-items: center;
    gap: 6px;
    margin: 0;
    color: var(--ui-color-primary);
    font-family: var(--ui-font-accent);
    font-size: 12px;
    font-weight: var(--font-accent--weight-semibold, 600);
    line-height: 1.35;
    text-transform: uppercase;
  }

  .corporate-quote__template-icon {
    display: block;
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
  }

  .corporate-quote__template-icon > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .corporate-quote__template-note {
    margin: 0;
    color: var(--ui-color-black);
    font-family: var(--ui-font-body);
    font-size: 13px;
    font-weight: var(--ui-font-body-weight);
    line-height: 1.3;
  }

  /*
   * An action beside a sentence, not a column that shrinks with it. Weighed one
   * class heavier than `.ui-button`, whose own `width: fit-content` a section
   * stylesheet of equal weight loses to on order alone — the same trap the submit
   * button's comment above documents.
   */
  .corporate-quote .corporate-quote__template-button {
    flex: 0 0 auto;
    white-space: nowrap;
  }

  /* Side by side needs room for both. Below 600 the sentence takes the width and
     the button goes under it, full width, where a thumb can reach it. */
  @media screen and (max-width: 599px) {
    .corporate-quote__template {
      flex-direction: column;
      align-items: stretch;
    }

    .corporate-quote .corporate-quote__template-button {
      width: 100%;
    }
  }

  .corporate-quote__grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    align-items: start;
    column-gap: 20px;
    row-gap: 16px;
  }

  .corporate-quote__wide {
    grid-column: 1 / -1;
  }

  /*
   * A native date control, drawn as the kit's field. Browsers give it their own
   * chrome and an intrinsic width; both are taken off so it sits at the height
   * and width of the text field beside it.
   */
  .corporate-quote .corporate-quote__date .ui-input__control {
    -webkit-appearance: none;
    appearance: none;
    min-width: 0;
  }

  .corporate-quote .corporate-quote__date .ui-input__control::-webkit-date-and-time-value {
    text-align: start;
  }

  /*
   * One column on a phone. The 630 column itself needs no middle tier — from
   * 750px up the content column is at least 670 wide, so the form is already at
   * the size the file draws — but two 305px fields do not fit a 390px screen.
   */
  @media screen and (max-width: 749px) {
    .corporate-quote__grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  /* The file leaves 48 between the last field and the button, which runs full width. */
  /*
   * Weighed one class heavier than `.ui-button`, whose `margin: 0` is declared in
   * the snippet's own stylesheet and wins on order against a lone class here. The
   * width is the snippet's `full_width` rather than a figure of ours.
   */
  .corporate-quote .corporate-quote__submit {
    margin-block-start: 48px;
  }

  /* ---------- Sent ---------- */

  /*
   * The same tinted panel the hero opens the page with, so the page closes on the
   * shape it started on. Centred throughout: the file gives this one no left edge
   * to hang from.
   */
  .corporate-quote__confirmation {
    display: flex;
    flex-direction: column;
    align-items: center;
    box-sizing: border-box;
    padding: 32px 24px 48px;
    /* 20, the figure the file draws. It was `var(--ui-radius-lg, 16px)` and there is
       no such token in the kit, so it had been quietly resolving to the fallback. */
    border-radius: 20px;
    background-color: var(--ui-color-light-blue);
    text-align: center;
  }

  .corporate-quote__confirmation:focus {
    outline: none;
  }

  .corporate-quote__sparkle {
    display: block;
    width: 32px;
    height: 32px;
    color: var(--ui-color-primary);
  }

  .corporate-quote__sparkle > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  /* The panel declares no gap, so this is the whole of the 48 the file leaves
     between the star and the heading. */
  .corporate-quote__confirmation-content {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    margin-block-start: 48px;
    width: 100%;
  }

  .corporate-quote__confirmation-content > :is(.ui-heading, h1, h2, h3) {
    margin: 0;
  }

  /* The copy is drawn at 445 inside the 630 panel, so it wraps to the three lines
     the file shows rather than running the full width. */
  .corporate-quote__confirmation-content > :is(.ui-text, p) {
    margin: 0;
    max-width: 445px;
  }

  /* The file leaves 48 between the copy and the pair of buttons: the column's own
     16 and 32 more here. */
  .corporate-quote__confirmation-content > .ui-link-row {
    margin-block-start: 32px;
  }

  @media screen and (max-width: 749px) {
    .corporate-quote__confirmation {
      padding-inline: 16px;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Corporate quote form",
  "tag": "section",
  "blocks": [{ "type": "_ui-heading" }, { "type": "_ui-text" }, { "type": "_ui-link-row" }],
  "settings": [
    {
      "type": "text",
      "id": "budget_ranges",
      "label": "Budget ranges",
      "info": "Comma separated, so write 1000 rather than 1,000. These are the options in the budget range field.",
      "default": "Under $500, $500-$1000, $1000-$2500, $2500-$5000, $5000+, Not sure yet"
    },
    {
      "type": "text",
      "id": "customization_options",
      "label": "Customization options",
      "info": "Comma separated. These are the options in the customization field.",
      "default": "Logo treats, Custom colors or theme, Printed photo, Gift message, Not sure yet"
    },
    {
      "type": "text",
      "id": "quantity_hint",
      "label": "Note under the number of gifts field",
      "default": "A rough number is fine."
    },
    {
      "type": "text",
      "id": "date_hint",
      "label": "Note under the delivery date field",
      "info": "Left empty, the note follows the earliest delivery date setting below."
    },
    {
      "type": "range",
      "id": "date_min_days",
      "label": "Earliest delivery date, days from today",
      "min": 0,
      "max": 30,
      "step": 1,
      "default": 3
    },
    {
      "type": "text",
      "id": "notes_placeholder",
      "label": "Notes field placeholder",
      "default": "Who is it for, and what would make it feel personal?"
    },
    {
      "type": "text",
      "id": "submit_label",
      "label": "Submit button",
      "default": "Send a note to our team"
    },
    {
      "type": "header",
      "content": "Shipping template"
    },
    {
      "type": "paragraph",
      "content": "For orders going to more than one address. Upload the spreadsheet under Content \u2192 Files, then paste its link here. Left empty, the panel does not render."
    },
    {
      "type": "url",
      "id": "shipping_template_url",
      "label": "Template file"
    },
    {
      "type": "text",
      "id": "shipping_template_prompt",
      "label": "Panel text",
      "default": "Download template",
      "visible_if": "{{ section.settings.shipping_template_url != blank }}"
    },
    {
      "type": "text",
      "id": "shipping_template_hint",
      "label": "Helper line",
      "info": "Under the panel text. Say what to do with the file once it is filled.",
      "default": "One row per recipient. Send it back with your reply and we ship each gift separately.",
      "visible_if": "{{ section.settings.shipping_template_url != blank }}"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Corporate quote form",
      "blocks": {
        "heading": {
          "type": "_ui-heading",
          "settings": {
            "heading": "<h2>Tell us about <em>your gift</em></h2>"
          }
        },
        "success-heading": {
          "type": "_ui-heading",
          "static": true,
          "settings": {
            "heading": "<h2><em>Thanks.</em><br> We have your note and will be in touch.</h2>"
          }
        },
        "success-copy": {
          "type": "_ui-text",
          "static": true,
          "settings": {
            "text": "<p>A real person will read it and reply by email.</p>"
          }
        },
        "success-buttons": {
          "type": "_ui-link-row",
          "static": true,
          "blocks": {
            "primary": {
              "type": "_ui-link",
              "settings": { "label": "Shop treats", "variant": "primary" }
            },
            "secondary": {
              "type": "_ui-link",
              "settings": { "label": "Return home", "variant": "secondary" }
            }
          },
          "block_order": ["primary", "secondary"]
        }
      },
      "block_order": ["heading"]
    }
  ]
}
{% endschema %}
