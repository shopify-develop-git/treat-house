{%- comment -%}
  Layout-free Section Rendering endpoint. Never include this section in a page
  template: its full batch belongs to the catalog enhancement, not the initial
  document's native collection_viewed event. It uses shared retail/card rules;
  the configured main section keeps layout, sorting and visibility settings.
{%- endcomment -%}
{%- comment -%}
  Section Rendering skips the page layout. Check access to the collection itself
  before returning cards, counts or analytics; product transparency alone does
  not enforce a collection's passcode requirement.
{%- endcomment -%}
{%- capture collection_access -%}
  {%- render 'locksmith-variables', scope: 'subject', subject: collection, variable: 'access_granted' -%}
{%- endcapture -%}
{%- if collection_access == 'true' -%}
{%- paginate collection.products by 250 -%}
  {% render 'collection-products-source', mode: 'batch', collection: collection, section: section, paginate: paginate %}
{%- endpaginate -%}
{%- else -%}
  <template data-collection-access-denied></template>
{%- endif -%}

{% schema %}
{
  "name": "Collection data endpoint",
  "settings": []
}
{% endschema %}
