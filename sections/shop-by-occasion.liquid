{% comment %}
  Shop by Occasion — a titled grid of collections (Figma: Shop by Occasion,
  desktop and mobile).

  The section owns the grid and which collections fill it. The title, and
  anything a merchant wants to stand above the tiles with it, are blocks — so a
  second page can open the same grid with a different line. See
  `docs/section-settings.md`.

  Each tile is ui-collection-card from the kit, which is why there is so little
  CSS here.

  The kit card is already responsive on its own — 171x220 on mobile, 305x263 above
  750px — so the grid sets column counts and gaps and lets the card size itself.

  Three column counts rather than two. The file draws only the ends, two columns at
  390px and four at 1440px, and running four all the way down squeezes a card to
  245px at 1200px and 128px at 750px against the 305px it is drawn at. The middle
  tier holds three between 750px and 1200px, which keeps a card between 183px and
  333px there.

  With no collections picked the section falls back to the eight occasions the file
  draws, so it is worth looking at in the editor before a merchant has chosen
  anything. Those placeholders carry no images by design; the card renders Shopify's
  own placeholder in the media box.
{% endcomment %}

{%- liquid
  assign chosen = section.settings.collections
  assign card_limit = section.settings.max_collections

  assign onboarding_titles = 'Birthday,Graduation,Baby Shower,Congratulations,Deluxe Gift Boxes,Pride,Patriotic,World Cup' | split: ','
-%}

<div class="section-background color-{{ section.settings.color_scheme }} shop-by-occasion-bg--{{ section.settings.background }}"></div>
<div
  class="section section--{{ section.settings.section_width }} spacing-style color-{{ section.settings.color_scheme }}"
  style="{% render 'spacing-style', settings: section.settings %}"
  data-testid="shop-by-occasion-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div
    class="shop-by-occasion shop-by-occasion--{{ section.settings.heading_alignment }}"
    style="--shop-by-occasion-columns: {{ section.settings.columns }}; --shop-by-occasion-columns-tablet: {{ section.settings.tablet_columns }}; --shop-by-occasion-columns-mobile: {{ section.settings.mobile_columns }};"
  >
    <div class="shop-by-occasion__content">
      {% content_for 'blocks' %}
    </div>

    <ul class="shop-by-occasion__grid" role="list">
      {%- if chosen.size > 0 -%}
        {%- for collection in chosen limit: card_limit -%}
          {%- liquid
            assign card_copy = section.settings.description
            if card_copy == blank
              assign card_copy = collection.description | strip_html | truncatewords: 14
            endif
          -%}
          <li class="shop-by-occasion__item">
            {% render 'ui-collection-card',
              title: collection.title,
              description: card_copy,
              image: collection.featured_image,
              link: collection.url
            %}
          </li>
        {%- endfor -%}
      {%- else -%}
        {%- for placeholder_title in onboarding_titles limit: card_limit -%}
          <li class="shop-by-occasion__item">
            {% render 'ui-collection-card',
              title: placeholder_title,
              description: section.settings.description
            %}
          </li>
        {%- endfor -%}
      {%- endif -%}
    </ul>
  </div>
</div>

{% stylesheet %}
  /* The tint goes on .section-background: Horizon forces .section itself transparent
     from base.css at four classes of specificity, so painting the section loses
     silently. Compounded so it also outranks the colour scheme's own background. */
  .section-background.shop-by-occasion-bg--light-blue {
    background-color: var(--ui-color-light-blue);
  }

  .section-background.shop-by-occasion-bg--white {
    background-color: var(--ui-color-white);
  }

  .shop-by-occasion {
    display: flex;
    flex-direction: column;

    /* The file leaves 32px under the title on mobile and 48px on desktop. */
    gap: 32px;
  }

  /*
   * The blocks standing above the grid. The heading block sizes itself; what the
   * section decides is where the column sits and how its parts are spaced.
   */
  .shop-by-occasion__content {
    display: flex;
    flex-direction: column;
    gap: 16px;
  }

  .shop-by-occasion--center .shop-by-occasion__content {
    align-items: center;
    text-align: center;
  }

  .shop-by-occasion--start .shop-by-occasion__content {
    align-items: flex-start;
    text-align: start;
  }

  .shop-by-occasion__grid {
    display: grid;

    /* minmax(0, 1fr) rather than 1fr: a long collection title would otherwise set a
       column's minimum width and pull the track wider than its share. */
    grid-template-columns: repeat(var(--shop-by-occasion-columns-mobile, 2), minmax(0, 1fr));
    gap: 16px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  /* Cards stretch to the tallest in the row, and the card gives the slack to its
     media box rather than to the copy. */
  .shop-by-occasion__item {
    display: flex;
  }

  @media screen and (min-width: 750px) {
    .shop-by-occasion {
      gap: 48px;
    }

    .shop-by-occasion__grid {
      grid-template-columns: repeat(var(--shop-by-occasion-columns-tablet, 3), minmax(0, 1fr));
      gap: 20px;
    }
  }

  /* Four columns only once they stop crowding: at 1200px they are already down to
     245px against the 305px drawn, and the card is wearing its desktop type by then. */
  @media screen and (min-width: 1200px) {
    .shop-by-occasion__grid {
      grid-template-columns: repeat(var(--shop-by-occasion-columns, 4), minmax(0, 1fr));
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Shop by Occasion",
  "tag": "section",
  "settings": [
    {
      "type": "header",
      "content": "Collections"
    },
    {
      "type": "collection_list",
      "id": "collections",
      "label": "Collections",
      "limit": 12
    },
    {
      "type": "range",
      "id": "max_collections",
      "label": "Cards to show",
      "min": 2,
      "max": 12,
      "step": 1,
      "default": 8
    },
    {
      "type": "text",
      "id": "description",
      "label": "Card description",
      "info": "Shown under every card. Leave empty to use each collection's own description.",
      "default": "Custom treats for the moment people actually remember."
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "heading_alignment",
      "label": "Content alignment",
      "options": [
        {
          "value": "center",
          "label": "Centred"
        },
        {
          "value": "start",
          "label": "Left"
        }
      ],
      "default": "center",
      "info": "Where the title and anything with it sit above the grid."
    },
    {
      "type": "range",
      "id": "columns",
      "label": "Columns on desktop",
      "min": 2,
      "max": 5,
      "step": 1,
      "default": 4
    },
    {
      "type": "range",
      "id": "tablet_columns",
      "label": "Columns on tablet",
      "info": "Between 750px and 1200px wide.",
      "min": 2,
      "max": 4,
      "step": 1,
      "default": 3
    },
    {
      "type": "select",
      "id": "mobile_columns",
      "label": "Columns on mobile",
      "options": [
        {
          "value": "1",
          "label": "1"
        },
        {
          "value": "2",
          "label": "2"
        }
      ],
      "default": "2"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "select",
      "id": "background",
      "label": "Background",
      "options": [
        {
          "value": "none",
          "label": "Colour scheme"
        },
        {
          "value": "light-blue",
          "label": "Light blue"
        },
        {
          "value": "white",
          "label": "White"
        }
      ],
      "default": "none"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom",
      "min": 0,
      "max": 100,
      "step": 1,
      "unit": "px",
      "default": 80
    }
  ],
  "presets": [
    {
      "name": "Shop by Occasion",
      "category": "t:categories.collections",
      "blocks": {
        "heading": {
          "type": "_ui-heading",
          "settings": {
            "heading": "<h2>Shop by <em>Occasion</em></h2>"
          }
        }
      },
      "block_order": [
        "heading"
      ]
    }
  ],
  "blocks": [
    {
      "type": "_ui-heading"
    },
    {
      "type": "_ui-text"
    },
    {
      "type": "_ui-link"
    }
  ]
}
{% endschema %}
