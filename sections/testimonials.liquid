{% comment %}
  Customer reviews stay within the centered page column. The carousel shows
  three complete cards on desktop, two on tablet and one on mobile. Its kit
  arrows remain visible at every width; full quotes expand within their cards.
{% endcomment %}

{%- liquid
  # `section.blocks` is the merchant's list of review cards, and only that — the
  # heading and the rating line are static and never appear in it. What is not
  # available is anything inside them: a theme block reaches a section as `@theme`
  # carrying neither its type nor its settings, so the test that used to stand here
  # — `block.type == '_ui-testimonial'`, and a look at that block's `quote` —
  # matched nothing and left the count at zero. The section then called itself
  # single whatever it held, which pinned the carousel to the first card and hid
  # the rest behind `overflow-x: hidden`. With one review in the list that looked
  # exactly right, so it survived until there were five.
  #
  # The size is what is left to count, and it is the right number: the schema
  # admits no other block here. A card the merchant has added but not yet written
  # counts towards it — that is a scroll onto an empty card in the editor, and
  # nothing at all on a live page, since [_ui-testimonial] draws no card without a
  # quote.
  assign testimonial_count = section.blocks.size
-%}

<div
  class="testimonials color-{{ section.settings.color_scheme }}{% if testimonial_count < 2 %} testimonials--single{% endif %}"
  style="
    --testimonials-block-padding: {{ section.settings.vertical_padding_mobile }}px;
    --testimonials-block-padding-desktop: {{ section.settings.vertical_padding }}px;
  "
  data-testid="testimonials-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="testimonials__header">
    {% content_for 'block', type: '_ui-heading', id: 'heading' %}
    {%- if section.settings.show_rating -%}
      {% content_for 'block', type: '_ui-review-line', id: 'rating' %}
    {%- endif -%}
  </div>

  <ui-carousel class="testimonials__viewport" role="region" aria-roledescription="carousel" aria-label="Customer reviews">
    <div class="testimonials__track" data-carousel-track tabindex="0" aria-label="Scroll customer reviews">
      {% content_for 'blocks' %}
    </div>

    {%- if testimonial_count > 1 -%}
      <div class="testimonials__controls">
        {% render 'ui-pagination-arrow',
          direction: 'left',
          label: 'Previous reviews',
          class: 'testimonials__arrow',
          attributes: 'data-carousel-prev'
        %}
        <span class="testimonials__controls-label">Browse reviews</span>
        {% render 'ui-pagination-arrow',
          direction: 'right',
          label: 'Next reviews',
          class: 'testimonials__arrow',
          attributes: 'data-carousel-next'
        %}
      </div>
    {%- endif -%}
  </ui-carousel>
</div>

{% render 'ui-carousel' %}
<script src="{{ 'ui-testimonial.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  .testimonials {
    --testimonials-columns: 1;
    --testimonials-gap: 16px;
    --ui-carousel-start: 1;

    display: flex;
    flex-direction: column;
    gap: 32px;
    min-width: 0;
    padding-block: var(--testimonials-block-padding, 64px);
  }

  .testimonials__header,
  .testimonials__viewport {
    box-sizing: border-box;
    width: min(
      var(--page-content-width, 1280px),
      calc(100% - var(--page-margin, var(--ui-page-margin)) * 2)
    );
    min-width: 0;
    margin-inline: auto;
  }

  .testimonials__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    text-align: center;
  }

  .testimonials__viewport {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 24px;
  }

  .testimonials__track {
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: calc(
      (100% - (var(--testimonials-columns) - 1) * var(--testimonials-gap)) /
        var(--testimonials-columns)
    );
    align-items: start;
    gap: var(--testimonials-gap);
    min-width: 0;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;
  }

  .testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .testimonials__track > * {
    min-width: 0;
    scroll-snap-align: start;
  }

  .testimonials__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  .testimonials__controls-label {
    font-family: var(--ui-font-body);
    font-size: 14px;
    color: var(--ui-color-primary);
  }

  .testimonials__track:focus-visible {
    outline: 2px solid var(--ui-color-primary);
    outline-offset: 4px;
  }

  @media screen and (min-width: 750px) {
    .testimonials {
      --testimonials-columns: 2;
      --testimonials-gap: 20px;

      gap: 40px;
      padding-block: var(--testimonials-block-padding-desktop, 80px);
    }
  }

  @media screen and (min-width: 1200px) {
    .testimonials {
      --testimonials-columns: 3;
    }
  }

  .testimonials--single {
    --testimonials-columns: 1;
  }

  .testimonials--single .testimonials__viewport {
    max-width: 420px;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "blocks": [{ "type": "_ui-testimonial" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show the rating line under the heading",
      "info": "Off by default. The manual rating and review count are unverified; switch on only with real figures.",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "vertical_padding_mobile",
      "label": "t:content.mobile_size",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": {
        "heading": {
          "type": "_ui-heading",
          "static": true,
          "settings": { "heading": "<h2>What <em>customers say</em></h2>", "max_width": 520 }
        },
        "rating": {
          "type": "_ui-review-line",
          "static": true,
          "settings": { "layout": "inline", "rating_text": "", "reviews_text": "", "text_size": 16, "text_size_mobile": 14 }
        },
        "one": { "type": "_ui-testimonial" }
      },
      "block_order": ["one"]
    }
  ]
}
{% endschema %}
