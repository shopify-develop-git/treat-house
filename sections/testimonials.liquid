{% comment %}
  Testimonials (Figma: Testimonials, desktop and mobile).

  A heading with a rating line under it, and a row of review cards that runs past
  both edges of the page. The reviews are the merchant's list, so they are the
  section's block region; the heading and the rating line sit above it and never
  move, so they are static blocks.

  The row is a carousel at every width — the file draws it mid-scroll on both, with
  cards cut off at the edges. Cards keep the width they are drawn at rather than
  dividing the container, which is why the row overflows: three and a bit of them
  at 1440, one and two halves on a phone.

  Where a card lands differs, though. On a phone it centres, so the neighbours peek
  evenly; on a wide screen it lines up with the page column, so the row starts where
  the heading does.

  Controls show on the phone layout only, which is what the file draws — a wide row
  says it scrolls by cutting a card at the edge.
{% endcomment %}

{%- liquid
  # `section.blocks` is the merchant's list of review cards, and only that — the
  # heading and the rating line are static and never appear in it. What is not
  # available is anything inside them: a theme block reaches a section as `@theme`
  # carrying neither its type nor its settings, so the test that used to stand here
  # — `block.type == '_ui-testimonial'`, and a look at that block's `quote` —
  # matched nothing and left the count at zero. The section then called itself
  # single whatever it held, which pinned the carousel to the first card and hid
  # the rest behind `overflow-x: hidden`. With one review in the list that looked
  # exactly right, so it survived until there were five.
  #
  # The size is what is left to count, and it is the right number: the schema
  # admits no other block here. A card the merchant has added but not yet written
  # counts towards it — that is a scroll onto an empty card in the editor, and
  # nothing at all on a live page, since [_ui-testimonial] draws no card without a
  # quote.
  assign testimonial_count = section.blocks.size
-%}

<div
  class="testimonials color-{{ section.settings.color_scheme }}{% if testimonial_count < 2 %} testimonials--single{% endif %}"
  style="
    --testimonials-block-padding: {{ section.settings.vertical_padding_mobile }}px;
    --testimonials-block-padding-desktop: {{ section.settings.vertical_padding }}px;
  "
  data-testid="testimonials-{{ section.id }}"
  {{ section.shopify_attributes }}
>
  <div class="testimonials__header">
    {% content_for 'block', type: '_ui-heading', id: 'heading' %}
    {%- if section.settings.show_rating -%}
      {% content_for 'block', type: '_ui-review-line', id: 'rating' %}
    {%- endif -%}
  </div>

  <ui-carousel class="testimonials__viewport">
    <div class="testimonials__track" data-carousel-track>
      {% content_for 'blocks' %}
    </div>

    {%- if testimonial_count > 1 -%}
      <div class="testimonials__controls">
        {% render 'ui-pagination-arrow',
          direction: 'left',
          class: 'testimonials__arrow',
          attributes: 'data-carousel-prev'
        %}
        <div class="ui-carousel__dots" data-carousel-dots></div>
        {% render 'ui-pagination-arrow',
          direction: 'right',
          class: 'testimonials__arrow',
          attributes: 'data-carousel-next'
        %}
      </div>
    {%- endif -%}
  </ui-carousel>
</div>

{% render 'ui-carousel' %}

{% stylesheet %}
  .testimonials {
    --testimonials-card-width: 295px;
    --testimonials-gap: 16px;
    --testimonials-header-gap: 32px;

    display: flex;
    flex-direction: column;
    gap: var(--testimonials-header-gap);
    padding-block: var(--testimonials-block-padding, 64px);

    /* Opens on the second card: the file draws the row already moved along, and a
       first card flush to the edge hides that it scrolls. */
    --ui-carousel-start: 2;
  }

  /* One card has nothing to scroll to: open on it, and let it sit in the track
     without the offset that would otherwise centre a second card. */
  .testimonials--single {
    --ui-carousel-start: 1;
  }

  .testimonials--single .testimonials__track {
    overflow-x: hidden;
  }

  .testimonials__header {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 16px;
    box-sizing: border-box;

    /* The auto margins that centre this also stop it stretching to the column, so the
       width has to be asked for. Without it the header shrinks to the heading's
       longest line and the rating line centres on that instead of on the page. */
    width: 100%;
    max-width: var(--page-width, 90rem);
    margin-inline: auto;
    padding-inline: var(--ui-page-margin);
    text-align: center;
  }

  .testimonials__viewport {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 32px;
  }

  .testimonials__track {
    display: flex;
    align-items: stretch;
    gap: var(--testimonials-gap);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: none;

    /* Half a viewport either side centres a card, so its neighbours peek evenly. */
    padding-inline: calc((100% - var(--testimonials-card-width)) / 2);
  }

  .testimonials__track::-webkit-scrollbar {
    display: none;
  }

  .testimonials__track > * {
    flex: 0 0 var(--testimonials-card-width);
    scroll-snap-align: center;
  }

  .testimonials__controls {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 16px;
  }

  @media screen and (min-width: 750px) {
    .testimonials {
      --testimonials-card-width: 413px;
      --testimonials-gap: 20px;
      --testimonials-header-gap: 48px;

      padding-block: var(--testimonials-block-padding-desktop, 80px);

      /* The row lines up with the page column here, so the first card is already
         where the heading starts and there is nothing to reveal. */
      --ui-carousel-start: 1;
    }

    .testimonials__track {
      /* Aligned to the page column rather than centred, which is what puts the row's
         first card under the start of the heading. */
      padding-inline: max(
        var(--ui-page-margin),
        calc((100% - var(--page-width, 90rem)) / 2 + var(--ui-page-margin))
      );

      /* Snapping measures from the scrollport edge, not from the padding, so without
         this the first card snaps flush to the window and the row loses the page
         margin it is supposed to start at. */
      scroll-padding-inline: max(
        var(--ui-page-margin),
        calc((100% - var(--page-width, 90rem)) / 2 + var(--ui-page-margin))
      );
    }

    .testimonials__track > * {
      scroll-snap-align: start;
    }

    /* The file gives a wide row no controls: a card cut off at the edge says it
       scrolls without them. */
    .testimonials__controls {
      display: none;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Testimonials",
  "tag": "section",
  "blocks": [{ "type": "_ui-testimonial" }],
  "settings": [
    {
      "type": "checkbox",
      "id": "show_rating",
      "label": "Show the rating line under the heading",
      "info": "Off by default. The manual rating and review count are unverified; switch on only with real figures.",
      "default": false
    },
    {
      "type": "header",
      "content": "t:content.colors"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "header",
      "content": "t:content.padding"
    },
    {
      "type": "range",
      "id": "vertical_padding",
      "label": "t:settings.top",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 80
    },
    {
      "type": "range",
      "id": "vertical_padding_mobile",
      "label": "t:content.mobile_size",
      "min": 0,
      "max": 120,
      "step": 4,
      "unit": "px",
      "default": 64
    }
  ],
  "presets": [
    {
      "name": "Testimonials",
      "blocks": {
        "heading": {
          "type": "_ui-heading",
          "static": true,
          "settings": { "heading": "<h2>What <em>customers say</em></h2>", "max_width": 520 }
        },
        "rating": {
          "type": "_ui-review-line",
          "static": true,
          "settings": { "layout": "inline", "rating_text": "", "reviews_text": "", "text_size": 16, "text_size_mobile": 14 }
        },
        "one": { "type": "_ui-testimonial" }
      },
      "block_order": ["one"]
    }
  ]
}
{% endschema %}
