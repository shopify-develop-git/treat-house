{%- comment -%}Load this section's styles only when the section renders.{%- endcomment -%}
{{ 'th-section-customize-box.css' | asset_url | stylesheet_tag }}
{%- comment -%}
  The box builder chooses a pack size, individual flavor quantities, optional gift
  box, and gift message. It posts one cart line per flavor and one existing gift-box
  charge carrier, with shared box metadata. Shopify supplies every price.
  The September 10 client call confirms one gift-box charge for every pack size
  and no individual wrapping. Flavor totals remain bounded by the chosen size.
{%- endcomment -%}

{%- liquid
  assign packs = section.settings.pack_collection.products
  # The ten treats the file draws exist as products but belong to no collection,
  # so a picked list is the shorter road: a shop that keeps its flavours in a
  # collection can still point at one, and the list wins when both are set.
  assign flavours = section.settings.flavour_products
  if flavours == blank or flavours.size == 0
    assign flavours = section.settings.flavour_collection.products
  endif
  assign first_pack = packs.first

  assign scheme_class = 'color-' | append: section.settings.color_scheme

  # `render` takes no filters on a named argument, so every translated label is
  # resolved here rather than at the call.

  ##
  # The wording of the steps, the review and the summary is not a merchant
  # decision. There is one builder in this shop and nobody was going to run a
  # second one with different step titles, but it lived as eighteen text
  # settings all the same, and they made the section panel three quarters copy:
  # forty settings, of which twenty-nine were words. Every one of the eighteen
  # still held the value it shipped with.
  #
  # They live in `locales` now, which is where Shopify already edits theme text,
  # and the panel is left with the handful of things that decide what the
  # builder does. Resolved here rather than at each call for the same reason
  # `back_label` is: a filter cannot go inside an `if`, and `render` takes none
  # on a named argument.
  assign step_1_title = 'content.customize_box_step_1_title' | t
  assign step_1_intro = 'content.customize_box_step_1_intro' | t
  assign step_2_title = 'content.customize_box_step_2_title' | t
  assign step_2_intro = 'content.customize_box_step_2_intro' | t
  assign step_3_title = 'content.customize_box_step_3_title' | t
  assign step_3_intro = 'content.customize_box_step_3_intro' | t
  assign step_4_title = 'content.customize_box_step_4_title' | t
  assign step_4_intro = 'content.customize_box_step_4_intro' | t
  assign message_placeholder = 'content.customize_box_message_placeholder' | t
  assign review_title = 'content.customize_box_review_title' | t
  assign review_intro = 'content.customize_box_review_intro' | t
  assign summary_title = 'content.customize_box_summary_title' | t
  assign label_flavours = 'content.customize_box_label_flavours' | t
  assign label_flavours_selected = 'content.customize_box_label_flavours_selected' | t
  assign label_quantity = 'content.customize_box_label_quantity' | t
  assign label_packaging = 'content.customize_box_label_packaging' | t
  assign label_message = 'content.customize_box_label_message' | t
  assign summary_total_label = 'content.customize_box_summary_total_label' | t

  assign back_label = 'actions.back' | t
  assign continue_label = 'actions.continue' | t
  assign add_to_cart_label = 'actions.add_to_cart' | t
  assign full_heading = section.settings.heading | append: ' ' | append: section.settings.heading_accent | strip
  assign breadcrumb_current = page.title | default: full_heading
-%}

<div
  class="section section--{{ section.settings.section_width }} spacing-style {{ scheme_class }} customize-box"
  style="{% render 'spacing-style', settings: section.settings %}"
  {{ section.shopify_attributes }}
>
  {% render 'ui-breadcrumb',
    parent_title: section.settings.breadcrumb_parent_title,
    parent_url: section.settings.breadcrumb_parent_url,
    current: breadcrumb_current
  %}

  {%- comment -%}
    The band is full width inside the page column, not full bleed: the file runs
    it from margin to margin like every card under it.
  {%- endcomment -%}
  <div class="customize-box__hero">
    {%- if section.settings.eyebrow != blank -%}
      <p class="customize-box__eyebrow">
        <span class="customize-box__eyebrow-icon" aria-hidden="true">
          {{- 'icon-ui-square-pen.svg' | inline_asset_content -}}
        </span>
        {{ section.settings.eyebrow }}
      </p>
    {%- endif -%}

    {%- comment -%}
      Past the first step the file swaps the title — "Choose Your Own Flavors"
      becomes "Customize Your Box" (508:9503 against 508:9631). Both wordings ride
      on the spans as attributes rather than living in the script, so the merchant
      still owns the copy and a translation still travels with it.

      Both spans always render, even when a wording is blank: the script fills
      them, and a span that was never drawn cannot be filled later.
    {%- endcomment -%}
    <h1 class="customize-box__heading">
      <span
        data-heading-part
        data-first="{{ section.settings.heading | escape }}"
        data-after="{{ section.settings.heading_after | escape }}"
      >{{ section.settings.heading }}</span>
      <span
        class="customize-box__heading-accent"
        data-heading-part
        data-first="{{ section.settings.heading_accent | escape }}"
        data-after="{{ section.settings.heading_accent_after | escape }}"
      >{{ section.settings.heading_accent }}</span>
    </h1>

    {%- if section.settings.subheading != blank -%}
      <p class="customize-box__subheading">{{ section.settings.subheading }}</p>
    {%- endif -%}
  </div>

  {%- if first_pack == blank -%}
    <p class="customize-box__setup">
      {{ 'content.customize_box_setup' | t }}
    </p>
  {%- else -%}
    <customize-box
      class="customize-box__builder"
      data-total-steps="4"
      data-money-format="{{ shop.money_format | strip_html | escape }}"
      data-currency="{{ cart.currency.iso_code }}"
    >
      {%- comment -%}
        No product form here, and no pack variant. A box is a set of lines now —
        one per flavour, one for the packaging — which `{% form 'product' %}` and
        Horizon's product-form-component cannot express: both are built around a
        single `id`. The script posts the set to /cart/add.js itself and then
        announces it with the theme's own CartAddEvent, so the drawer and the
        count still refresh the way they do everywhere else.
      {%- endcomment -%}
      <div class="customize-box__form">
        <div
          class="visually-hidden"
          aria-live="assertive"
          role="status"
          aria-atomic="true"
          data-live-region
        ></div>

          <div class="customize-box__layout">
            <div class="customize-box__main">
              {%- comment -%} Screen 1 carries steps 1 and 2, as the file draws them. {%- endcomment -%}
              <section class="customize-box__screen" data-screen="1">
                <div class="customize-box__step">
                  {% render 'ui-step-progress', step: 1, total: 4 %}
                  <div class="customize-box__card">
                    <div class="customize-box__card-head">
                      <h2 class="customize-box__card-title">
                        <span class="customize-box__card-number">1.</span>
                        {{ step_1_title }}
                      </h2>
                      {%- if step_1_intro != blank -%}
                        <p class="customize-box__card-intro">{{ step_1_intro }}</p>
                      {%- endif -%}
                    </div>
                    <hr class="customize-box__rule">

                    <div class="customize-box__packs" role="radiogroup" aria-label="{{ step_1_title | escape }}">
                      {%- for pack in packs -%}
                        {%- comment %}<locksmith:cfb3>{% endcomment -%}
                          {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: pack, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
                        {%- comment %}</locksmith:cfb3>{% endcomment -%}
                        {%- liquid
                          assign short_title = pack.title | split: '–' | first | strip
                          assign pack_size = pack.metafields.custom.pack_size.value | default: pack.metafields.custom.pack_size
                          if pack_size == blank
                            assign pack_size = pack.title | split: ' ' | first | times: 1
                          endif

                          # No per-unit note under the tile. It read "$3.00 / treat"
                          # under all three packs, because that is what the prices
                          # are — the same rate at 12, 24 and 36 — so the line was
                          # three identical figures pretending to be a comparison.
                          # The cheapest variant was looked up only to divide by the
                          # pack size, so that search goes with it; `unit_noun` and
                          # [ui-choice-tile]'s `note` both stay for the day the rate
                          # does step with the size.
                          assign per_treat = ''

                          # Escaped into their own variables first. A filter in the
                          # middle of an append chain applies to everything
                          # accumulated so far, not to the value beside it.
                          assign safe_title = short_title | escape
                          assign safe_note = per_treat | escape
                          assign tile_attributes = 'data-pack="' | append: pack.handle
                          assign tile_attributes = tile_attributes | append: '" data-pack-size="' | append: pack_size
                          assign tile_attributes = tile_attributes | append: '" data-pack-title="' | append: safe_title
                          assign tile_attributes = tile_attributes | append: '" data-pack-note="' | append: safe_note | append: '"'
                        -%}
                        {% render 'ui-choice-tile',
                          name: 'customize-pack',
                          value: pack.handle,
                          title: short_title,
                          note: per_treat,
                          image: pack.featured_image,
                          attributes: tile_attributes
                        %}
                      {%- endfor -%}
                    </div>
                  </div>
                </div>

                <div class="customize-box__step">
                  {% render 'ui-step-progress', step: 2, total: 4 %}
                  <div class="customize-box__card">
                    <div class="customize-box__card-head">
                      <h2 class="customize-box__card-title">
                        <span class="customize-box__card-number">2.</span>
                        {{ step_2_title }}
                      </h2>
                      {%- if step_2_intro != blank -%}
                        <p class="customize-box__card-intro">{{ step_2_intro }}</p>
                      {%- endif -%}
                    </div>
                    <hr class="customize-box__rule">

                    {%- if flavours.size > 0 -%}
                      <div class="customize-box__flavours">
                        {%- for flavour in flavours -%}
                          {%- comment %}<locksmith:aafb>{% endcomment -%}
                            {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: flavour, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
                          {%- comment %}</locksmith:aafb>{% endcomment -%}
                          {%- capture flavour_season -%}{% render 'season-status', product: flavour %}{%- endcapture -%}
                          {%- liquid
                            # A seasonal flavour that is closed or not yet open is left out of
                            # the builder rather than drawn disabled — see [season-status].
                            assign flavour_season_status = flavour_season | strip | split: '|' | first
                            if flavour_season_status != blank and flavour_season_status != 'available'
                              continue
                            endif

                            assign flavour_variant = flavour.first_available_variant | default: flavour.variants.first
                            assign flavour_attributes = 'data-flavour-variant="' | append: flavour_variant.id
                            # The price rides along so the summary can add up what has actually
                            # been picked. It is the variant's own figure, the one the cart line
                            # will carry, so the two cannot drift.
                            assign flavour_attributes = flavour_attributes | append: '" data-flavour-price="' | append: flavour_variant.price
                            assign flavour_attributes = flavour_attributes | append: '" data-flavour-available="' | append: flavour_variant.available | append: '"'
                          -%}
                          {% render 'ui-flavour-card',
                            handle: flavour.handle,
                            title: flavour.title,
                            image: flavour.featured_image,
                            attributes: flavour_attributes
                          %}
                        {%- endfor -%}
                      </div>
                      <p class="customize-box__tally" data-tally aria-live="polite"></p>
                    {%- else -%}
                      <p class="customize-box__setup">{{ 'content.customize_box_flavours_setup' | t }}</p>
                    {%- endif -%}

                    <hr class="customize-box__rule">
                    <div class="customize-box__actions">
                      {% render 'ui-button', variant: 'secondary', label: back_label, attributes: 'data-step-back' %}
                      {% render 'ui-button', variant: 'primary', label: continue_label, attributes: 'data-step-next' %}
                    </div>
                  </div>
                </div>
              </section>

              <section class="customize-box__screen" data-screen="2" hidden>
                {% render 'ui-step-progress', step: 3, total: 4 %}
                <div class="customize-box__card">
                  <div class="customize-box__card-head">
                    <h2 class="customize-box__card-title">
                      <span class="customize-box__card-number">3.</span>
                      {{ step_3_title }}
                    </h2>
                    {%- if step_3_intro != blank -%}
                      <p class="customize-box__card-intro">{{ step_3_intro }}</p>
                    {%- endif -%}
                  </div>
                  <hr class="customize-box__rule">

                  <div class="customize-box__packaging" role="radiogroup" aria-label="{{ step_3_title | escape }}">
                    {% content_for 'blocks' %}
                  </div>

                  <hr class="customize-box__rule">
                  <div class="customize-box__actions">
                    {% render 'ui-button', variant: 'secondary', label: back_label, attributes: 'data-step-back' %}
                    {% render 'ui-button', variant: 'primary', label: continue_label, attributes: 'data-step-next' %}
                  </div>
                </div>
              </section>

              <section class="customize-box__screen" data-screen="3" hidden>
                {% render 'ui-step-progress', step: 4, total: 4 %}
                <div class="customize-box__card">
                  <div class="customize-box__card-head">
                    <h2 class="customize-box__card-title">
                      <span class="customize-box__card-number">4.</span>
                      {{ step_4_title }}
                    </h2>
                    {%- if step_4_intro != blank -%}
                      <p class="customize-box__card-intro">{{ step_4_intro }}</p>
                    {%- endif -%}
                  </div>
                  <hr class="customize-box__rule">

                  {% render 'ui-message',
                    placeholder: message_placeholder,
                    maxlength: section.settings.message_maxlength,
                    class: 'customize-box__message',
                    attributes: 'data-message'
                  %}

                  <hr class="customize-box__rule">
                  <div class="customize-box__actions">
                    {% render 'ui-button', variant: 'secondary', label: back_label, attributes: 'data-step-back' %}
                    {% render 'ui-button', variant: 'primary', label: continue_label, attributes: 'data-step-next' %}
                  </div>
                </div>
              </section>

              <section class="customize-box__screen" data-screen="4" hidden>
                <div class="customize-box__card">
                  <div class="customize-box__card-head">
                    <h2 class="customize-box__card-title">{{ review_title }}</h2>
                    {%- if review_intro != blank -%}
                      <p class="customize-box__card-intro">{{ review_intro }}</p>
                    {%- endif -%}
                  </div>
                  <hr class="customize-box__rule">

                  <div class="customize-box__review">
                    {% render 'ui-review-row', label: label_flavours, value: '', edit_step: '1', class: 'customize-box__review-flavours' %}
                    {% render 'ui-review-row', label: label_quantity, value: '', edit_step: '1', class: 'customize-box__review-pack' %}
                    {% render 'ui-review-row', label: label_packaging, value: '', edit_step: '2', class: 'customize-box__review-packaging' %}
                    {% render 'ui-review-row', label: label_message, value: '', edit_step: '3', class: 'customize-box__review-message' %}
                  </div>

                  <hr class="customize-box__rule">
                  <div class="customize-box__actions">
                    {% render 'ui-button', variant: 'secondary', label: back_label, attributes: 'data-step-back' %}
                  </div>
                </div>
              </section>

              {%- if section.settings.promo_title != blank -%}
                <aside class="customize-box__promo">
                  {%- comment -%}
                    The title is a child of the strip, not of the copy beside the
                    button: the file gives it a row of its own across the full
                    width, and a grid can only span something it owns.
                  {%- endcomment -%}
                  <p class="customize-box__promo-title">
                    <span class="customize-box__promo-icon" aria-hidden="true">
                      {{- 'icon-ui-tag.svg' | inline_asset_content -}}
                    </span>
                    {{ section.settings.promo_title }}
                  </p>
                  {%- if section.settings.promo_text != blank -%}
                    <div class="customize-box__promo-text">
                      <p class="customize-box__promo-copy">{{ section.settings.promo_text }}</p>
                    </div>
                  {%- endif -%}
                  {%- if section.settings.promo_button_label != blank -%}
                    {% render 'ui-button',
                      variant: 'secondary',
                      label: section.settings.promo_button_label,
                      link: section.settings.promo_button_link
                    %}
                  {%- endif -%}
                </aside>
              {%- endif -%}
            </div>

            <aside class="customize-box__summary">
              <div class="customize-box__summary-inner">
                <h2 class="customize-box__summary-title">{{ summary_title }}</h2>
                <hr class="customize-box__rule">

                <div class="customize-box__summary-row">
                  <span>{{ label_quantity }}</span>
                  <strong data-summary-pack>&mdash;</strong>
                </div>

                <div class="customize-box__summary-row">
                  <span>{{ label_flavours_selected }}</span>
                  <strong data-summary-flavour-count>0</strong>
                </div>

                <div class="customize-box__summary-chips" data-summary-chips hidden></div>

                {%- comment -%}
                  The name and the surcharge are two spans rather than one string
                  because the file sets them differently — the choice in bold at
                  16, the "(+ $6.00)" beside it regular at 14. The two carry no
                  whitespace between them in the source; the space belongs to the
                  surcharge, so a choice that adds nothing leaves no gap behind.
                {%- endcomment -%}
                <div class="customize-box__summary-row" data-summary-packaging-row hidden>
                  <span>{{ label_packaging }}</span>
                  <strong data-summary-packaging><span data-summary-packaging-name></span><span class="customize-box__summary-extra" data-summary-packaging-extra></span></strong>
                </div>

                <div class="customize-box__summary-row" data-summary-message-row hidden>
                  <span>{{ label_message }}</span>
                  <strong>{{ 'content.added' | t }}</strong>
                </div>

                <hr class="customize-box__rule">

                <div class="customize-box__summary-total">
                  <span>{{ summary_total_label }}</span>
                  <strong data-summary-total>{{ 0 | money }}</strong>
                </div>

                {%- comment -%}
                  Horizon's add-to-cart-component is bound to a product form and a
                  single variant, neither of which exists here, so this is a plain
                  button the builder's own script drives. What is lost with it is
                  the flying-image animation; what is kept is every other part of
                  the cart, because the script raises the same event the component
                  would have raised.
                {%- endcomment -%}
                <div class="customize-box__add" hidden data-add-wrapper>
                  {% render 'ui-button',
                    variant: 'primary',
                    label: add_to_cart_label,
                    type: 'button',
                    full_width: true,
                    attributes: 'data-add-button'
                  %}
                  <p class="customize-box__add-error" hidden data-add-error></p>
                </div>
              </div>
            </aside>
          </div>
      </div>
    </customize-box>
  {%- endif -%}
</div>

<script src="{{ 'ui-customize-box.js' | asset_url }}" type="module"></script>



{% schema %}
{
  "name": "Customize your box",
  "tag": "section",
  "settings": [
    {
      "type": "paragraph",
      "content": "The pack sizes are products and the packaging is their own options, so the price always comes from Shopify. Flavours and the gift message ride along as line item properties."
    },
    {
      "type": "collection",
      "id": "pack_collection",
      "label": "Pack sizes",
      "info": "One product per size. The size is read from the product's custom.pack_size metafield, or from the number its title starts with."
    },
    {
      "type": "product_list",
      "id": "flavour_products",
      "label": "Flavours",
      "limit": 24,
      "info": "Used instead of the collection below when it has anything in it."
    },
    {
      "type": "collection",
      "id": "flavour_collection",
      "label": "Flavours collection"
    },
    {
      "type": "range",
      "id": "message_maxlength",
      "label": "Gift message length",
      "min": 50,
      "max": 500,
      "step": 10,
      "default": 200
    },
    {
      "type": "header",
      "content": "Page top"
    },
    {
      "type": "text",
      "id": "breadcrumb_parent_title",
      "label": "Parent page",
      "default": "Gift Boxes"
    },
    {
      "type": "url",
      "id": "breadcrumb_parent_url",
      "label": "t:settings.link"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow",
      "default": "Customize"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "t:settings.heading",
      "default": "Design"
    },
    {
      "type": "text",
      "id": "heading_accent",
      "label": "Heading in purple",
      "default": "your box"
    },
    {
      "type": "text",
      "id": "heading_after",
      "label": "Heading after step one",
      "default": "Your box,",
      "info": "The title changes once the reader is past the first step. Leave either field empty to keep the wording above for the whole builder."
    },
    {
      "type": "text",
      "id": "heading_accent_after",
      "label": "Heading in purple after step one",
      "default": "your way"
    },
    {
      "type": "textarea",
      "id": "subheading",
      "label": "t:settings.text",
      "default": "Pick your flavors, choose the packaging, add a note, and review. Four short steps, and you can go back at any point."
    },
    {
      "type": "header",
      "content": "Corporate note"
    },
    {
      "type": "text",
      "id": "promo_title",
      "label": "t:settings.title",
      "default": "Your brand, made personal"
    },
    {
      "type": "textarea",
      "id": "promo_text",
      "label": "t:settings.text",
      "default": "Your logo and colors on every treat, for clients, teams, and events. Send us a note and a real person will follow up with pricing and a proof."
    },
    {
      "type": "text",
      "id": "promo_button_label",
      "label": "t:settings.label",
      "default": "Plan a thoughtful client gift"
    },
    {
      "type": "url",
      "id": "promo_button_link",
      "label": "t:settings.link"
    },
    {
      "type": "header",
      "content": "t:content.layout"
    },
    {
      "type": "select",
      "id": "section_width",
      "label": "t:settings.width",
      "options": [
        {
          "value": "page-width",
          "label": "t:options.page"
        },
        {
          "value": "full-width",
          "label": "t:options.full"
        }
      ],
      "default": "page-width"
    },
    {
      "type": "color_scheme",
      "id": "color_scheme",
      "label": "t:settings.color_scheme",
      "default": "scheme-1"
    },
    {
      "type": "range",
      "id": "padding-block-start",
      "label": "t:settings.top_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding-block-end",
      "label": "t:settings.bottom_padding",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 80
    }
  ],
  "blocks": [
    {
      "type": "_ui-box-packaging"
    }
  ],
  "presets": [
    {
      "name": "Customize your box",
      "blocks": [
        {
          "type": "_ui-box-packaging",
          "settings": {
            "title": "Clear Tray",
            "description": "Simple and clear, for everyday sharing",
            "gift_box": false,
            "individual_packs": false
          }
        },
        {
          "type": "_ui-box-packaging",
          "settings": {
            "title": "Gift Box",
            "description": "Our signature gift box",
            "gift_box": true,
            "individual_packs": false
          }
        }
      ]
    }
  ]
}
{% endschema %}
