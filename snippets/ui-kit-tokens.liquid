{%- doc -%}
  Shared tokens for the Treat House UI kit.

  Rendered once from layout/theme.liquid. It emits no markup — the `{% stylesheet %}`
  block below is collected into the theme's bundled CSS, which is what makes these
  custom properties available to every kit component.

  Colours carry the names used in the Figma file, so a value can be traced back to
  the design without a lookup table. Typography maps onto the theme's own font
  settings rather than hardcoding a family: `body` is Nunito Regular and `emphasis`
  is Nunito SemiBold, which is the theme's subheading font. Reaching for
  `--font-body--family` at weight 600 would get a synthesised face instead, since
  the theme only loads the body font at 400 and 700.

  @example
  {%- render 'ui-kit-tokens' -%}
{%- enddoc -%}

{% stylesheet %}
  :root {
    /* Palette — names match the Figma styles */
    --ui-color-primary: #6c276a;
    --ui-color-white: #ffffff;
    --ui-color-black: #000000;
    --ui-color-sky-blue: #a3d8f6;
    --ui-color-orange: #ea6f36;
    --ui-color-light-blue: #ddf2ff;
    --ui-color-border-gray: #d1d1d1;
    --ui-color-gray: #555555;
    --ui-color-accents-red: #ff383c;

    /* Semantic — components ask for intent, so a palette swap does not touch them.
       The kit is not consistent about the error red: three fields use the named
       Accents/Red style, while Field/Gift type carries a raw #e6281a. The named
       style wins here. */
    --ui-color-error: var(--ui-color-accents-red);

    /* Type */
    --ui-font-body: var(--font-body--family);
    --ui-font-body-weight: var(--font-body--weight);
    --ui-font-emphasis: var(--font-subheading--family);
    --ui-font-emphasis-weight: var(--font-subheading--weight);
    --ui-font-accent: var(--font-accent--family);
    --ui-line-height: 1.3;

    /* Shared shape */
    --ui-radius-sm: 2px;
    --ui-hairline-width: 0.5px;
    --ui-disabled-opacity: 0.3;
  }
{% endstylesheet %}
