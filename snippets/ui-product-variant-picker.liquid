{%- doc -%}
  The kit's variant control, wired to the theme (Figma: Standart Product Page →
  Choose Your Box).

  This is the seam between the two halves of the theme. The look is entirely the
  kit's — [ui-variant-select] and [ui-variant-item], unchanged — and the behaviour
  is entirely Horizon's: `<variant-picker>` from `assets/variant-picker.js`, which
  on a change fetches the product at the chosen option values, morphs itself, and
  fires `variant:update` for the price, the buy button and the gallery to answer.

  What that element needs from its markup is small and exact, and all of it is
  here rather than in the kit snippets:

  - the radios inside a `<fieldset ref="fieldsets[]">`, because the element reads
    the selection back through `fieldset input:checked`;
  - `data-option-value-id` on every input, which is what the fetched URL is built
    from;
  - a `<script type="application/json">` holding the selected variant, which the
    fetch reads out of the *response* — without it the request completes and
    nothing updates.

  `declarative-open` on the disclosure is what closes the list once a variant is
  chosen. `assets/morph.js` deliberately carries a `<details>`'s open state across
  a morph — the right default, since a shopper who opened something should not have
  it snap shut under them — and that attribute is its own opt-out, so this one list
  takes the server's state instead. Without it the panel stayed open over the copy
  below it after every choice.

  A product with one variant gets nothing: a control with a single option is a
  label wearing a chevron.

  @param {object} product_resource - The product to pick a variant of. Named as
    Horizon names it, so it does not shadow the template's own `product`, which is
    what tells the element it is on that product's page.
  @param {string} [label_prefix] - Leads each option's name: "Choose your" gives
    "Choose your Box". Blank leaves the option's own name standing alone, and so
    does an option already starting with the same word — a shop with an option
    called "Choose a Pack" does not want "Choose your Choose a Pack".
  @param {string} [class] - Additional CSS classes.
  @param {object} [gift_box_image] - A fallback image for the packaging option's
    upgrade value (the second value of the first option). Matched on position
    rather than wording, since the value strings differ per pack. Used only when
    that value's variant has no featured media of its own.
  @param {string} [hide_option_name] - Keep a native option wired but visually hidden
    when another control selects it (the custom-treat flavor property selector).

  @example
  {% render 'ui-product-variant-picker', product_resource: closest.product, label_prefix: 'Choose your' %}
{%- enddoc -%}

{%- comment -%}
  variant-picker.js is loaded on every page by snippets/scripts.liquid, so there is
  nothing to pull in here.
{%- endcomment -%}
{%- unless product_resource.has_only_default_variant -%}
  {%- liquid
    assign has_custom_count = false
    for native_option in product_resource.options_with_values
      assign native_option_name = native_option.name | downcase
      if native_option_name contains 'how many custom treats'
        assign has_custom_count = true
      endif
    endfor
    assign normalize_custom_choices = false
    if product_resource.handle == '12-pack-of-custom-treats' and product_resource.options_with_values.size == 3
      assign normalize_custom_choices = true
    endif
    assign selected_custom_value = product_resource.options_with_values[2].selected_value | append: ''
    assign canonical_custom_value = selected_custom_value | split: '/' | first | strip
    assign canonical_selected_option = product_resource.options_with_values[2].values | find: 'name', canonical_custom_value
    assign selected_custom_alias = false
    if normalize_custom_choices and canonical_selected_option.id != blank and selected_custom_value contains 'No Individual Box'
      assign selected_custom_alias = true
    endif
  -%}
  <variant-picker
    class="ui-product-variant-picker{% if has_custom_count %} ui-product-variant-picker--custom{% endif %}{% if class != blank %} {{ class }}{% endif %}"
    data-section-id="{{ section.id }}"
    data-product-id="{{ product_resource.id }}"
    data-product-url="{{ product_resource.url }}"
    {% if product.id == product_resource.id %}data-template-product-match="true"{% endif %}
  >
    {%- for product_option in product_resource.options_with_values -%}
      {%- liquid
        assign fieldset_index = forloop.index0
        assign group_name = product_option.name | handleize | append: '-' | append: section.id | append: '-' | append: product_resource.id

        # The prefix leads the option's name, but only when the name is not already
        # leading itself. Real catalogues have options called "Choose a Pack", and
        # "Choose your Choose a Pack" is what a blind append gives you.
        assign legend = product_option.name
        if label_prefix != blank
          assign prefix_head = label_prefix | downcase | split: ' ' | first
          assign name_head = product_option.name | downcase | split: ' ' | first
          unless prefix_head == name_head
            assign legend = label_prefix | append: ' ' | append: product_option.name
          endunless
        endif

        assign trigger_label = product_option.selected_value
        assign trigger_image = ''
        assign option_name_lower = product_option.name | downcase
        assign custom_count_option = false
        if option_name_lower contains 'how many custom treats'
          assign custom_count_option = true
          assign legend = 'How many treats would you like custom?'
        elsif option_name_lower contains 'flavor' or option_name_lower contains 'flavour'
          assign legend = 'Choose your flavor'
        endif
      -%}

      {%- capture option_rows -%}
        {%- for value in product_option.values -%}
          {%- liquid
            assign row_label = value.name
            assign row_class = ''
            assign canonical_option_id = ''
            assign canonical_variant_id = ''
            assign custom_count_label = ''
            assign choice_boxed = false
            for selected_option in value.variant.options
              assign selected_option_lower = selected_option | downcase
              if selected_option_lower contains 'individual'
                unless selected_option_lower contains 'no individual'
                  assign choice_boxed = true
                endunless
              endif
            endfor
            if value.name contains 'half of my treats'
              assign custom_count_label = '6 custom treats'
            elsif value.name contains 'all of my treats'
              assign custom_count_label = '12 custom treats'
            endif

            if normalize_custom_choices
              # Existing deep links keep their native variant on load. An input
              # change can normalize a duplicate option without changing catalog data.
              assign target_option_one = product_resource.selected_or_first_available_variant.options[0] | append: ''
              assign target_option_two = product_resource.selected_or_first_available_variant.options[1] | append: ''
              assign target_option_three = product_resource.selected_or_first_available_variant.options[2] | append: ''
              if selected_custom_alias
                assign target_option_three = canonical_custom_value
              endif
              case product_option.position
                when 1
                  assign target_option_one = value.name
                when 2
                  assign target_option_two = value.name
                when 3
                  assign target_option_three = value.name
                  if value.name contains 'No Individual Box'
                    assign target_option_three = value.name | split: '/' | first | strip
                    assign canonical_option = product_option.values | find: 'name', target_option_three
                    assign canonical_option_id = canonical_option.id
                    if canonical_option_id != blank and value.selected == false
                      assign row_class = 'ui-product-variant-picker__duplicate'
                    endif
                  elsif selected_custom_alias and value.name == canonical_custom_value
                    # Show the selected alias in its equivalent row until the
                    # shopper changes an option; keep exactly four visible choices.
                    assign row_class = 'ui-product-variant-picker__duplicate'
                  endif
              endcase
              for candidate_variant in product_resource.variants
                assign candidate_one = candidate_variant.options[0] | append: ''
                assign candidate_two = candidate_variant.options[1] | append: ''
                assign candidate_three = candidate_variant.options[2] | append: ''
                if candidate_one == target_option_one and candidate_two == target_option_two and candidate_three == target_option_three
                  assign canonical_variant_id = candidate_variant.id
                  break
                endif
              endfor
            endif
          -%}
          {%- if custom_count_option and custom_count_label != blank -%}
            {%- liquid
              assign custom_extra = 0
              if value.name contains 'all of my treats' and value.variant.price != blank
                for half_value in product_option.values
                  assign half_value_lower = half_value.name | downcase
                  assign half_boxed = false
                  for half_selected_option in half_value.variant.options
                    assign half_selected_option_lower = half_selected_option | downcase
                    if half_selected_option_lower contains 'individual'
                      unless half_selected_option_lower contains 'no individual'
                        assign half_boxed = true
                      endunless
                    endif
                  endfor
                  if half_value_lower contains 'half of my treats' and half_boxed == choice_boxed and half_value.variant.price != blank
                    assign custom_extra = value.variant.price | minus: half_value.variant.price
                    break
                  endif
                endfor
              endif
            -%}
            {%- capture row_label -%}
              <span class="ui-product-variant-picker__choice-name">{{ custom_count_label }}{% if custom_extra > 0 %} <span class="ui-product-variant-picker__choice-extra">(+ {{ custom_extra | money }} from half custom)</span>{% endif %}</span>
              <span class="ui-product-variant-picker__choice-detail">{% if choice_boxed %}Individually boxed{% else %}Standard pack{% endif %}{% if value.variant.price != blank %} · <span class="ui-product-variant-picker__choice-price">{{ value.variant.price | money }} total</span>{% endif %}</span>
            {%- endcapture -%}
            {%- if value.selected -%}{%- assign trigger_label = row_label -%}{%- endif -%}
          {%- endif -%}
          {%- capture row_attributes -%}
            data-previous-checked="false"
            data-fieldset-index="{{ fieldset_index }}"
            data-input-index="{{ forloop.index0 }}"
            data-input-id="{{ product_option.position }}-{{ forloop.index0 }}"
            data-option-value-id="{{ value.id }}"
            data-option-available="{{ value.available }}"
            data-connected-product-url="{{ value.product_url }}"
            {%- if canonical_option_id != blank %} data-canonical-option-value-id="{{ canonical_option_id }}"{% endif -%}
            {%- if canonical_variant_id != blank %} data-canonical-variant-id="{{ canonical_variant_id }}"{% endif -%}
            {%- if value.variant.id %} data-variant-id="{{ value.variant.id }}"{% endif -%}
            {%- if value.selected %} data-current-checked="true"{% else %} data-current-checked="false"{% endif -%}
            {%- unless value.available %} aria-disabled="true"{% endunless -%}
          {%- endcapture -%}

          {%- liquid
            assign row_image = value.variant.featured_media.preview_image
            if row_image == blank and fieldset_index == 0 and forloop.index0 == 1 and gift_box_image != blank
              assign row_image = gift_box_image
            endif
          -%}
          {% render 'ui-variant-item',
            label: row_label,
            value: value.name,
            image: row_image,
            checked: value.selected,
            name: group_name,
            class: row_class,
            attributes: row_attributes
          %}
        {%- endfor -%}
      {%- endcapture -%}

      {%- for value in product_option.values -%}
        {%- if value.selected -%}
          {%- assign trigger_image = value.variant.featured_media.preview_image -%}
          {%- if trigger_image == blank and fieldset_index == 0 and forloop.index0 == 1 and gift_box_image != blank -%}
            {%- assign trigger_image = gift_box_image -%}
          {%- endif -%}
          {%- break -%}
        {%- endif -%}
      {%- endfor -%}

      <fieldset class="ui-product-variant-picker__option" ref="fieldsets[]"{% if hide_option_name != blank and product_option.name == hide_option_name %} hidden{% endif %}>
        <legend class="ui-product-variant-picker__legend">{{ legend }}</legend>
        {% render 'ui-variant-select',
          label: trigger_label,
          image: trigger_image,
          rows: option_rows,
          class: 'ui-product-variant-picker__select',
          attributes: 'declarative-open'
        %}
      </fieldset>
    {%- endfor -%}

    <script type="application/json">
      {{ product_resource.selected_or_first_available_variant | json }}
    </script>
  </variant-picker>
{%- endunless -%}

{% stylesheet %}
  .ui-product-variant-picker {
    display: flex;
    flex-direction: column;
    gap: 24px;
    width: 100%;
  }

  /*
   * A fieldset carries the grouping the picker element reads its selection out of,
   * so it stays a fieldset and is stripped back to nothing instead of being traded
   * for a div. `min-inline-size: 0` is the one that matters: a fieldset otherwise
   * refuses to shrink below its content and holds the details column open.
   */
  .ui-product-variant-picker__option {
    display: block;
    min-inline-size: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .ui-product-variant-picker__option[hidden] {
    display: none;
  }

  .ui-product-variant-picker__legend {
    padding: 0;
    color: var(--ui-color-black);
    font-family: var(--ui-font-accent);
    font-size: 12px;
    font-weight: 600;
    line-height: 1.35;
    text-transform: uppercase;
  }

  /*
   * The gap sits on the control rather than as a margin under the legend, which
   * is one of the few boxes browsers still lay out to their own rules.
   */
  .ui-product-variant-picker__select {
    margin-block-start: 10px;
  }

  .ui-product-variant-picker--custom .ui-product-variant-picker__duplicate {
    display: none;
  }

  /* Product totals and packaging details must remain visible on narrow screens. */
  .ui-product-variant-picker--custom .ui-variant-item,
  .ui-product-variant-picker--custom .ui-variant-select__trigger {
    height: auto;
    min-height: var(--ui-variant-item-height);
    padding-block: var(--padding-sm);
  }

  .ui-product-variant-picker--custom .ui-variant-item__content,
  .ui-product-variant-picker--custom .ui-variant-select__content {
    flex: 1 1 auto;
  }

  .ui-product-variant-picker--custom .ui-variant-item__label,
  .ui-product-variant-picker--custom .ui-variant-select__label {
    overflow: visible;
    white-space: normal;
    text-overflow: clip;
    overflow-wrap: anywhere;
  }

  .ui-product-variant-picker__choice-name,
  .ui-product-variant-picker__choice-detail {
    display: block;
  }

  .ui-product-variant-picker__choice-detail {
    color: var(--ui-color-gray);
  }

  .ui-product-variant-picker__choice-price {
    white-space: nowrap;
  }
{% endstylesheet %}
