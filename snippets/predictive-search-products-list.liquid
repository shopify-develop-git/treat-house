{%- doc -%}
  Renders retail-visible products for predictive search and recently viewed rows.
  The visible limit applies after exclusions; recently viewed ID order is retained.

  @param {string} title - title of the result list
  @param {object[]} products - array of products
  @param {string[]} [order_ids] - array of product ids
  @param {number} [limit] - limit of visible products to display
  @param {string} [products_test_id] - distinguishes empty state from search results
{%- enddoc -%}
{%- liquid
  assign recently_viewed_title_text = 'content.recently_viewed_products' | t
  assign is_recently_viewed = false
  assign ordered_products = false
  assign card_ref = 'resultsItems[]'
  assign candidates = products
  assign card_limit = limit | default: 8 | plus: 0
  assign visible_count = 0

  if title == recently_viewed_title_text
    assign is_recently_viewed = true
    assign card_ref = 'recentlyViewedItems[]'
    if order_ids != blank
      assign ordered_products = true
      assign candidates = order_ids
    endif
  endif
-%}

{%- capture product_cards -%}
  {%- if card_limit > 0 -%}
    {%- for candidate in candidates -%}
      {%- comment %}<locksmith:6d72>{% endcomment -%}
        {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: candidate, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
      {%- comment %}</locksmith:6d72>{% endcomment -%}
      {%- liquid
        assign product = candidate
        if ordered_products
          assign int_id = candidate | times: 1
          assign product = products | find: 'id', int_id
        endif
      -%}
      {%- if product == blank -%}{%- continue -%}{%- endif -%}
      {%- comment -%}
        Every branch uses the same retail rule, including recently viewed IDs.
        Missing and hidden products do not consume visible slots.
      {%- endcomment -%}
      {%- capture off_channel -%}{% render 'channel-hidden', product: product %}{%- endcapture -%}
      {%- if off_channel != blank -%}{%- continue -%}{%- endif -%}
      <li
        class="predictive-search-results__card predictive-search-results__card--product"
        ref="{{ card_ref }}"
      >
        {% render 'resource-card',
          resource_type: 'product',
          resource: product,
          image_width: 500,
          image_hover: true,
          image_aspect_ratio: '4 / 5'
        %}
      </li>
      {%- assign visible_count = visible_count | plus: 1 -%}
      {%- if visible_count >= card_limit -%}{%- break -%}{%- endif -%}
    {%- endfor -%}
  {%- endif -%}
{%- endcapture -%}

<div
  id="predictive-search-products"
  class="predictive-search-results__products"
  data-visible-count="{{ visible_count }}"
  {% if products_test_id %}data-testid="{{ products_test_id }}"{% endif %}
>
  {%- if is_recently_viewed -%}
    {%- if visible_count > 0 -%}
      <div class="recently-viewed-wrapper" ref="recentlyViewedWrapper">
        <h4 class="predictive-search-results__title" ref="recentlyViewedTitle[]">
          {{ title }}
          <button
            class="predictive-search-results__clear button button-unstyled"
            type="button"
            on:click="/clearRecentlyViewedProducts"
          >
            {{ 'actions.clear' | t }}
          </button>
        </h4>
        <ul
          class="predictive-search-results__list predictive-search-results__wrapper-products list-unstyled"
          role="listbox"
          aria-label="{{ title }}"
        >
          {{- product_cards -}}
        </ul>
      </div>
    {%- endif -%}
  {%- elsif visible_count > 0 -%}
    <h4 class="predictive-search-results__title">{{ title }}</h4>
    <ul
      class="predictive-search-results__list predictive-search-results__wrapper-products list-unstyled"
      role="listbox"
      aria-label="{{ title }}"
    >
      {{- product_cards -}}
    </ul>
  {%- else -%}
    <p class="predictive-search-results__no-results">{{ 'content.no_products_found' | t }}</p>
  {%- endif -%}
</div>

{% stylesheet %}
  .predictive-search-results__products {
    padding-inline: var(--padding-xl);
  }

  .recently-viewed-wrapper {
    display: grid;
    grid-template-rows: auto auto;
    max-height: 1000px;
    opacity: 1;
    overflow: visible;
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    transform-origin: top center;
    transform: translateY(0);
  }

  .recently-viewed-wrapper.removing {
    max-height: 0;
    opacity: 0;
    transform: translateY(-10px);
    transition: max-height 0.35s cubic-bezier(0.4, 0, 0.2, 1), opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1),
      transform 0.25s cubic-bezier(0.4, 0, 0.2, 1);
    pointer-events: none;
  }

  .predictive-search-results__clear.button-unstyled {
    color: var(--color-foreground);
    opacity: 0.68;
    transition: opacity var(--animation-speed-medium) var(--animation-easing);
    padding: 0;
    margin-left: var(--margin-sm);

    &:hover {
      opacity: 1;
    }
  }

  .recently-viewed-wrapper.removing .predictive-search-results__card {
    transition: none;
    transform: none;
    opacity: 1;
  }

  .recently-viewed-wrapper > * {
    transition: opacity 0.25s cubic-bezier(0.4, 0, 0.2, 1);
  }

  .predictive-search-results__wrapper-products .predictive-search-results__card:nth-child(1) {
    animation-delay: 30ms;
  }

  .predictive-search-results__wrapper-products .predictive-search-results__card:nth-child(2) {
    animation-delay: 60ms;
  }

  .predictive-search-results__wrapper-products .predictive-search-results__card:nth-child(3) {
    animation-delay: 90ms;
  }

  .predictive-search-results__wrapper-products .predictive-search-results__card:nth-child(4) {
    animation-delay: 120ms;
  }

  .predictive-search-results__wrapper-products .predictive-search-results__card:nth-child(n + 5) {
    animation-delay: 150ms;
  }

  .predictive-search-results__wrapper-products {
    animation-delay: 50ms;
  }
{% endstylesheet %}
