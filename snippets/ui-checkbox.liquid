{%- doc -%}
  Renders the checkbox indicator from the UI kit (Figma: COMPONENTS → Checkbox).

  This is the 12px box on its own, not a form control — the kit keeps the box and
  the labelled row apart, and so does this snippet. Pair it with a real `<input>`
  in the row component so the input stays the thing that holds state.

  The tick is always in the DOM and hidden with opacity rather than being rendered
  conditionally, so a parent can reveal it from a sibling `:checked` input without
  needing the server to re-render.

  @param {boolean} [checked] - Renders the selected state.
  @param {string} [class] - Additional CSS classes.
  @param {string} [attributes] - Extra HTML attributes to render on the element.

  @example
  {% render 'ui-checkbox' %}
  {% render 'ui-checkbox', checked: true %}
{%- enddoc -%}

<span
  class="ui-checkbox{% if checked %} ui-checkbox--checked{% endif %}{% if class != blank %} {{ class }}{% endif %}"
  aria-hidden="true"
  {%- if attributes != blank %} {{ attributes }}{% endif -%}
>
  <span class="ui-checkbox__tick">{{- 'icon-ui-check.svg' | inline_asset_content -}}</span>
</span>

{% stylesheet %}
  :root {
    --ui-checkbox-size: 12px;
  }

  .ui-checkbox {
    --ui-checkbox-background: transparent;
    --ui-checkbox-tick-opacity: 0;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    flex: 0 0 auto;
    width: var(--ui-checkbox-size);
    height: var(--ui-checkbox-size);
    border-radius: var(--ui-radius-sm);
    box-shadow: inset 0 0 0 1px var(--ui-color-primary);
    background-color: var(--ui-checkbox-background);
    color: var(--ui-color-white);
    transition: background-color var(--animation-values);
  }

  /*
   * The sibling selector is the contract for a real control: put an input
   * immediately before the indicator and the browser drives the state, with
   * no round trip and no JS. The modifier stays for static previews.
   */
  .ui-checkbox--checked,
  :checked + .ui-checkbox {
    --ui-checkbox-background: var(--ui-color-primary);
    --ui-checkbox-tick-opacity: 1;
  }

  .ui-checkbox__tick {
    display: block;
    width: 100%;
    height: 100%;
    opacity: var(--ui-checkbox-tick-opacity);
    transition: opacity var(--animation-values);
  }

  .ui-checkbox__tick > svg {
    display: block;
    width: 100%;
    height: 100%;
  }
{% endstylesheet %}
