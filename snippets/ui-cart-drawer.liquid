{%- doc -%}
  The two panels the cart drawer adds to Horizon's own, and the drawer's whole
  repaint (Figma: 491:17848 — V2).

  Rendered twice from `header-actions.liquid`, once per part, because the file
  puts them in different places and they behave differently: the gift note
  scrolls away with the items, the shipping panel is pinned above the total with
  it. The stylesheet is emitted once however many times the snippet is rendered.

  The note is Shopify's own cart note, not a line property. The file draws one
  message for the order — "printed on our signature card" — and the note is both
  what the design calls it and where a packer already looks on the order. It also
  means the whole thing runs on Horizon's `cart-note.js`: no new script, and a
  visitor with no JavaScript still posts it with the cart form.

  @param {string} part - `gift` or `shipping`.

  @example
  {% render 'ui-cart-drawer', part: 'gift' %}
{%- enddoc -%}

{%- if part == 'gift' and settings.show_cart_gift_note -%}
  <script src="{{ 'cart-note.js' | asset_url }}" type="module" fetchpriority="low"></script>

  {%- liquid
    assign gift_heading = settings.cart_gift_note_heading | default: 'Gift message'
    assign gift_copy = settings.cart_gift_note_copy
    assign gift_button = settings.cart_gift_note_button | default: 'Add gift message'
  -%}

  <cart-note class="ui-gift-note">
    <details class="ui-gift-note__details"{% if cart.note != blank %} open{% endif %}>
      <summary class="ui-gift-note__toggle ui-button ui-button--secondary">
        {{- gift_button -}}
      </summary>

      <div class="ui-gift-note__field">
        {% render 'ui-message',
          label: gift_heading,
          value: cart.note,
          name: 'note',
          id: 'cart-gift-note',
          placeholder: 'Write your message here...',
          attributes: 'form="cart-form" on:input="/updateCartNote"'
        %}
      </div>
    </details>

    <p class="ui-gift-note__heading">
      <span class="ui-gift-note__icon" aria-hidden="true">
        {{- 'icon-ui-envelope.svg' | inline_asset_content -}}
      </span>
      {{ gift_heading }}
    </p>

    {%- if gift_copy != blank -%}
      <p class="ui-gift-note__copy">{{ gift_copy }}</p>
    {%- endif -%}
  </cart-note>
{%- endif -%}

{%- if part == 'shipping' and settings.show_cart_shipping_estimate -%}
  {%- liquid
    assign min_days = settings.cart_delivery_min_days | default: 3
    assign max_days = settings.cart_delivery_max_days | default: 5
    assign now_seconds = 'now' | date: '%s'
    assign from_date = min_days | times: 86400 | plus: now_seconds | date: '%b %-d'
    assign to_date = max_days | times: 86400 | plus: now_seconds | date: '%b %-d'
  -%}

  <div class="ui-cart-shipping">
    <p class="ui-cart-shipping__heading">
      <span class="ui-cart-shipping__icon" aria-hidden="true">
        {{- 'icon-ui-truck.svg' | inline_asset_content -}}
      </span>
      Estimated shipping
    </p>

    {%- if settings.cart_shipping_from != blank -%}
      <p class="ui-cart-shipping__row">
        <span class="ui-cart-shipping__label">Ships from</span>
        <span class="ui-cart-shipping__value">{{ settings.cart_shipping_from }}</span>
      </p>
    {%- endif -%}

    <p class="ui-cart-shipping__row">
      <span class="ui-cart-shipping__label">Estimated delivery</span>
      <span class="ui-cart-shipping__value">{{ from_date }} – {{ to_date }}</span>
    </p>

    {%- if settings.cart_shipping_method != blank -%}
      <p class="ui-cart-shipping__row">
        <span class="ui-cart-shipping__label">Shipping method</span>
        <span class="ui-cart-shipping__value">{{ settings.cart_shipping_method }}</span>
      </p>
    {%- endif -%}
  </div>
{%- endif -%}

{% stylesheet %}
  /*
   * The cart drawer, repainted. Everything here is scoped to the dialog, so
   * Horizon's cart page keeps its own look until that design arrives, and the
   * trigger button outside the dialog stays the header's business.
   */
  .cart-drawer__dialog {
    --ui-cart-drawer-gutter: 24px;

    /* The file draws the panel 510 wide; a narrow phone takes the whole screen. */
    width: min(510px, 100vw);
    max-width: 100vw;
    padding-block-end: var(--ui-cart-drawer-gutter);
    background-color: var(--ui-color-white);
  }

  /* ---------- Header ---------- */

  .cart-drawer__dialog .cart-drawer__header {
    box-sizing: border-box;
    display: flex;
    align-items: center;

    /*
     * Horizon pushes the header's contents to the end, because with an empty
     * cart it held nothing but the close button. It holds the title now.
     */
    justify-content: space-between;
    padding: var(--ui-cart-drawer-gutter);
    border-block-end: var(--ui-hairline-width) solid var(--ui-color-border-gray);
  }

  .cart-drawer__dialog .cart-drawer__heading {
    margin: 0;
    color: var(--ui-color-black);
    font-family: var(--font-heading--family);
    font-size: 30px;

    /* The file sets this one at 700, not the 800 the page headings take. */
    font-weight: 700;
    line-height: 1;
    letter-spacing: normal;
    text-transform: none;
  }

  /* "Your" stays black and the rest of the line is the brand colour. */
  .cart-drawer__dialog .cart-drawer__heading .ui-cart-drawer__count,
  .cart-drawer__dialog .cart-drawer__heading em {
    color: var(--ui-color-primary);
    font-style: normal;
  }

  /*
   * Horizon pins the close to the window's corner with `position: fixed`. The
   * file puts it in the header, on the same line as the title and inside the
   * same 24px inset, so it goes back into the flow.
   */
  .cart-drawer__dialog .cart-drawer__close-button {
    position: static;
    flex: 0 0 auto;
    width: 24px;
    height: 24px;
    margin: 0;
    padding: 0;
    color: var(--ui-color-primary);
  }

  .cart-drawer__dialog .cart-drawer__close-button svg {
    width: 100%;
    height: 100%;
  }

  /*
   * Horizon pads the two scroll containers and the file pads the things inside
   * them. Both is double. The containers give theirs up so the gutter has one
   * source, and every child below sets its own.
   */
  .cart-drawer__dialog .cart-drawer__items,
  .cart-drawer__dialog .cart-drawer__summary {
    padding-inline: 0;
  }

  /* ---------- Lines ---------- */

  /* The file leaves 24 between the header's rule and the first line. */
  .cart-drawer__dialog:not(.cart-drawer--empty) .cart-drawer__items {
    padding-block-start: var(--ui-cart-drawer-gutter);
  }

  .cart-drawer__dialog .cart-items__table-row {
    box-sizing: border-box;
    gap: 16px;
    padding-inline: var(--ui-cart-drawer-gutter);
  }

  /*
   * The file separates the lines with a rule inset from both edges, and closes
   * the list with one that runs the full width.
   */
  .cart-drawer__dialog .cart-items--dividers .cart-items__table-row + .cart-items__table-row {
    border-block-start: var(--ui-hairline-width) solid var(--ui-color-border-gray);
  }

  .cart-drawer__dialog .cart-items__media-container,
  .cart-drawer__dialog .cart-items__media {
    width: 84px;
    height: 84px;
    border-radius: 10px;
  }

  .cart-drawer__dialog .cart-items__media {
    box-sizing: border-box;
    border: 1px solid var(--ui-color-light-blue);
    overflow: hidden;
  }

  .cart-drawer__dialog .cart-items__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }

  .cart-drawer__dialog .cart-items__title {
    color: var(--ui-color-black);
    font-family: var(--font-heading--family);
    font-size: 16px;
    font-weight: 700;
    line-height: 1.1;
    letter-spacing: normal;
    text-transform: none;
  }

  .cart-drawer__dialog .cart-items__price {
    color: var(--ui-color-black);
    font-family: var(--ui-font-body);
    font-size: 14px;
    font-weight: 700;
    line-height: 1;
  }

  .cart-drawer__dialog .cart-items__variants,
  .cart-drawer__dialog .cart-items__properties {
    color: var(--ui-color-gray);
    font-family: var(--ui-font-body);
    font-size: 12px;
    font-weight: var(--ui-font-body-weight);
    line-height: 1.1;
  }

  /*
   * The file sets the value in the medium cut. The theme carries Nunito at 400
   * and 700 only, so a browser resolves 500 down to 400 rather than faking a
   * weight — which is the right failure, and becomes the drawn weight the day
   * the face is added.
   */
  .cart-drawer__dialog .cart-items__variant {
    color: var(--ui-color-black);
    font-size: 12px;
    font-weight: 500;
    line-height: 1.3;
  }

  /*
   * The line's quantity control is Horizon's own, not the kit's stepper — the
   * cart form and its section rendering hang off it, so it is restyled to the
   * 24px trio the file draws rather than swapped for the component.
   */
  .cart-drawer__dialog .quantity-selector {
    /*
     * The theme sizes this control through its own variable, so the width is set
     * by moving that rather than by out-weighing the rule that reads it.
     *
     * Moving it alone is not enough, though. The theme caps the number's width at
     * the control minus two *touch targets* — `--minimum-touch-target`, 44px each
     * — which at the 72px this one is drawn at works out to minus sixteen, and a
     * negative max-width is zero. The number was there the whole time, in a box of
     * no width. The cap is lifted below and the number given the room the two
     * buttons leave.
     */
    --quantity-selector-width: 72px;
    --quantity-selector-button: 24px;

    width: var(--quantity-selector-width);
    height: 24px;
    min-height: 0;
    padding: 0;
    gap: 0;
    border: var(--ui-hairline-width) solid var(--ui-color-black);
    border-radius: var(--ui-radius-sm);
    background-color: var(--ui-color-white);
  }

  .cart-drawer__dialog .quantity-selector button {
    flex: 0 0 auto;
    width: var(--quantity-selector-button);
    min-width: 0;
    height: var(--quantity-selector-button);
    min-height: 0;
    padding: 0;
    color: var(--ui-color-black);
  }

  .cart-drawer__dialog .quantity-selector button svg {
    width: 10px;
    height: 10px;
  }

  .cart-drawer__dialog .quantity-selector input {
    /* Whatever the two buttons leave, rather than a third fixed width: the
       control carries a hairline, so three 24s add up to two pixels more than
       there is. */
    flex: 1 1 auto;
    width: auto;
    min-width: 0;
    max-width: none;
    height: var(--quantity-selector-button);
    padding: 0;
    color: var(--ui-color-black);
    font-family: var(--ui-font-emphasis);
    font-size: 10px;
    font-weight: var(--ui-font-emphasis-weight);
    letter-spacing: -0.1px;
    text-align: center;
  }

  /*
   * Horizon prints the price twice on a line: the line total in the right-hand
   * cell, and the unit price again in grey under the variant. At a quantity of
   * one they are the same number, side by side. The file draws one price, on the
   * right, so the grey one goes.
   *
   * It goes only where it is a repeat, though. That same element carries the sale
   * price and the struck-through compare-at when a line is discounted, and the
   * right-hand cell shows neither — so a line that is actually marked down keeps
   * it. `:has()` rather than a Liquid condition because the markup is Horizon's
   * and this file does not own it.
   *
   * The div has no class of its own, hence `:last-child`: it is the last thing in
   * the details cell, after the title, the variant list and any line discounts.
   */
  .cart-drawer__dialog .cart-items__details > div:last-child:not(:has(.compare-at-price)) {
    display: none;
  }

  .cart-drawer__dialog .cart-items__remove {
    width: 16px;
    height: 16px;
    padding: 0;
    color: var(--ui-color-primary);
  }

  .cart-drawer__dialog .cart-items__remove svg {
    width: 100%;
    height: 100%;
  }

  /* ---------- Gift note ---------- */

  .ui-gift-note {
    display: grid;
    grid-template-areas:
      'heading button'
      'copy    button';
    align-items: center;
    box-sizing: border-box;
    column-gap: 16px;
    margin-inline: var(--ui-cart-drawer-gutter);
    padding: 14px;
    border-radius: var(--ui-radius-sm);
    background-color: var(--ui-color-light-blue);
  }

  .ui-gift-note__heading {
    grid-area: heading;
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0 0 6px;
    color: var(--ui-color-primary);
    font-family: var(--ui-font-accent);
    font-size: 12px;
    font-weight: var(--font-accent--weight-semibold, 600);
    line-height: 1.35;
    text-transform: uppercase;
  }

  .ui-gift-note__icon {
    display: block;
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
  }

  .ui-gift-note__icon > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ui-gift-note__copy {
    grid-area: copy;
    margin: 0;
    max-inline-size: 192px;
    color: var(--ui-color-black);
    font-family: var(--ui-font-body);
    font-size: 12px;
    font-weight: var(--ui-font-body-weight);
    line-height: 1.1;
  }

  /*
   * The details element carries the button and the field, so the two are one
   * control rather than a button that has to find a box to open.
   */
  .ui-gift-note__details {
    grid-area: button;
    justify-self: end;
  }

  .ui-gift-note__details[open] {
    grid-area: 2 / 1 / 3 / 3;
    justify-self: stretch;
    margin-block-start: 10px;
  }

  .ui-gift-note__details[open] .ui-gift-note__toggle {
    display: none;
  }

  /*
   * The summary wears the kit's button classes, so the look is the component's
   * rather than a second copy of it. Reached through the block as well, because
   * base.css colours `summary:hover` directly at one element and one class —
   * which would outweigh the kit's own `color` declaration.
   */
  .ui-gift-note summary.ui-button {
    width: 176px;
    max-width: 100%;
    list-style: none;
    cursor: pointer;
  }

  .ui-gift-note summary.ui-button::-webkit-details-marker {
    display: none;
  }

  .ui-gift-note summary.ui-button:hover {
    color: var(--ui-button-color);
  }

  /* ---------- Estimated shipping ---------- */

  .ui-cart-shipping {
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    gap: 10px;
    margin-inline: var(--ui-cart-drawer-gutter);
    padding: 12px 16px;
    border: 1px solid var(--ui-color-light-blue);
    border-radius: var(--ui-radius-sm);
    background-color: var(--ui-color-white);
  }

  .ui-cart-shipping__heading {
    display: flex;
    align-items: center;
    gap: 4px;
    margin: 0;
    color: var(--ui-color-primary);
    font-family: var(--ui-font-accent);
    font-size: 12px;
    font-weight: var(--font-accent--weight-semibold, 600);
    line-height: 1.35;
    text-transform: uppercase;
  }

  .ui-cart-shipping__icon {
    display: block;
    flex: 0 0 auto;
    width: 16px;
    height: 16px;
  }

  .ui-cart-shipping__icon > svg {
    display: block;
    width: 100%;
    height: 100%;
  }

  .ui-cart-shipping__row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    margin: 0;
  }

  .ui-cart-shipping__label {
    color: var(--ui-color-gray);
    font-family: var(--ui-font-body);
    font-size: 12px;
    font-weight: var(--ui-font-body-weight);
    line-height: 1.1;
  }

  .ui-cart-shipping__value {
    color: var(--ui-color-black);
    font-family: var(--ui-font-body);
    font-size: 14px;
    font-weight: 500;
    line-height: 1.3;
    text-align: end;
  }

  /* ---------- Summary ---------- */

  /*
   * Stretch, not the centring Horizon leaves on it: every panel below is a full
   * width band and a centred column would shrink each one to its own contents.
   */
  .cart-drawer__dialog .cart-drawer__summary {
    display: flex;
    flex-direction: column;
    align-items: stretch;
    gap: var(--ui-cart-drawer-gutter);
  }

  /* Horizon renders its own note inside the summary; the drawer has ours above. */
  .cart-drawer__dialog .cart-drawer__summary .cart-note {
    display: none;
  }

  .cart-drawer__dialog .cart-totals__container,
  .cart-drawer__dialog .cart__ctas,
  .cart-drawer__dialog .cart-actions {
    padding-inline: var(--ui-cart-drawer-gutter);
  }

  /*
   * One rule above the total, and it belongs to the container: the file draws it
   * directly over SUBTOTAL, not over the whole totals block.
   */
  .cart-drawer__dialog .cart-totals__container {
    padding-block-start: var(--ui-cart-drawer-gutter);
    border-block-start: var(--ui-hairline-width) solid var(--ui-color-border-gray);
  }

  /*
   * Horizon draws one of its own across the top of `.cart-totals`, which put two
   * lines twenty pixels apart above the same number. It writes that border in two
   * rules — one scoped to the drawer at (0,4,0), and a looser one conditioned on
   * there being no `.cart-actions`, which started applying the moment the cart
   * note and the discount field were switched off. Both are answered here, the
   * first with its own `:not(:has())` repeated so this weighs (0,5,0), the second
   * on the plain selector. The padding goes with the border, or the block keeps
   * the room the line used to sit in.
   */
  .cart-drawer__dialog .cart-drawer__summary .cart-totals:not(:has(.cart-totals__original-container:empty)),
  .cart-drawer__dialog .cart-drawer__summary .cart-totals {
    margin-block-start: 0;
    padding-block-start: 0;
    border-block-start: none;
  }

  .cart-drawer__dialog .cart-totals__total-label {
    color: var(--ui-color-gray);
    font-family: var(--ui-font-accent);
    font-size: 12px;
    font-weight: var(--font-accent--weight-semibold, 600);
    line-height: 1.35;
    text-transform: uppercase;
  }

  .cart-drawer__dialog .cart-totals__total-value {
    color: var(--ui-color-black);
    font-family: var(--ui-font-body);
    font-size: 24px;
    font-weight: 700;
    line-height: 1;
  }

  .cart-drawer__dialog .cart-totals__tax-note,
  .cart-drawer__dialog .cart-totals__tax-note small {
    color: var(--ui-color-gray);
    font-family: var(--ui-font-body);
    font-size: 14px;
    font-weight: var(--ui-font-body-weight);
    line-height: var(--ui-line-height);
    text-align: center;
  }

  /*
   * The checkout button is the kit's primary, reached by class rather than by
   * rewriting the markup the cart form depends on.
   */
  .cart-drawer__dialog .cart__checkout-button {
    box-sizing: border-box;
    width: 100%;
    height: 44px;
    padding: 14px var(--ui-button-padding-inline, 32px);
    border: none;
    border-radius: var(--ui-radius-sm);
    background-color: var(--ui-color-primary);
    color: var(--ui-color-white);
    font-family: var(--ui-font-accent);
    font-size: 12px;
    font-weight: 500;
    line-height: var(--ui-line-height);
    text-transform: uppercase;
  }

  .cart-drawer__dialog .cart__checkout-button:hover {
    background-color: var(--ui-color-sky-blue);
    color: var(--ui-color-primary);
  }

  /* The amount rides on the label in the drawer only. */
  .cart__checkout-total {
    display: none;
  }

  .cart-drawer__dialog .cart__checkout-total {
    display: inline;
  }

  /* ---------- Empty ---------- */

  /*
   * The file stands the line and its button together in the upper part of the
   * drawer rather than in the middle of it, 200 below the header, and sets the
   * line larger than the drawer's own title.
   */
  .cart-drawer__dialog.cart-drawer--empty .cart-drawer__content {
    display: flex;
    flex-direction: column;
    align-items: center;

    /*
     * Start, not the centring Horizon leaves on it: the file places this group
     * a fixed 200 below the header rather than in the middle of what is left,
     * and centred the padding only moves it further down.
     */
    justify-content: flex-start;
    gap: 32px;
    padding-block-start: 200px;
  }

  /* The message and the button are 32 apart, and the wrapper adds nothing above. */
  .cart-drawer__dialog.cart-drawer--empty .cart-drawer__items {
    margin-block-start: 0;
  }

  .cart-drawer__dialog.cart-drawer--empty .cart-drawer__items,
  .cart-drawer__dialog.cart-drawer--empty .cart-items__wrapper {
    flex: 0 0 auto;
    padding: 0;
  }

  /*
   * Horizon offers a logged-out visitor a sign-in line, and puts it between the
   * message and the button. The file draws the pair with 32 between them and no
   * third thing, so the line moves below the button rather than being dropped:
   * it is worth having, just not in the middle of what the file draws.
   */
  .cart-drawer__dialog.cart-drawer--empty .cart-items__wrapper {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 32px;
  }

  .cart-drawer__dialog.cart-drawer--empty .cart-items__wrapper > p {
    order: 1;
    margin: 0;
    color: var(--ui-color-gray);
    font-family: var(--ui-font-body);
    font-size: 14px;
    line-height: var(--ui-line-height);
    text-align: center;
  }

  .cart-drawer__dialog .cart-drawer__heading--empty {
    display: block;
    margin: 0;
    padding-inline: var(--ui-cart-drawer-gutter);
    font-size: 40px;
    text-align: center;
  }

  /* The button is the kit's primary, at the width the file draws it. */
  .cart-drawer__dialog.cart-drawer--empty .cart-items__empty-button {
    box-sizing: border-box;
    width: 170px;
    max-width: 100%;
    height: 44px;
    margin: 0;
    padding: 14px var(--ui-button-padding-inline, 32px);
    border: none;
    border-radius: var(--ui-radius-sm);
    background-color: var(--ui-color-primary);
    color: var(--ui-color-white);
    font-family: var(--ui-font-accent);
    font-size: 12px;
    font-weight: 500;
    line-height: var(--ui-line-height);
    text-align: center;
    text-transform: uppercase;
  }

  .cart-drawer__dialog.cart-drawer--empty .cart-items__empty-button:hover {
    background-color: var(--ui-color-sky-blue);
    color: var(--ui-color-primary);
  }
{% endstylesheet %}
