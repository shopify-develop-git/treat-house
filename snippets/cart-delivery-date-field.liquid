{%- doc -%}
  ZIP-first delivery estimate with ASAP as the default and an optional later
  request. The calendar stays disabled until the script validates an estimate.

  Rendered by the cart drawer (`ui-cart-drawer`, part `shipping`) and by the
  /cart page (`blocks/_cart-summary`, above the totals); each passes its own
  `picker_id` so `aria-controls` never points at two elements. The panel's CSS lives in
  the stylesheet tag of `ui-cart-drawer.liquid`; those are bundled globally,
  so the rules exist wherever this is rendered.

  ZIP, estimate bounds and delivery mode are handed to the script as data
  attributes. A saved estimate is initially hidden until revalidated. Existing
  server-clock, production-rule and calendar hooks remain shared by both surfaces.

  The script is loaded by `header-actions.liquid` (drawer) and
  `main-cart.liquid` (page), not here: this markup is swapped in through
  section rendering and an inline `<script>` would never run.

  @param {string} [picker_id] - Id for the calendar root. Default `cart-delivery-picker`.

  @example
  {% render 'cart-delivery-date-field', picker_id: 'cart-delivery-picker' %}
{%- enddoc -%}

{%- liquid
  assign picker_id = picker_id | default: 'cart-delivery-picker'

  assign window_days = settings.cart_delivery_max_days | default: 60

  assign now_seconds = 'now' | date: '%s'
  assign current_offset = 'now' | date: '%z'
  assign today_noon = 'now' | date: '%Y-%m-%d' | append: ' 12:00:00 ' | append: current_offset | date: '%s'
  capture dispatch_iso
    render 'th-production-dispatch-date'
  endcapture
  assign dispatch_iso = dispatch_iso | strip
  capture earliest
    render 'th-delivery-earliest-date'
  endcapture
  assign earliest = earliest | strip | default: '9999-12-31'
  assign latest = window_days | times: 86400 | plus: today_noon | date: '%Y-%m-%d'

  assign date_attribute = settings.cart_delivery_attribute | default: 'Requested delivery date'
  assign stored_iso = cart.attributes['_delivery_date'] | default: '' | strip
-%}
{%- capture chosen_iso -%}{% render 'cart-delivery-date-valid' %}{%- endcapture -%}
{%- liquid
  assign chosen_iso = chosen_iso | strip
  assign chosen = ''
  assign stale = false

  if chosen_iso != blank
    assign chosen = cart.attributes[date_attribute] | default: ''
    if chosen == blank
      assign chosen = chosen_iso | append: ' 12:00:00 ' | append: current_offset | date: '%a, %b %-d, %Y'
    endif
  elsif stored_iso != blank
    assign stale = true
  endif

  assign choose_label = 'Choose a later delivery date'
  assign change_label = settings.cart_delivery_change_label | default: 'Change'
  assign delivery_mode = cart.attributes['_delivery_mode'] | default: 'asap'
  unless delivery_mode == 'requested'
    assign delivery_mode = 'asap'
  endunless
  assign zip_value = cart.attributes['Ship-to ZIP'] | default: '' | escape
  assign zip_id = picker_id | append: '-zip'
  assign estimate_status_id = picker_id | append: '-estimate-status'
  assign zip_attributes = 'data-delivery-zip inputmode="numeric" autocomplete="postal-code" maxlength="5" aria-describedby="' | append: estimate_status_id | append: '"'
  assign toggle_attributes = 'data-date-toggle aria-expanded="false" aria-controls="' | append: picker_id | append: '"'
  assign asap_attributes = 'data-delivery-asap'
  unless delivery_mode == 'requested'
    assign asap_attributes = asap_attributes | append: ' hidden'
  endunless
  assign toggle_label = choose_label
  if delivery_mode == 'requested' and chosen != blank
    assign toggle_label = change_label
  endif

  assign disabled_weekdays = settings.cart_delivery_disabled_weekdays | default: '' | replace: ' ', ''
  assign blackout_dates = settings.cart_delivery_blackout_dates | default: '' | strip | newline_to_br | replace: '<br />', ',' | replace: '<br>', ',' | replace: ' ', '' | strip_newlines

  assign confirm_label = 'Save requested date'
  assign cutoff_hour = settings.cart_order_cutoff_hour | default: 17
  assign cutoff_display = cutoff_hour | modulo: 12
  if cutoff_display == 0
    assign cutoff_display = 12
  endif
-%}

<cart-delivery-date
  class="ui-cart-date"
  data-server-now="{{ now_seconds }}"
  data-production-days="{{ settings.cart_production_business_days | default: 1 }}"
  data-cutoff-hour="{{ settings.cart_order_cutoff_hour | default: 17 }}"
  data-production-blackout="{{ settings.cart_production_blackout_dates | escape }}"
  data-zip-states-url="{{ 'th-zip-states.json' | asset_url }}"
  data-transit-blackout="{{ settings.cart_transit_blackout_dates | escape }}"
  data-zip="{{ zip_value }}"
  data-mode="{{ delivery_mode }}"
  data-state="{{ cart.attributes['_delivery_estimate_state'] | escape }}"
  data-estimate-from="{{ cart.attributes['_delivery_estimate_from'] | escape }}"
  data-estimate-to="{{ cart.attributes['_delivery_estimate_to'] | escape }}"
  data-calendar-enabled="{% if settings.show_cart_delivery_date %}true{% else %}false{% endif %}"
  data-window-days="{{ window_days }}"
  data-earliest="{{ earliest }}"
  data-latest="{{ latest }}"
  data-selected="{{ chosen_iso | escape }}"
  data-stored-date="{{ cart.attributes['_delivery_date'] | escape }}"
  data-attribute="{{ date_attribute | escape }}"
  data-choose-label="{{ choose_label | escape }}"
  data-change-label="{{ change_label | escape }}"
  data-disabled-weekdays="{{ disabled_weekdays | escape }}"
  data-blackout="{{ blackout_dates | escape }}"
  {% if stale %}data-stale="true"{% endif %}
>
  <div class="ui-cart-shipping">
    <p class="ui-cart-shipping__heading">
      <span class="ui-cart-shipping__icon" aria-hidden="true">
        {{- 'icon-ui-truck.svg' | inline_asset_content -}}
      </span>
      Where are we shipping?
    </p>

    <div class="ui-cart-estimate__zip-row">
      {% render 'ui-input',
        label: 'Destination ZIP code',
        id: zip_id,
        type: 'text',
        value: zip_value,
        class: 'ui-cart-estimate__zip',
        attributes: zip_attributes
      %}
      {% render 'ui-button',
        variant: 'primary',
        label: 'See estimate',
        type: 'button',
        class: 'ui-cart-estimate__submit',
        attributes: 'data-estimate-submit'
      %}
    </div>
    <p class="ui-cart-estimate__status" id="{{ estimate_status_id }}" data-estimate-status role="status" aria-live="polite"></p>
    <noscript><p class="ui-cart-date__notice">Delivery options are shown at checkout.</p></noscript>

    <div class="ui-cart-estimate__result" data-estimate-result hidden>
      <span class="ui-cart-estimate__label">Estimated arrival</span>
      <strong class="ui-cart-estimate__range" data-estimate-range></strong>
      <span class="ui-cart-estimate__destination" data-estimate-destination></span>
    </div>

    <div class="ui-cart-estimate__delivery">
      <p class="ui-cart-estimate__mode" data-delivery-mode-label>{% if delivery_mode == 'requested' %}Requested delivery date{% else %}As soon as possible{% endif %}</p>
      <div class="ui-cart-request" data-request-summary role="status" aria-live="polite" aria-atomic="true"{% if delivery_mode != 'requested' or chosen == blank %} hidden{% endif %}>
        <span class="ui-cart-request__label" data-request-label>Requested delivery date</span>
        <strong class="ui-cart-request__date" data-date-pill{% if delivery_mode != 'requested' or chosen == blank %} hidden{% endif %}>{{ chosen | escape }}</strong>
        <span class="ui-cart-request__status" data-request-status>Checking your saved request…</span>
      </div>
      {%- if settings.show_cart_delivery_date -%}
        {% render 'ui-button',
          variant: 'secondary',
          label: toggle_label,
          full_width: true,
          type: 'button',
          disabled: true,
          class: 'ui-cart-date__toggle',
          attributes: toggle_attributes
        %}
        {% render 'ui-date-picker',
          id: picker_id,
          class: 'ui-cart-date__picker',
          heading: 'Choose a delivery date',
          description: 'Select a day below, then save your request.',
          confirm_label: confirm_label,
          attributes: 'hidden'
        %}
        <p class="ui-cart-date__error" data-date-error role="alert" hidden>
          {{- 'cart.delivery_date_error' | t -}}
        </p>
      {%- endif -%}
      {% render 'ui-button',
        variant: 'secondary-alt',
        label: 'Ship as soon as possible',
        full_width: true,
        type: 'button',
        class: 'ui-cart-date__asap',
        attributes: asap_attributes
      %}
    </div>

    <p class="ui-cart-estimate__caveat">Estimated ground delivery. Final timing depends on your address and shipping method.</p>

    {%- if settings.show_cart_delivery_date -%}
      {%- if stale -%}
        <p class="ui-cart-date__notice" role="status">{{ 'cart.delivery_date_cleared' | t }}</p>
      {%- endif -%}
    {%- endif -%}

    <details class="ui-cart-transit-map">
      <summary>How delivery estimates work</summary>
      <p>Ships from ZIP 11101, New York.</p>
      <p>Preparation takes {{ settings.cart_production_business_days | default: 1 }} business day{% if settings.cart_production_business_days > 1 %}s{% endif %}. Orders placed at or after {{ cutoff_display }}{% if cutoff_hour >= 12 %}pm{% else %}am{% endif %} Eastern begin processing the next business day.</p>
      <p class="ui-cart-shipping__row" data-dispatch-row {% if dispatch_iso == blank %}hidden{% endif %}>
        <span class="ui-cart-shipping__label">Estimated ship date</span>
        <span class="ui-cart-shipping__value" data-dispatch-date>{% if dispatch_iso != blank %}{{ dispatch_iso | append: ' 12:00:00 ' | append: current_offset | date: '%a, %b %-d, %Y' }}{% endif %}</span>
      </p>
      <a href="{{ 'th-ground-delivery-map.webp' | asset_url }}" target="_blank" rel="noopener" aria-label="Open the ground transit map at full size">
        <img src="{{ 'th-ground-delivery-map.webp' | asset_url }}" width="1977" height="1111" loading="lazy" alt="Treat House ground transit map showing estimated transit zones from one to six days across the United States">
      </a>
      <p class="ui-cart-estimate__attribution">ZIP lookup adapted from <a href="https://www.geonames.org/" target="_blank" rel="noopener">GeoNames</a>, <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener">CC BY 4.0</a>.</p>
    </details>
  </div>

</cart-delivery-date>
