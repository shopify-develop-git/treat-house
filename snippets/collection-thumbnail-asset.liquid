{%- doc -%}
  Approved September 4 client photography bundled with this draft, without
  changing shared collection images on the live store. A collection's
  custom.card_image file metafield overrides these defaults for future updates.
  @param {object} collection - The collection being pictured.
{%- enddoc -%}
{%- if collection.metafields.custom.card_image.value == blank -%}
  {%- case collection.handle -%}
    {%- when 'get-well' -%}th-get-well-single-treat.webp
    {%- when 'congratulations' -%}th-congrats-single-treat.webp
    {%- when 'thanksgiving' -%}th-thanksgiving-four-treats.webp
    {%- when 'halloween' -%}th-halloween-eyeball-single-treat.webp
  {%- endcase -%}
{%- endif -%}
