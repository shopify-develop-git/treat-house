{%- doc -%}
  One line of the builder's review: what was chosen, under a tinted label strip
  with the way back to change it.

  The control is a real `<button>` rather than a link. It moves the reader to a
  step of a form they are already inside; a link would put a second history entry
  in the way of the back button, which in a four-step builder is the one control
  the reader is most likely to reach for.

  @param {string} label - What this line is: Flavors, Quantity, Packaging.
  @param {string} value - What was chosen. Shows an em dash when empty.
  @param {string} [edit_label] - Text for the control. Defaults to the theme's Edit.
  @param {string} [edit_step] - The step it goes back to, read by the builder's script.
  @param {string} [class] - Additional CSS classes.

  @example
  {% render 'ui-review-row', label: 'Quantity', value: '12 Pack', edit_step: '1' %}
{%- enddoc -%}

<div class="ui-review-row {{ class }}">
  <div class="ui-review-row__head">
    <span class="ui-review-row__label">{{ label }}</span>
    {%- if edit_step != blank -%}
      <button
        type="button"
        class="ui-review-row__edit"
        data-step-link="{{ edit_step }}"
      >
        {{- edit_label | default: 'actions.edit' | t -}}
      </button>
    {%- endif -%}
  </div>
  <p class="ui-review-row__value">
    {%- if value != blank -%}{{ value }}{%- else -%}&mdash;{%- endif -%}
  </p>
</div>

{% stylesheet %}
  .ui-review-row {
    border: 1px solid var(--ui-color-border-gray);
    border-radius: var(--ui-radius-sm);
    overflow: hidden;
  }

  .ui-review-row__head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 16px;
    padding: 8px 16px;
    background-color: rgb(var(--ui-color-gray-rgb, 85 85 85) / 0.04);
  }

  .ui-review-row__label {
    font-family: var(--ui-font-body);
    font-size: 12px;
    line-height: 1.1;
    color: var(--ui-color-gray);
  }

  .ui-review-row__edit {
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--ui-font-accent);
    font-size: 12px;
    font-weight: var(--font-accent--weight-semibold, 600);
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--ui-color-primary);
    cursor: pointer;
  }

  .ui-review-row__edit:hover {
    text-decoration: underline;
  }

  .ui-review-row__value {
    margin: 0;
    padding: 12px 16px;
    font-family: var(--ui-font-body);
    font-size: 16px;
    line-height: 1.3;
    color: var(--color-foreground-heading);
  }
{% endstylesheet %}
