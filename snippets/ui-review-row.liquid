{%- doc -%}
  One line of the builder's review: what was chosen, with the way back to change
  it. A white box, the label and the choice stacked in a column on the left, Edit
  against the top right (Figma 508:9868).

  The control is a real `<button>` rather than a link. It moves the reader to a
  step of a form they are already inside; a link would put a second history entry
  in the way of the back button, which in a four-step builder is the one control
  the reader is most likely to reach for.

  @param {string} label - What this line is: Flavors, Quantity, Packaging.
  @param {string} value - What was chosen. Shows an em dash when empty.
  @param {string} [edit_label] - Text for the control. Defaults to the theme's Edit.
  @param {string} [edit_step] - The step it goes back to, read by the builder's script.
  @param {string} [class] - Additional CSS classes.

  @example
  {% render 'ui-review-row', label: 'Quantity', value: '12 Pack', edit_step: '1' %}
{%- enddoc -%}

<div class="ui-review-row {{ class }}">
  <div class="ui-review-row__text">
    <span class="ui-review-row__label">{{ label }}</span>
    <p class="ui-review-row__value">
      {%- if value != blank -%}{{ value }}{%- else -%}&mdash;{%- endif -%}
    </p>
  </div>
  {%- if edit_step != blank -%}
    <button
      type="button"
      class="ui-review-row__edit"
      data-step-link="{{ edit_step }}"
    >
      {{- edit_label | default: 'actions.edit' | t -}}
    </button>
  {%- endif -%}
</div>

{% stylesheet %}
  .ui-review-row {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 16px;
    padding: 12px 16px;
    border: 1px solid var(--ui-color-border-gray);
    border-radius: var(--ui-radius-sm);
    background-color: var(--ui-color-white);
  }

  /* The column takes the room and lets the value wrap inside it. The file draws
     every value on one line, but a flavour list is as long as the reader made it,
     and without `min-inline-size` a flex item refuses to shrink past its content
     and pushes Edit off the row instead. */
  .ui-review-row__text {
    display: flex;
    flex: 1 1 auto;
    flex-direction: column;
    gap: 12px;
    min-inline-size: 0;
  }

  .ui-review-row__label {
    font-family: var(--ui-font-body);
    font-weight: var(--ui-font-body-weight);
    font-size: 12px;
    line-height: 1.1;
    color: var(--ui-color-gray);
  }

  .ui-review-row__value {
    margin: 0;
    font-family: var(--ui-font-emphasis);
    font-weight: var(--ui-font-emphasis-weight);
    font-size: 14px;
    line-height: 1.3;
    color: var(--ui-color-black);
  }

  /* Outfit Medium, which is the weight the theme loads as the accent face — the
     kit's buttons ask for the semibold, this asks for the base. */
  .ui-review-row__edit {
    flex: 0 0 auto;
    padding: 0;
    border: 0;
    background: none;
    font-family: var(--ui-font-accent);
    font-size: 12px;
    font-weight: var(--font-accent--weight, 500);
    line-height: 1.3;
    text-transform: uppercase;
    color: var(--ui-color-primary);
    cursor: pointer;
  }

  .ui-review-row__edit:hover {
    text-decoration: underline;
  }
{% endstylesheet %}
