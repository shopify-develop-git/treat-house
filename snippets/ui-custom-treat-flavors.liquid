{%- doc -%}
  Restores the published custom-treat flavor property, separate from the box builder.
  The nine standard values and property key match the published product form.
  The September 10 client call confirms standard flavors only for custom treats.
  Where present, the native Standard Flavor option remains the price authority.
  Existing packaging/customization variants remain the source of price and stock.

  @param {object} product_resource - The custom-treat product.
  @param {string} option_name - The native flavor option to synchronize.
{%- enddoc -%}
{%- liquid
  assign standard_flavors = 'Assorted Treats|S’Mores|M&M|Caramel Sea Salt|Birthday Cake|Classic Salted Butter|Chocolate Peanut Butter|Nut Free Assortment|GF, NF, DF Assortment'
  assign selected_flavor = ''
  assign native_flavor = product_resource.options_with_values | where: 'name', option_name | first
  assign flavor_index = native_flavor.position | minus: 1
  assign flavor_id = 'ui-custom-treat-flavor-' | append: section.id
  assign form_id = 'ui-product-form-' | append: section.id
  assign flavor_attributes = 'form="' | append: form_id | append: '" aria-describedby="' | append: flavor_id | append: '-status"'
-%}
<ui-custom-treat-flavors{% if native_flavor != blank %} data-flavor-index="{{ flavor_index }}"{% endif %} data-standard-value="Standard Flavor">
    {% render 'ui-select',
      label: 'Choose your flavor',
      placeholder: 'Choose your flavor',
      options: standard_flavors,
      option_delimiter: '|',
      selected: selected_flavor,
      name: 'properties[Standard Flavour]',
      id: flavor_id,
      required: true,
      attributes: flavor_attributes
    %}
    <script type="application/json" data-standard-flavors>{{ standard_flavors | split: '|' | json }}</script>
    <p id="{{ flavor_id }}-status" data-flavor-status role="status"></p>
  </ui-custom-treat-flavors>
  <script src="{{ 'ui-custom-treat-flavors.js' | asset_url }}" type="module"></script>

{% stylesheet %}
  ui-custom-treat-flavors { display: block; }
  ui-custom-treat-flavors [data-flavor-status] {
    margin-block: 8px 0;
    color: var(--ui-color-error);
    font-family: var(--ui-font-body);
    font-size: 14px;
  }
  ui-custom-treat-flavors [data-flavor-status]:empty { display: none; }
{% endstylesheet %}
