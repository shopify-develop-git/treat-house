{%- doc -%}
  Renders the radio indicator from the UI kit (Figma: COMPONENTS → Radio).

  Like [ui-checkbox], this is the 12px circle on its own rather than a form
  control. The selected dot is a 6px circle drawn in CSS: the kit exports it as a
  vector, but it is `circle cx=6 cy=6 r=3` — geometry the browser reproduces
  exactly, so an asset would only add a request.

  @param {boolean} [checked] - Renders the selected state.
  @param {string} [class] - Additional CSS classes.
  @param {string} [attributes] - Extra HTML attributes to render on the element.

  @example
  {% render 'ui-radio' %}
  {% render 'ui-radio', checked: true %}
{%- enddoc -%}

<span
  class="ui-radio{% if checked %} ui-radio--checked{% endif %}{% if class != blank %} {{ class }}{% endif %}"
  aria-hidden="true"
  {%- if attributes != blank %} {{ attributes }}{% endif -%}
>
  <span class="ui-radio__dot"></span>
</span>

{% stylesheet %}
  :root {
    --ui-radio-size: 12px;
    --ui-radio-dot-size: 6px;
  }

  .ui-radio {
    --ui-radio-dot-opacity: 0;

    display: inline-flex;
    align-items: center;
    justify-content: center;
    box-sizing: border-box;
    flex: 0 0 auto;
    width: var(--ui-radio-size);
    height: var(--ui-radio-size);
    border-radius: 50%;
    box-shadow: inset 0 0 0 1px var(--ui-color-primary);
  }

  /*
   * The sibling selector is the contract for a real control: put an input
   * immediately before the indicator and the browser drives the state, with
   * no round trip and no JS. The modifier stays for static previews.
   */
  .ui-radio--checked,
  :checked + .ui-radio {
    --ui-radio-dot-opacity: 1;
  }

  .ui-radio__dot {
    display: block;
    flex: 0 0 auto;
    width: var(--ui-radio-dot-size);
    height: var(--ui-radio-dot-size);
    border-radius: 50%;
    background-color: var(--ui-color-primary);
    opacity: var(--ui-radio-dot-opacity);
    transition: opacity var(--animation-values);
  }
{% endstylesheet %}
