{%- doc -%}
  Renders a product card (Figma: Best Sellers → Product Card).

  The file draws this one inside the Bestsellers section rather than in the kit,
  but it is a card like any other — same hairline frame, same 2px corner, same 1px
  top inset as ui-collection-card — and the next product grid will want it, so it
  lives here.

  The whole card is clickable through a stretched link on the title rather than by
  wrapping everything in an `<a>`: the basket is a button, and a button inside a
  link is not valid markup. The price row is raised above the stretched link so the
  basket still takes its own clicks.

  The basket is `ui-button`'s `basket` variant — the file uses the very same
  component here as in the BUTTONS section.

  The badge takes whatever colour it is given and writes white on it. That is the
  house rule rather than a measured one: the badge is read as a brand mark and is
  drawn white in the file at every colour it appears in. Contrast is therefore the
  caller's to keep — white reads 9.83:1 on the kit's purple but 1.53:1 on its sky
  blue, and 12px text wants 4.5:1 — so a light badge colour wants
  `badge_text_color` set to something darker rather than being left to the default.

  @param {string} title - The product name.
  @param {string} [subtitle] - The supporting line under it.
  @param {string} [price] - Formatted price. Pass it already formatted, so the card stays out of money filters.
  @param {object} [image] - A Shopify image object for the media box.
  @param {string} [loading] - `lazy` (the default) or `eager`. A grid of these is
    mostly below the fold, but the first row is not — the caller that knows how
    many fit across says so for those.
  @param {string} [link] - The product URL. Without it the card is not clickable.
  @param {string} [badge] - Badge text, shown over the top-left of the media.
  @param {string} [badge_color] - Background colour for the badge, any CSS colour. Defaults to the kit purple.
  @param {string} [badge_text_color] - Text colour for the badge, any CSS colour. Defaults to white.
  @param {string} [season_label] - Set when the product is seasonal and not on sale (see [season-status]).
    Draws a ribbon across the foot of the media carrying these words and quietens
    the photograph. The link to the product page keeps working.
  @param {boolean} [show_add] - Renders the basket button. Defaults to true.
  @param {string} [add_label] - Accessible label for the basket. Defaults to the theme's add-to-cart string.
  @param {string} [add_attributes] - Extra HTML attributes for the basket button, for wiring it to a form.
  @param {string} [add_content] - Ready-made markup to stand in the basket's place. Pass a real add-to-cart control here; the card keeps drawing the square around it.
  @param {string} [class] - Additional CSS classes.
  @param {string} [attributes] - Extra HTML attributes to render on the card.

  @example
  {% render 'ui-product-card',
    title: product.title,
    subtitle: product.description | strip_html | truncatewords: 15,
    price: product.price | money,
    image: product.featured_image,
    link: product.url,
    badge: 'Bestsellers',
    badge_color: '#ea6f36'
  %}
{%- enddoc -%}

{%- liquid
  assign badge_background = badge_color | default: '#6c276a'
  assign badge_foreground = badge_text_color | default: '#ffffff'
  assign basket_label = add_label
  if basket_label == blank
    assign basket_label = 'actions.add_to_cart' | t
  endif

  assign card_loading = loading | default: 'lazy'

  assign card_classes = 'ui-product-card'
  if season_label != blank
    assign card_classes = card_classes | append: ' ui-product-card--season'
  endif
  if class != blank
    assign card_classes = card_classes | append: ' ' | append: class
  endif
-%}

{%- comment -%}
  Shopify hands back the product's own name as an image's `alt` when the merchant
  has not written one, so the supplier code arrives here too — spoken by a screen
  reader, and printed on the page whenever the photograph fails to load.
{%- endcomment -%}
{%- capture image_alt -%}{% render 'strip-hidden-words', title: image.alt %}{%- endcapture -%}
{%- assign image_alt = image_alt | strip -%}
{%- assign card_product_handle = '' -%}
{%- if link contains '/products/' -%}
  {%- assign card_product_handle = link | split: '/products/' | last | split: '?' | first | split: '#' | first | split: '/' | first -%}
{%- endif -%}
{%- capture card_image_asset -%}{% render 'product-image-asset', handle: card_product_handle, image: image %}{%- endcapture -%}
{%- assign card_image_asset = card_image_asset | strip -%}

<article class="{{ card_classes }}"{% if attributes != blank %} {{ attributes }}{% endif %}>
  <div class="ui-product-card__media">
    {%- if card_image_asset != blank -%}
      <img
        src="{{ card_image_asset | asset_url }}"
        width="1200"
        height="1200"
        class="ui-product-card__image"
        loading="{{ card_loading }}"
        alt="{{ image_alt | default: title | escape }}"
      >
    {%- elsif image != blank -%}
      {%- comment -%}
        Width descriptors and `sizes`, not the 1x/2x/3x that [image] hands out. That
        srcset describes one drawn size, and this box has several: it is a share of
        a grid that runs two, three and four across. Asked for a height instead, the
        snippet fell back to the file's own — a 1720px original behind a 215px box.

        The `sizes` errs high on purpose. Too small is a blurry card; too large is a
        few kilobytes. The floor is the carousel's fixed 240px card, which a plain
        50vw would under-serve on a phone.
      {%- endcomment -%}
      {{
        image
        | image_url: width: 960
        | image_tag:
          widths: '200, 260, 320, 400, 480, 600, 760, 960',
          sizes: '(min-width: 1200px) 320px, (min-width: 750px) 33vw, max(50vw, 240px)',
          class: 'ui-product-card__image',
          loading: card_loading,
          alt: image_alt
      }}
    {%- else -%}
      {{ 'product-1' | placeholder_svg_tag: 'ui-product-card__image ui-product-card__image--placeholder' }}
    {%- endif -%}
    {%- if season_label != blank -%}
      <span class="ui-product-card__season-ribbon">{{ season_label }}</span>
    {%- endif -%}
  </div>

  <div class="ui-product-card__body">
    <h3 class="ui-product-card__title">
      {%- capture title_shown -%}{% render 'strip-hidden-words', title: title %}{%- endcapture -%}
      {%- assign title_shown = title_shown | strip -%}
      {%- if link != blank -%}
        <a class="ui-product-card__link" href="{{ link }}">{{ title_shown }}</a>
      {%- else -%}
        {{ title_shown }}
      {%- endif -%}
    </h3>
    {%- comment -%}
      Printed even when there is nothing to print. The line holds two rows open in
      CSS, and a box that is not in the markup holds nothing — leave it out on the
      67 products with no description and those cards come up short, putting their
      prices above their neighbours' in the same row. Empty, it keeps the shape.
    {%- endcomment -%}
    <p class="ui-product-card__subtitle">{{ subtitle }}</p>
  </div>

  {%- if price != blank or show_add != false or add_content != blank -%}
    <div class="ui-product-card__price-row">
      <span class="ui-product-card__price">{{ price }}</span>
      {%- if add_content != blank -%}
        {{ add_content }}
      {%- elsif show_add != false -%}
        {% render 'ui-button',
          variant: 'basket',
          label: basket_label,
          class: 'ui-product-card__add',
          attributes: add_attributes
        %}
      {%- endif -%}
    </div>
  {%- endif -%}

  {%- if badge != blank -%}
    <span
      class="ui-product-card__badge"
      style="--ui-product-card-badge-background: {{ badge_background }}; --ui-product-card-badge-text: {{ badge_foreground }};"
    >{{ badge }}</span>
  {%- endif -%}
</article>

{% stylesheet %}
  :root {
    --ui-product-card-media-ratio: 240 / 215;
    --ui-product-card-body-padding: 14px;
    --ui-product-card-body-gap: 6px;
    --ui-product-card-price-padding-block: 12px;
    --ui-product-card-badge-inset: 9.5px;
  }

  .ui-product-card {
    --ui-product-card-border-color: var(--ui-color-border-gray);
    --ui-product-card-border-width: var(--ui-hairline-width);

    position: relative;
    display: flex;
    flex-direction: column;
    box-sizing: border-box;
    width: 100%;

    /* The file offsets the media a pixel from the top edge, as the collection card does. */
    padding-block-start: 1px;
    border-radius: var(--ui-radius-sm);

    background-color: var(--ui-color-white);
  }

  /*
   * The ring gets a layer of its own instead of being the card's own inset
   * shadow. An inset shadow is painted under the element's children, and the
   * photograph runs to three of the card's edges, so the ring survived along the
   * 1px strip above the media and nowhere else — invisible while it was the
   * hairline, plainly broken the moment hover thickened it to a full pixel.
   *
   * A positioned pseudo-element is painted after the static children, and being
   * inset it still costs the layout nothing when it thickens, which is why the
   * card is not simply given a border.
   */
  .ui-product-card::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
    box-shadow: inset 0 0 0 var(--ui-product-card-border-width) var(--ui-product-card-border-color);
    transition: box-shadow var(--animation-values);
    pointer-events: none;
  }

  .ui-product-card:is(:hover, :focus-within, .ui-product-card--force-hover) {
    --ui-product-card-border-color: var(--ui-color-primary);
    --ui-product-card-border-width: 1px;
  }

  /*
   * The ratio is kept, not merely started from. The media used to be `flex: 1 1
   * auto` so a stretched row could take its slack out of the photograph, which
   * held every card in the row to one height — but it also meant a two-line title
   * shortened its own image, so the pictures in a row came out different heights
   * and the titles under them started at different places. A grid of photographs
   * that do not line up reads as a mistake before anyone notices why.
   *
   * So the media is the fixed part now and the copy takes the slack: same width
   * and same ratio gives every card in a row the same picture and the same first
   * baseline, and the card still fills its cell because the body grows instead.
   */
  /*
   * Positioned, because the season ribbon inside it is laid out against its foot.
   * Without this the nearest positioned ancestor is the card, so `inset-block-end:
   * 0` put the ribbon across the bottom of the whole card — over the price row,
   * and outside the media's `overflow: hidden`, so it ran past the rounded corners
   * the card is cut to. Positioning the media makes it the ribbon's containing
   * block, which both drops the ribbon onto the picture where the file draws it
   * and brings it back inside the clip.
   */
  .ui-product-card__media {
    position: relative;
    display: block;
    flex: 0 0 auto;
    aspect-ratio: var(--ui-product-card-media-ratio);
    overflow: hidden;
  }

  /*
   * Contained, not cropped. Now that the box holds its ratio rather than bending
   * to the copy, a photograph whose own proportion differs from 240/215 has to
   * give something up — and `cover` takes it off the edges, which on a treat shot
   * square-on is the treat. Letterboxing on the card's own white is the quieter
   * loss: the product arrives whole, and a catalogue photographed against white
   * shows no seam where the picture stops.
   */
  .ui-product-card__image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  /* Grows into whatever a stretched row leaves over, so the price row stays on the
     card's bottom edge and the copy stays at the top of its own box. */
  /*
   * No longer grows. It used to, so that the price row was pushed onto the card's
   * floor and every price in a row lined up — but the growth is where the empty
   * space came from, and on a card with nothing to say it was all of it.
   *
   * With the name and the description both reserving their lines, the cards come
   * out the same height on their own and the prices line up without anything
   * being stretched to make them.
   */
  .ui-product-card__body {
    display: flex;
    flex-direction: column;
    gap: var(--ui-product-card-body-gap);
    padding: var(--ui-product-card-body-padding);
  }

  /*
   * Two lines, whether the name needs them or not. A row of cards is read across
   * as much as down — the names on one line, the descriptions on the next — and a
   * one-line name broke that: "Candy Corn Party Bar" started its description
   * 18px above "Box of 12 Jumbo Candy Corn Treats" did, so no two cards in the
   * row agreed on where anything after the name began.
   *
   * The floor holds the short names down and the clamp holds the long ones up, so
   * it takes both. Two is the number because it is what the longest name in the
   * catalogue takes at the card's narrowest, and it is the same count the
   * description below is already clamped to.
   *
   * `lh` is exactly the line box this element draws; `2.2em` is the same sum
   * arithmetically — two lines of the 1.1 above — kept for anything that has not
   * got the unit.
   */
  .ui-product-card__title {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    /*
     * Room for three lines, two of them reserved.
     *
     * The two are separate decisions. The clamp is how long a name may run before
     * it is cut, and capitals need three: at two, 15 of 23 names on the collection
     * came out short. The reserve is how much every card holds open so the
     * descriptions under them start level, and that wants the length names
     * actually use — of those 23, eight run to one line, fourteen to two, and one
     * to three. Reserving the third for that one left a line of nothing under
     * every short name, which is what "too much space" meant.
     *
     * The prices stay level regardless: `.ui-product-card__body` grows, so the
     * price row sits on the card's floor whatever the name above it does.
     */
    -webkit-line-clamp: 3;
    line-clamp: 3;
    overflow: hidden;
    min-block-size: 2.2em;
    min-block-size: 2lh;
    margin: 0;
    font-family: var(--ui-font-body);
    font-weight: 700;
    font-size: 16px;
    line-height: 1.1;
    /*
     * Capitals, which is the one case CSS can actually deliver on this catalogue.
     * `capitalize` left the shouting names shouting — it raises a first letter and
     * cannot lower anything — so half the grid stayed loud beside the half it had
     * tidied. Up is a direction every name can go, so every name goes there and
     * the row reads as one set.
     */
    text-transform: uppercase;
    color: var(--ui-color-black);
  }

  .ui-product-card__link {
    color: inherit;
    text-decoration: none;
  }

  /* One link covering the card, so the card is clickable without nesting the
     basket button inside an anchor. */
  .ui-product-card__link::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: var(--ui-radius-sm);
  }

  /*
   * Clamped in lines rather than cut in words. How many words fit is a function of
   * the card's width, and that runs from 171px on a phone to 305px on a desktop —
   * so a word count that reads well at one size overflows at the other. Lines are
   * what actually break the grid, so lines are what is capped.
   */
  /*
   * Two lines, and two reserved, for the same reason the name above reserves its
   * own: a row is read across, and 67 of the shop's 217 products carry no
   * description at all. Left to size itself, a card without one ended 56px above
   * its price where its neighbour ended 14px — the same row, one card with a hole
   * in it. Reserved, the blank is the shape of a description rather than a gap of
   * some other size, and every card in the row is built the same way.
   */
  .ui-product-card__subtitle {
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
    min-block-size: 2.6em;
    min-block-size: 2lh;
    margin: 0;
    font-family: var(--ui-font-body);
    font-weight: var(--ui-font-body-weight);
    font-size: 14px;
    line-height: 1.3;
    color: var(--ui-color-gray);
  }

  /*
   * `base.css` hides every empty paragraph — `p:empty { display: none }` — which
   * takes the reserved box away on exactly the cards that need it, the ones with
   * no description. Put back, so the space the rule above holds open survives
   * having nothing in it.
   */
  .ui-product-card__subtitle:empty {
    display: -webkit-box;
  }

  /*
   * A card given a real add-to-cart control wears the kit's own basket button,
   * so there is no theme styling to undo here — see [ui-product-card-add], which
   * renders it. What is left is the scaffolding Shopify's form machinery insists
   * on: a custom element, a form, another custom element. `display: contents`
   * takes all three out of the layout so the button itself becomes the price
   * row's second item, and the button still belongs to the form, which is a
   * matter of markup rather than of boxes.
   */
  .ui-product-card__price-row :is(product-form-component, form, add-to-cart-component) {
    display: contents;
  }

  .ui-product-card__price-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: var(--ui-product-card-price-padding-block) 12px
      var(--ui-product-card-price-padding-block) var(--ui-product-card-body-padding);

    /* Above the stretched link, or the basket would never receive a click. */
    position: relative;
    z-index: 1;
  }

  .ui-product-card__price {
    font-family: var(--ui-font-body);
    font-weight: 700;
    font-size: 14px;
    line-height: 1;
    text-transform: uppercase;
    color: var(--ui-color-black);
  }

  /*
   * A seasonal product that is not on sale. The photograph is quietened rather
   * than greyed — it is still the treat, just not this month's — and a ribbon
   * across the foot of the media says why the basket is gone. The pill that
   * stands in the basket's square is the kit's secondary button in its disabled
   * state, sized down to the price row.
   */
  .ui-product-card--season .ui-product-card__image {
    opacity: 0.72;
  }

  .ui-product-card__season-ribbon {
    position: absolute;
    inset-block-end: 0;
    inset-inline: 0;
    z-index: 1;
    padding: 6px 8px;
    background-color: var(--ui-color-primary);
    font-family: var(--ui-font-accent);
    font-weight: var(--font-accent--weight-semibold, 600);
    font-size: 12px;
    line-height: 1.35;
    letter-spacing: 0.02em;
    text-align: center;
    text-transform: uppercase;
    color: var(--ui-color-white);
  }

  .ui-product-card__price-row .ui-product-card__season {
    flex: 0 1 auto;
    min-width: 0;
    padding: 6px 10px;
    font-size: 11px;
    line-height: 1.2;
    white-space: normal;
    text-align: center;
  }

  .ui-product-card__badge {
    --ui-product-card-badge-background: var(--ui-color-primary);
    --ui-product-card-badge-text: var(--ui-color-white);

    position: absolute;
    inset-block-start: var(--ui-product-card-badge-inset);
    inset-inline-start: var(--ui-product-card-badge-inset);
    z-index: 1;
    padding: 4px 8px;
    border-radius: var(--ui-radius-sm);
    background-color: var(--ui-product-card-badge-background);
    font-family: var(--ui-font-accent);
    font-weight: var(--font-accent--weight-semibold, 600);
    font-size: 12px;
    line-height: 1.35;
    text-transform: uppercase;
    color: var(--ui-product-card-badge-text);
  }

{% endstylesheet %}
