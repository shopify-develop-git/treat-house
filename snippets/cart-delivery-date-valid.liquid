{%- doc -%}
  Echoes an explicitly requested, still-eligible delivery date. ASAP has no
  date requirement. The shared minimum uses destination transit after current
  production; weekends, transit closures and unavailable arrival dates are
  excluded. Used by the panel, cart form and checkout gate after every morph.
{%- enddoc -%}
{%- liquid
  assign window_days = settings.cart_delivery_max_days | default: 60
  assign current_offset = 'now' | date: '%z'
  assign today_noon = 'now' | date: '%Y-%m-%d' | append: ' 12:00:00 ' | append: current_offset | date: '%s'
  assign latest = window_days | times: 86400 | plus: today_noon | date: '%Y-%m-%d'
  capture earliest
    render 'th-delivery-earliest-date'
  endcapture
  assign earliest = earliest | strip
  assign iso = cart.attributes['_delivery_date'] | default: '' | strip
  assign valid = false
  if cart.attributes['_delivery_mode'] == 'requested' and cart.attributes['_delivery_date_type'] == 'requested' and earliest != blank and iso.size == 10 and iso >= earliest and iso <= latest
    assign valid = true
    assign date_anchor = iso | append: ' 12:00:00 ' | append: current_offset
    assign weekday = date_anchor | date: '%w'
    assign normalized_iso = date_anchor | date: '%Y-%m-%d'
    if weekday.size != 1 or normalized_iso != iso or weekday == '0' or weekday == '6'
      assign valid = false
    endif
    assign disabled_weekdays = settings.cart_delivery_disabled_weekdays | default: '' | replace: ' ', '' | split: ','
    if disabled_weekdays contains weekday
      assign valid = false
    endif
    assign blackout_raw = settings.cart_delivery_blackout_dates | default: '' | append: ',' | append: settings.cart_transit_blackout_dates | strip | newline_to_br | replace: '<br />', ',' | replace: '<br>', ','
    assign blackout = blackout_raw | split: ','
    assign blackout_batches = blackout.size | divided_by: 50 | plus: 1
    if blackout_batches > 50
      assign valid = false
    else
      for blackout_batch in (1..blackout_batches)
        assign blackout_offset = blackout_batch | minus: 1 | times: 50
        for day in blackout offset: blackout_offset limit: 50
          assign clean = day | strip
          if clean == iso
            assign valid = false
            break
          endif
        endfor
        unless valid
          break
        endunless
      endfor
    endif
  endif
  if valid
    echo iso
  endif
-%}
