{%- doc -%}
  The basket on a product card, wired to the cart.

  [ui-product-card] draws this square but cannot fill it: a card is given a title
  and a price and knows nothing about variants or forms. This snippet is the
  filling, and it is what a product row passes as the card's `add_content`.

  The button is the submit of a real `product` form inside
  `<product-form-component>`, so a click posts to the cart and the drawer opens.
  Same seam as [_ui-product-buy] on the product page — `ref="variantId"`,
  `ref="liveRegion"`, and `ref="addToCartButton"` inside an
  `<add-to-cart-component>`.

  **What it adds is the variant the card is priced at.** A card prints one price,
  `product.price`, which is the cheapest variant's; the basket adds the first
  available variant at that price, preserving Shopify's option order. If none is
  available at that price, the card opens the product's options instead.
  In this catalogue a treat box's options are paid extras — a gift box at $6,
  individual packs at $3, half or all of the treats made custom — so the default
  combination is the plain box at the price on the card, and there is nothing
  being chosen on the shopper's behalf. That held for all ten products in the
  homepage rows when this was written, and it is the rule to check against if a
  row is ever pointed at products whose options are alternatives rather than
  add-ons: then the card's price and the card's button would still agree with each
  other, but neither would be the whole story, and the row wants a chooser instead.

  Deliberately not Horizon's `quick-add`. That one draws a bubble that floats over
  the photograph and fades in on hover, which is not what the file draws, and its
  chooser fills a modal by fetching the product page and lifting
  `[data-product-grid-content]` out of it — an element that belongs to Horizon's
  `product-information` section and does not exist on this theme's product page.

  A seasonal product that is closed or not yet open (see [season-status]) gets
  no form at all: the square holds an inert pill carrying the season label,
  so there is nothing on the card that can post to the cart.

  Personalized products open their product page instead of adding from a card.
  The artwork condition matches [_ui-product-artwork]; the custom twelve-pack
  also requires a flavor selection even when artwork is explicitly switched off.

  @param {object} product - The product to add.
  @param {string} section_id - The id of the section drawing the card. Keeps one page's forms apart.
  @param {string} [class] - Additional CSS classes for the host element.

  @example
  {%- capture add_control -%}
    {% render 'ui-product-card-add', product: product, section_id: section.id %}
  {%- endcapture -%}
  {% render 'ui-product-card', title: product.title, add_content: add_control %}
{%- enddoc -%}

{%- capture season -%}{% render 'season-status', product: product %}{%- endcapture -%}
{%- capture purchase_path -%}{% render 'product-purchase-path', product: product %}{%- endcapture -%}
{%- liquid
  assign purchase_path = purchase_path | strip
  assign season_parts = season | strip | split: '|'
  assign season_status = season_parts[0] | default: 'available'
  assign season_label = season_parts[1]

  assign variant = product.selected_or_first_available_variant
  assign card_price_available = false
  for priced_variant in product.variants
    if priced_variant.available and priced_variant.price == product.price
      assign variant = priced_variant
      assign card_price_available = true
      break
    endif
  endfor

  assign sold_out = true
  if variant.available or product.available
    assign sold_out = false
  endif

  assign add_label = 'actions.add_to_cart' | t
  if sold_out
    assign add_label = 'products.product.sold_out' | t
  endif

  assign host_classes = 'ui-product-card__add-host'
  if class != blank
    assign host_classes = host_classes | append: ' ' | append: class
  endif

  assign form_id = 'ui-card-form-' | append: section_id | append: '-' | append: product.id

  assign variant_media = variant.featured_media.preview_image | image_url: width: 100
  if variant.featured_media.preview_image == blank
    assign variant_media = product.featured_media.preview_image | image_url: width: 100
  endif
-%}

{%- if season_status != 'available' -%}
  {%- assign season_classes = host_classes | append: ' ui-product-card__season' -%}
  {% render 'ui-button',
    variant: 'secondary',
    tag: 'span',
    label: season_label,
    disabled: true,
    class: season_classes
  %}
{%- elsif sold_out -%}
  {% render 'ui-button',
    variant: 'basket',
    label: add_label,
    disabled: true,
    class: host_classes,
    attributes: 'aria-disabled="true"'
  %}
{%- elsif purchase_path == 'builder' -%}
  {% render 'ui-button',
    variant: 'basket',
    label: 'Build your box',
    link: '/pages/customize',
    class: host_classes
  %}
{%- elsif purchase_path == 'personalize' -%}
  {% render 'ui-button',
    variant: 'basket',
    label: 'Customize these treats',
    link: product.url,
    class: host_classes
  %}
{%- elsif card_price_available == false -%}
  {% render 'ui-button',
    variant: 'basket',
    label: 'Choose options',
    link: product.url,
    class: host_classes
  %}
{%- else -%}
  <product-form-component
    class="{{ host_classes }}"
    data-section-id="{{ section_id }}"
    data-product-id="{{ product.id }}"
    data-product-url="{{ product.url }}"
    on:submit="/handleSubmit"
  >
    <div
      class="visually-hidden"
      aria-live="assertive"
      role="status"
      aria-atomic="true"
      ref="liveRegion"
    ></div>

    {%- form 'product', product, id: form_id, novalidate: 'novalidate', data-type: 'add-to-cart-form' -%}
      <input type="hidden" name="id" ref="variantId" value="{{ variant.id }}">
      <input type="hidden" name="quantity" value="{{ variant.quantity_rule.min | default: 1 }}">

      <add-to-cart-component
        ref="addToCartButtonContainer"
        data-product-variant-media="{{ variant_media }}"
        data-add-to-cart-animation="{{ settings.add_to_cart_animation }}"
      >
        {% render 'ui-button',
          variant: 'basket',
          label: add_label,
          type: 'submit',
          attributes: 'name="add" ref="addToCartButton" on:click="/handleClick"'
        %}
      </add-to-cart-component>
    {%- endform -%}
  </product-form-component>
{%- endif -%}
