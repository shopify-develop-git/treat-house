{%- doc -%}
  The Holidays landing page lists the merchant's seasonal collections in their
  chosen order, instead of exposing the legacy mixed-channel Holidays products.
  @param {object} collections - Ordered collection selection from theme settings.
{%- enddoc -%}
<div class="section section--page-width spacing-style" style="--padding-block-start:32px;--padding-block-end:64px;">
  <div class="ui-seasonal-hub">
    <h2>Shop seasonal treats</h2>
    <ul class="ui-seasonal-hub__grid" role="list">
      {%- for seasonal_collection in collections -%}
        {%- comment %}<locksmith:a8b3>{% endcomment -%}
          {%- capture var %}{% render 'locksmith-variables', scope: 'subject', subject: seasonal_collection, variable: 'transparent' %}{% endcapture %}{% if var == "true" %}{% else %}{% continue %}{% endif -%}
        {%- comment %}</locksmith:a8b3>{% endcomment -%}
        {%- capture seasonal_asset -%}{% render 'collection-thumbnail-asset', collection: seasonal_collection %}{%- endcapture -%}
        {%- assign seasonal_asset = seasonal_asset | strip -%}
        {%- assign seasonal_image = seasonal_collection.metafields.custom.card_image.value | default: seasonal_collection.featured_image -%}
        {%- assign seasonal_description = '' -%}
        {%- for upcoming_collection in settings.season_upcoming_collections -%}
          {%- if upcoming_collection.handle == seasonal_collection.handle -%}
            {%- assign seasonal_description = 'products.product.coming_soon' | t -%}
            {%- break -%}
          {%- endif -%}
        {%- endfor -%}
        <li>
          {% render 'ui-collection-card', title: seasonal_collection.title, description: seasonal_description, image: seasonal_image, image_asset: seasonal_asset, link: seasonal_collection.url %}
        </li>
      {%- endfor -%}
    </ul>
  </div>
</div>
{% stylesheet %}
  .ui-seasonal-hub { display: grid; gap: 24px; }
  .ui-seasonal-hub h2 { margin: 0; color: var(--ui-color-primary); }
  .ui-seasonal-hub__grid { list-style: none; margin: 0; padding: 0; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 16px; }
  @media (min-width: 750px) { .ui-seasonal-hub__grid { grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; } }
  @media (min-width: 1200px) { .ui-seasonal-hub__grid { gap: 32px; } }
{% endstylesheet %}
