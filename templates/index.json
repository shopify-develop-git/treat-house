    "our_story_Vt6Rw1": {
      "type": "our-story",
      "blocks": {
        "heading": {
          "type": "_ui-heading",
          "settings": {
            "source": "custom",
            "heading": "<h2>Our <em>story</em></h2>",
            "heading_tag": "h1",
            "heading_size": 48,
