    "partner_story_preview": {
      "type": "partner-story",
      "blocks": {
        "heading": {
          "type": "_ui-heading",
          "settings": {
            "source": "custom",
            "heading": "<h2>Proud partners of the Andrew McDonough B+ Foundation</h2>",
            "heading_tag": "h1",
            "heading_size": 48,
            "heading_size_mobile": 32,
            "max_width": 0,
            "color": "",
            "accent_color": "",
            "padding_block_start": 0,
            "padding_block_end": 0
          },
          "blocks": {}
        },
        "body": {
          "type": "_ui-text",
          "settings": {
            "source": "custom",
            "text": "<p>The Andrew McDonough B+ Foundation honors the life of Andrew McDonough. Andrew battled leukemia, septic shock, and complications of childhood cancer for 167 days before passing away on July 14, 2007, at the age of 14.</p><p>Andrew's B+ blood type became his family's and friends' motto throughout his fight against childhood cancer — to “Be Positive”. The B+ Foundation is the largest provider of financial assistance to families of kids with cancer nationwide.</p><p>Additionally, The B+ Foundation funds cutting-edge childhood cancer research and advocates on behalf of kids with cancer.</p>",
            "text_size": 16,
            "text_size_mobile": 16,
            "max_width": 0,
            "color": "",
            "padding_block_start": 0,
            "padding_block_end": 0
          },
          "blocks": {}
        }
      },
      "block_order": [
        "heading",
        "body"
      ],
